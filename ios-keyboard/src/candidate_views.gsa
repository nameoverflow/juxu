data IOSClipboardPillControl {
    cpcView: Ptr,
    cpcIconView: Ptr,
    cpcSubtitleLabel: Ptr,
    cpcValueLabel: Ptr,
    cpcIsDarkTheme: Cell Bool,
    cpcIsCompactLandscape: Cell Bool,
    cpcIntrinsicWidth: Cell Float,
}

def pillAssocKey(): Ptr = objcSel("__juxuClipPillAssocKey")

def pillUpdateSurface(pill: IOSClipboardPillControl): Void =
    if (!ptrIsNull(pill.cpcView)) {
        let highlighted = msgSendI64_0(pill.cpcView, objcSel("isHighlighted")) != intToI64(0);
        let dark = cellGet(pill.cpcIsDarkTheme);
        let col =
            if (highlighted) {
                if (dark) uiColorWhite(1.0, 0.22) else uiColorWhite(0.0, 0.11)
            } else {
                if (dark) uiColorWhite(1.0, 0.11) else uiColorWhite(0.0, 0.048)
            };
        setViewBgColor(pill.cpcView, col)
    } else ()

def cpcSetHighlighted(self: Ptr, cmd: Ptr, highlighted: Bool): Void = {
    objcSendSuperVoid1Bool(self, "UIControl", cmd, highlighted);
    let h = objcGetAssocHandle(self, pillAssocKey());
    if (h != intToI64(0)) {
        let pill: IOSClipboardPillControl = gcHandleGet(h);
        pillUpdateSurface(pill)
    } else ()
}

def cpcLayoutSubviews(self: Ptr, cmd: Ptr): Void = {
    objcSendSuperVoid0(self, "UIControl", cmd);
    let h = objcGetAssocHandle(self, pillAssocKey());
    if (h != intToI64(0)) {
        let pill: IOSClipboardPillControl = gcHandleGet(h);
        let b = viewBounds(self);
        let w = b.size.width;
        let bh = b.size.height;
        let padX = 12.0;

        if (cellGet(pill.cpcIsCompactLandscape)) {
            let iconSide = 14.0;
            let gap = 5.0;
            let maxTextW = maxFloat(20.0, w - padX * 2.0 - iconSide - gap);
            let fitSz = msgSendSize1Size(pill.cpcValueLabel, objcSel("sizeThatFits:"), cgSize(maxTextW, bh));
            let textW = minFloat(maxTextW, ceil(fitSz.width));
            let totalW = iconSide + gap + textW;
            let startX = floor((w - totalW) * 0.5);
            setViewFrame(pill.cpcIconView, cgRect(startX, floor((bh - iconSide) * 0.5), iconSide, iconSide));
            setViewFrame(pill.cpcValueLabel, cgRect(startX + iconSide + gap, 0.0, textW, bh))
        } else {
            let iconSide = 11.0;
            let gap = 3.5;
            let subFit = msgSendSize1Size(
                pill.cpcSubtitleLabel,
                objcSel("sizeThatFits:"),
                cgSize(maxFloat(20.0, w - padX * 2.0), 14.0)
            );
            let subW = minFloat(maxFloat(20.0, w - padX * 2.0 - iconSide - gap), ceil(subFit.width));
            let topTotalW = iconSide + gap + subW;
            let topStartX = floor((w - topTotalW) * 0.5);
            let topY = 3.5;
            setViewFrame(pill.cpcIconView, cgRect(topStartX, topY + 1.0, iconSide, iconSide));
            setViewFrame(pill.cpcSubtitleLabel, cgRect(topStartX + iconSide + gap, topY, subW, 13.0));

            let valY = 16.5;
            setViewFrame(
                pill.cpcValueLabel,
                cgRect(padX, valY, maxFloat(20.0, w - padX * 2.0), maxFloat(18.0, bh - valY - 2.5))
            )
        }
    } else ()
}

def clipboardPillNew(): IOSClipboardPillControl = {
    let z = cgRect(0.0, 0.0, 0.0, 0.0);
    let v = objcAllocInitFrame("JuxuIOSClipboardPillControl", z);
    let iconV = objcAllocInitFrame("UIImageView", z);
    let subLbl = objcAllocInitFrame("UILabel", z);
    let valLbl = objcAllocInitFrame("UILabel", z);
    if (!ptrIsNull(v)) {
        msgSendVoid1Bool(v, objcSel("setOpaque:"), false);
        setContinuousCorner(viewLayer(v), 11.0);
        msgSendVoid1Bool(v, objcSel("setIsAccessibilityElement:"), true);
        msgSendVoid1I64(v, objcSel("setAccessibilityTraits:"), uiAccessibilityTraitButton());
        setAccessibilityId(v, "JuxuClipboardPill");

        msgSendVoid1I64(iconV, objcSel("setContentMode:"), intToI64(1)); // .scaleAspectFit
        msgSendVoid1Bool(iconV, objcSel("setUserInteractionEnabled:"), false);

        msgSendVoid1I64(subLbl, objcSel("setNumberOfLines:"), intToI64(1));
        setLabelAlignment(subLbl, 0); // .left
        msgSendVoid1I64(subLbl, objcSel("setLineBreakMode:"), intToI64(2)); // .byClipping
        msgSendVoid1Bool(subLbl, objcSel("setUserInteractionEnabled:"), false);

        msgSendVoid1I64(valLbl, objcSel("setNumberOfLines:"), intToI64(1));
        setLabelAlignment(valLbl, 1); // .center
        msgSendVoid1I64(valLbl, objcSel("setLineBreakMode:"), intToI64(4)); // .byTruncatingTail
        msgSendVoid1Bool(valLbl, objcSel("setUserInteractionEnabled:"), false);

        msgSendVoid1Ptr(v, objcSel("addSubview:"), iconV);
        msgSendVoid1Ptr(v, objcSel("addSubview:"), subLbl);
        msgSendVoid1Ptr(v, objcSel("addSubview:"), valLbl);
        msgSendVoid0(iconV, objcSel("release"));
        msgSendVoid0(subLbl, objcSel("release"));
        msgSendVoid0(valLbl, objcSel("release"))
    } else ();

    let pill = IOSClipboardPillControl {
        cpcView: v,
        cpcIconView: iconV,
        cpcSubtitleLabel: subLbl,
        cpcValueLabel: valLbl,
        cpcIsDarkTheme: cellNew(false),
        cpcIsCompactLandscape: cellNew(false),
        cpcIntrinsicWidth: cellNew(140.0),
    };
    if (!ptrIsNull(v)) {
        objcSetAssocHandle(v, pillAssocKey(), gcHandleNew(pill))
    } else ();
    pill
}

def clipboardPillConfigure(
    pill: IOSClipboardPillControl,
    suggestion: IOSClipboardSuggestion,
    dark: Bool,
    compactLandscape: Bool
): Void =
    if (!ptrIsNull(pill.cpcView)) {
        cellSet(pill.cpcIsDarkTheme, dark);
        cellSet(pill.cpcIsCompactLandscape, compactLandscape);

        let textCol = if (dark) uiColorPureWhite() else uiColorBlack();
        let subtleCol = if (dark) uiColorWhite(0.70, 1.0) else uiColorWhite(0.42, 1.0);
        let otpTint = if (dark) uiColorRgba(0.40, 0.70, 1.0, 1.0) else uiColorSystemBlue(1.0);

        let symbolName = if (suggestion.csIsOTP) "key.fill" else "doc.on.clipboard";
        let symSize = if (compactLandscape) 12.0 else 9.5;
        let symImg = uiSymbolImage(symbolName, symSize, 1, true);
        msgSendVoid1Ptr(pill.cpcIconView, objcSel("setImage:"), symImg);
        msgSendVoid1Ptr(pill.cpcIconView, objcSel("setTintColor:"), if (suggestion.csIsOTP) otpTint else subtleCol);

        setViewHidden(pill.cpcSubtitleLabel, compactLandscape);
        let subFont = uiSystemFont(10.5, 0);
        setLabelFont(pill.cpcSubtitleLabel, subFont);
        setLabelTextColor(pill.cpcSubtitleLabel, subtleCol);
        setLabelText(pill.cpcSubtitleLabel, suggestion.csSubtitle);

        let valFont =
            if (suggestion.csIsOTP) {
                uiMonospacedDigitFont(if (compactLandscape) 15.5 else 16.5, 2)
            } else {
                uiSystemFont(if (compactLandscape) 14.5 else 15.0, 1)
            };
        setLabelFont(pill.cpcValueLabel, valFont);
        setLabelTextColor(pill.cpcValueLabel, textCol);
        setLabelText(pill.cpcValueLabel, suggestion.csDisplayText);

        let iconW = if (compactLandscape) 14.0 else 11.5;
        let valueW = ceil(uiMeasureTextWidth(suggestion.csDisplayText, valFont));
        let intrW =
            if (compactLandscape) {
                iconW + 5.0 + valueW + 24.0
            } else {
                let subW = ceil(uiMeasureTextWidth(suggestion.csSubtitle, subFont));
                let topW = iconW + 3.5 + subW;
                maxFloat(topW, valueW) + 28.0
            };
        cellSet(pill.cpcIntrinsicWidth, intrW);

        setAccessibilityLabelStr(pill.cpcView, suggestion.csSubtitle + "：" + suggestion.csDisplayText);
        pillUpdateSurface(pill);
        msgSendVoid0(pill.cpcView, objcSel("setNeedsLayout"))
    } else ()

