data IOSRibbonChevronButton {
    rcbView: Ptr,
    rcbHighlightPill: Ptr,
    rcbIconView: Ptr,
    rcbBandTopInset: Cell Float,
    rcbBandBottomInset: Cell Float,
}

def chevronAssocKey(): Ptr = objcSel("__juxuRibbonChevronAssocKey")

def rcbSetHighlighted(self: Ptr, cmd: Ptr, highlighted: Bool): Void = {
    objcSendSuperVoid1Bool(self, "UIControl", cmd, highlighted);
    let h = objcGetAssocHandle(self, chevronAssocKey());
    if (h != intToI64(0)) {
        let btn: IOSRibbonChevronButton = gcHandleGet(h);
        setViewBgColor(
            btn.rcbHighlightPill,
            if (highlighted) uiColorLabelAlpha(0.10) else uiColorClear()
        )
    } else ()
}

def rcbTintColorDidChange(self: Ptr, cmd: Ptr): Void = {
    objcSendSuperVoid0(self, "UIControl", cmd);
    let h = objcGetAssocHandle(self, chevronAssocKey());
    if (h != intToI64(0)) {
        let btn: IOSRibbonChevronButton = gcHandleGet(h);
        let tc = msgSend0(self, objcSel("tintColor"));
        if (!ptrIsNull(tc)) {
            msgSendVoid1Ptr(btn.rcbIconView, objcSel("setTintColor:"), tc)
        } else ()
    } else ()
}

def rcbLayoutSubviews(self: Ptr, cmd: Ptr): Void = {
    objcSendSuperVoid0(self, "UIControl", cmd);
    let h = objcGetAssocHandle(self, chevronAssocKey());
    if (h != intToI64(0)) {
        let btn: IOSRibbonChevronButton = gcHandleGet(h);
        let b = viewBounds(self);
        let topIns = cellGet(btn.rcbBandTopInset);
        let botIns = cellGet(btn.rcbBandBottomInset);
        let bandH = maxFloat(20.0, b.size.height - topIns - botIns);
        let centerY = topIns + bandH * 0.5;
        let centerX = b.size.width * 0.5;
        let iconSide = 18.0;
        setViewFrame(
            btn.rcbIconView,
            cgRect(
                roundHalf(centerX - iconSide * 0.5),
                roundHalf(centerY - iconSide * 0.5),
                iconSide,
                iconSide
            )
        );
        let pillW = minFloat(36.0, b.size.width - 8.0);
        let pillH = minFloat(34.0, bandH - 4.0);
        setViewFrame(
            btn.rcbHighlightPill,
            cgRect(
                roundHalf(centerX - pillW * 0.5),
                roundHalf(centerY - pillH * 0.5),
                pillW,
                pillH
            )
        )
    } else ()
}

def rcbPointInside(self: Ptr, _cmd: Ptr, pt: CGPoint, _ev: Ptr): Bool = {
    let b = viewBounds(self);
    // UIEdgeInsets(top: -4, left: -12, bottom: -6, right: -4)
    let expanded = cgRect(b.origin.x - 12.0, b.origin.y - 4.0, b.size.width + 16.0, b.size.height + 10.0);
    rectContainsPoint(expanded, pt)
}

def ribbonChevronNew(): IOSRibbonChevronButton = {
    let z = cgRect(0.0, 0.0, 0.0, 0.0);
    let v = objcAllocInitFrame("JuxuIOSRibbonChevronButton", z);
    let pill = objcAllocInitFrame("UIView", z);
    let iconV = objcAllocInitFrame("UIImageView", z);
    if (!ptrIsNull(v)) {
        msgSendVoid1Bool(v, objcSel("setOpaque:"), false);
        setViewBgColor(v, uiColorWhite(0.5, 0.01));
        msgSendVoid1Bool(v, objcSel("setIsAccessibilityElement:"), true);
        msgSendVoid1I64(v, objcSel("setAccessibilityTraits:"), uiAccessibilityTraitButton());

        msgSendVoid1Bool(pill, objcSel("setUserInteractionEnabled:"), false);
        setViewBgColor(pill, uiColorClear());
        setContinuousCorner(viewLayer(pill), 9.0);
        msgSendVoid1Ptr(v, objcSel("addSubview:"), pill);
        msgSendVoid0(pill, objcSel("release"));

        msgSendVoid1I64(iconV, objcSel("setContentMode:"), intToI64(4)); // .center
        msgSendVoid1Bool(iconV, objcSel("setUserInteractionEnabled:"), false);
        msgSendVoid1Ptr(v, objcSel("addSubview:"), iconV);
        msgSendVoid0(iconV, objcSel("release"))
    } else ();

    let btn = IOSRibbonChevronButton {
        rcbView: v,
        rcbHighlightPill: pill,
        rcbIconView: iconV,
        rcbBandTopInset: cellNew(4.0),
        rcbBandBottomInset: cellNew(7.0),
    };
    if (!ptrIsNull(v)) {
        objcSetAssocHandle(v, chevronAssocKey(), gcHandleNew(btn))
    } else ();
    btn
}

def ribbonChevronSetImage(btn: IOSRibbonChevronButton, symbolName: String): Void =
    if (!ptrIsNull(btn.rcbIconView)) {
        let img = uiSymbolImage(symbolName, 15.0, 2, true);
        msgSendVoid1Ptr(btn.rcbIconView, objcSel("setImage:"), img)
    } else ()

