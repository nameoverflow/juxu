/// Complete 1:1 port of `iOS/KeyboardExtension/IOSCandidateViews.swift` (1,287 lines):
/// - `cleanIOSCandidateAnnotation` & `expandedCandidateDisplayHint`
/// - `IOSRibbonSlotControl : UIControl` (zero `UIButton.Configuration`, `0.01` alpha cross-process hit backing,
///   `9.0pt` continuous squircle highlight, `#1` medium + monospaced `11.0pt` secondary annotation)
/// - `IOSClipboardPillControl : UIControl` (`JuxuClipboardPill`, OTP `key.fill` vs `doc.on.clipboard`,
///   2-line portrait & single-line compact landscape layout)
/// - `IOSRibbonChevronButton : UIControl` (`JuxuCandidateToggle`, `chevron.down`/`chevron.up` `15.0pt semibold`)
/// - `IOSCandidateRibbonView : UIView <UIGestureRecognizerDelegate>` (`JuxuRibbon`, ZERO `UIScrollView`,
///   horizontal `UIPanGestureRecognizer` with `0.25` rubberband & `0.24s` deceleration, conditional `CAGradientLayer`
///   edge fade mask, bottom `8pt` Row-0 pass-through, inter-slot gap snapping, `JuxuClipboardDismiss`)
/// - `IOSExpandedScrollView : UIScrollView` (`JuxuExpandedCandidates`, zero touch delay, `touchesShouldCancelInContentView:`)
/// - `IOSExpandedCellButton : UIButton` (`JuxuExpandedCandidate0..N`, char-wrapping full-width sentence cells + 4-col compact grid)
/// - `IOSExpandedCandidateView : UIView` (pooled cells + right-hand rail `chevron.up`, `delete.backward`, `重输`, `gearshape` `JuxuOpenSettings`).

use std.option.{Option, Some, None}
use std.vec.{Vec, vecNew, vecWithCap, vecLen, vecPush, vecGet, vecGetOr, vecClear}
use std.buf.{bufNew, bufPushStr, bufToString}
use std.str.{intToStr, strContains, strTrim}
use std.math.{abs, floor, ceil}
use std.generic
use objc.{
    Id, NSObject, idAdoptOpt,
    objcClass, objcSel, objcAllocateClass, objcAddMethod, objcAddProtocol, objcRegisterClass,
    objcSetAssocHandle, objcGetAssocHandle,
    msgSend0, msgSend1I64, msgSendI64_0, msgSendFloat0,
    msgSendVoid0, msgSendVoid1Ptr, msgSendVoid1Bool, msgSendVoid1I64, msgSendVoid1Float,
}
use juxu_core.{
    Candidate, candidateBadge,
    Shortcode, TypoCorrected, Wildcard, PinyinLookup,
}
use juxu_shared.{
    CGPoint, CGRect,
    cgPoint, cgSize, cgRect,
    rectContainsPoint, rectInset, rectMaxX,
    ptrToI64, msgSend2Ptr, msgSendPoint1Ptr, msgSendSize1Size,
    msgSendVoid1Size, msgSendVoid1Ptr1I64, msgSendVoid1Ptr1Sel1U64,
    objcSendSuperVoid0, objcSendSuperVoid1Bool,
    nsStr, objcAllocInitFrame,
    JuxuActionState,
}
use layout_engine.{keyCornerRadius, optBoolEq}
use clipboard_suggestion.{IOSClipboardSuggestion, optClipSuggestionEq}
use ios_ui_kit.{
    setContinuousCorner, initEdgeFadeLayer, applyEdgeFadeMask,
    uiColorRgba, uiColorWhite, uiColorSystemBlue, uiColorSystemBgAlpha, uiColorLabelAlpha,
    uiColorPureWhite, uiColorBlack, uiColorClear,
    uiSystemFont, uiMonospacedFont, uiMonospacedDigitFont, uiSymbolImage,
    uiMeasureTextWidth, uiSetDualAttributedLabel,
    uiPerformWithoutAnimation, uiAnimate,
    uiAnimOptCurveEaseOut, uiAnimOptAllowUserInteraction, uiAnimOptBeginFromCurrentState,
    uiAccessibilityTraitButton, viewDisplayScale,
    suppressIOS26ScrollEdgeEffects, objcSendSuperHitTest,
    viewLayer, setLayerShadowOpacity,
    setViewHidden, isViewHidden, viewBounds, viewFrame, setViewFrame,
    viewAlpha, setViewBgColor, setAccessibilityId, setAccessibilityLabelStr,
    pinAnchorConst, pinDimensionConst, convertPointToView,
    setLabelText, setLabelTextColor, setLabelFont, setLabelAlignment,
    setScrollContentOffsetZero, removeAllLayerAnimations,
}

def minInt(a: Int, b: Int): Int = if (a < b) a else b
def maxInt(a: Int, b: Int): Int = if (a > b) a else b
def minFloat(a: Float, b: Float): Float = if (a < b) a else b
def maxFloat(a: Float, b: Float): Float = if (a > b) a else b
def roundHalf(x: Float): Float = floor(x + 0.5)

// ============================================================================
// Candidate Annotation Cleaning (`IOSCandidateViews.swift` lines 5–21 & 1263–1271)
// ============================================================================

def firstWordBeforeSpace(s: String): String = {
    let n = strLen(s);
    let i = cellNew(0);
    while (cellGet(i) < n && strByteAt(s, cellGet(i)) != 32) {
        cellSet(i, cellGet(i) + 1)
    };
    strSlice(s, 0, cellGet(i))
}

def stripSubstr(s: String, sub: String): String = {
    let sLen = strLen(s);
    let subLen = strLen(sub);
    if (subLen == 0 || sLen < subLen) s
    else {
        let out = bufNew();
        let i = cellNew(0);
        while (cellGet(i) < sLen) {
            let idx = cellGet(i);
            if (idx + subLen <= sLen && strSlice(s, idx, idx + subLen) == sub) {
                cellSet(i, idx + subLen)
            } else {
                bufPushStr(out, strSlice(s, idx, idx + 1));
                cellSet(i, idx + 1)
            }
        };
        bufToString(out)
    }
}

pub def cleanIOSCandidateAnnotation(item: Candidate): String =
    if (strLen(item.comment) == 0) ""
    else {
        let raw = match candidateBadge(item) {
            TypoCorrected -> firstWordBeforeSpace(item.comment),
            PinyinLookup -> item.comment,
            Shortcode -> item.comment,
            Wildcard -> item.comment,
            _ -> "",
        };
        if (strLen(raw) == 0) ""
        else {
            let c1 = stripSubstr(raw, "⌖");
            let c2 = stripSubstr(c1, "⟲");
            let c3 = stripSubstr(c2, "⇄");
            let c4 = stripSubstr(c3, "⎵");
            strTrim(c4)
        }
    }

pub def expandedCandidateDisplayHint(item: Candidate): Option String =
    match candidateBadge(item) {
        PinyinLookup -> {
            let cleaned = cleanIOSCandidateAnnotation(item);
            if (strLen(cleaned) == 0) None else Some(cleaned)
        },
        Shortcode -> {
            let cleaned = cleanIOSCandidateAnnotation(item);
            if (strLen(cleaned) == 0) None else Some(cleaned)
        },
        TypoCorrected -> {
            let cleaned = cleanIOSCandidateAnnotation(item);
            if (strLen(cleaned) == 0) None else Some(cleaned)
        },
        _ -> None,
    }

// ============================================================================
// IOSRibbonSlotControl (`IOSCandidateViews.swift` lines 25–117)
// ============================================================================

def slotHorizontalPadding(): Float = 12.0

data SlotTitleCacheKey : Eq {
    sckPrimary: String,
    sckSecondary: String,
    sckFontSize: Float,
    sckIsEmphasized: Bool,
    sckDark: Bool,
}

data IOSRibbonSlotControl {
    rscView: Ptr,
    rscLabel: Ptr,
    rscSlotIndex: Cell Int,
    rscStarterWord: Cell (Option String),
    rscSlotWidth: Cell Float,
    rscCachedKey: Cell (Option SlotTitleCacheKey),
}

def slotAssocKey(): Ptr = objcSel("__juxuRibbonSlotAssocKey")

def rscSetHighlighted(self: Ptr, cmd: Ptr, highlighted: Bool): Void = {
    objcSendSuperVoid1Bool(self, "UIControl", cmd, highlighted);
    setViewBgColor(
        self,
        if (highlighted) uiColorLabelAlpha(0.10) else uiColorWhite(0.5, 0.01)
    )
}

def rscLayoutSubviews(self: Ptr, cmd: Ptr): Void = {
    objcSendSuperVoid0(self, "UIControl", cmd);
    let h = objcGetAssocHandle(self, slotAssocKey());
    if (h != intToI64(0)) {
        let slot: IOSRibbonSlotControl = gcHandleGet(h);
        setViewFrame(slot.rscLabel, viewBounds(self))
    } else ()
}

def ribbonSlotNew(): IOSRibbonSlotControl = {
    let z = cgRect(0.0, 0.0, 0.0, 0.0);
    let v = objcAllocInitFrame("JuxuIOSRibbonSlotControl", z);
    let lbl = objcAllocInitFrame("UILabel", z);
    if (!ptrIsNull(v)) {
        msgSendVoid1Bool(v, objcSel("setOpaque:"), false);
        setViewBgColor(v, uiColorWhite(0.5, 0.01));
        setContinuousCorner(viewLayer(v), 9.0);
        if (!ptrIsNull(lbl)) {
            msgSendVoid1I64(lbl, objcSel("setNumberOfLines:"), intToI64(1));
            setLabelAlignment(lbl, 1); // .center
            msgSendVoid1I64(lbl, objcSel("setLineBreakMode:"), intToI64(2)); // .byClipping
            msgSendVoid1Bool(lbl, objcSel("setUserInteractionEnabled:"), false);
            msgSendVoid1Ptr(v, objcSel("addSubview:"), lbl);
            msgSendVoid0(lbl, objcSel("release"))
        } else ()
    } else ();
    let slot = IOSRibbonSlotControl {
        rscView: v,
        rscLabel: lbl,
        rscSlotIndex: cellNew(0),
        rscStarterWord: cellNew(None),
        rscSlotWidth: cellNew(0.0),
        rscCachedKey: cellNew(None),
    };
    if (!ptrIsNull(v)) {
        objcSetAssocHandle(v, slotAssocKey(), gcHandleNew(slot))
    } else ();
    slot
}

def ribbonSlotSetContent(
    slot: IOSRibbonSlotControl,
    primary: String,
    secondary: String,
    fontSize: Float,
    isEmphasized: Bool,
    primaryColor: Ptr,
    subtleColor: Ptr,
    dark: Bool
): Void = {
    let key = SlotTitleCacheKey {
        sckPrimary: primary,
        sckSecondary: secondary,
        sckFontSize: fontSize,
        sckIsEmphasized: isEmphasized,
        sckDark: dark,
    };
    let unchanged = match cellGet(slot.rscCachedKey) {
        Some(prev) -> prev == key,
        None -> false,
    };
    if (!unchanged) {
        cellSet(slot.rscCachedKey, Some(key));
        let pFont = uiSystemFont(fontSize, if (isEmphasized) 1 else 0);
        let secWithSpace = if (strLen(secondary) > 0) (" " + secondary) else "";
        let sFont = if (strLen(secondary) > 0) uiMonospacedFont(11.0, 0) else ptrNull();
        let w = uiSetDualAttributedLabel(
            slot.rscLabel,
            primary,
            pFont,
            primaryColor,
            secWithSpace,
            sFont,
            subtleColor
        );
        cellSet(slot.rscSlotWidth, w + slotHorizontalPadding() * 2.0)
    } else ()
}

