use std.vec.{Vec, vecNew, vecWithCap, vecLen, vecPush, vecGet, vecGetOr, vecSet, vecClear}
use std.map.{StrMap, strMapNew, strMapGet, strMapInsert}
use std.math.{abs, floor, sqrt}
use objc.{
    Id, NSObject, idAdoptOpt, idRetain,
    objcClass, objcSel, objcAllocateClass, objcAddMethod, objcAddProtocol, objcRegisterClass,
    objcSetAssocHandle, objcGetAssocHandle,
    msgSend0, msgSend1I64, msgSendI64_0, msgSendFloat0,
    msgSendVoid0, msgSendVoid1Ptr, msgSendVoid1Bool, msgSendVoid1I64, msgSendVoid1Float,
}
use juxu_shared.{
    CGPoint, CGSize, CGRect, cgPoint, cgSize, cgRect,
    cgAffineIdentity, cgAffineTranslate,
    rectContainsPoint, rectInset,
    ptrToI64, msgSend1I64_1Ptr, msgSendVoid1Size, msgSendVoid1Ptr1I64,
    msgSendVoid1Ptr1Sel1U64,
    objcSendSuperVoid0, objcSendSuperVoid1Ptr, objcSendSuperVoid1Bool,
    nsStr, objcAllocInitFrame, systemUptimeSeconds, dispatchMainAfterMs,
    utf8FirstScalar, utf8ScalarCount,
}
use layout_engine.{
    IOSKeyPlane, PlaneNumbers, PlaneSymbols,
    IOSKeyKind, KeyLetter, KeyT9, KeyT9Clear, KeySymbol, KeyShift, KeyBackspace,
    KeyPlaneSwitch, KeyGlobe, KeyModeToggle, KeySpace, KeyReturn,
    IOSKeySpec, keySpecSimple, keySpecEq, rectEq, rectOffset, optStrEq,
    LayoutSnapshot, keyCornerRadius, shouldReturnToLettersAfterSymbol,
    hitTest, hitTestFull,
}
use gestures_editing.{
    swipeUpIsActive,
    keyAlternatesSymbolOptions,
    trackpadMoveCancelDistance, supportsTrackpadHold, trackpadHoldDelay, alternatesDelay,
    shouldCancelAlternatesInTrackpad,
    SpaceTrackpadAccumulator, trackpadNew, trackpadIsActive, trackpadBegin, trackpadUpdate, trackpadEnd,
}
use ios_ui_kit.{
    setContinuousCorner,
    uiColorRgba, uiColorWhite, uiColorSystemBlue, uiColorSystemBgAlpha,
    uiColorPureWhite, uiColorBlack,
    uiSystemFont, uiSymbolImage,
    uiSetDualAttributedLabel, uiSetRadicalAttributedLabel,
    uiPerformWithoutAnimation, uiAnimate,
    uiAnimOptCurveEaseOut, uiAnimOptAllowUserInteraction, uiAnimOptBeginFromCurrentState,
    extractSortedTouches, touchLocationInView, msgSendInitStyle,
    viewLayer, setViewHidden, isViewHidden, viewBounds, viewFrame, setViewFrame,
    setViewAlpha, setViewTransform, setViewBgColor, setAccessibilityId,
    setLabelText, setLabelTextColor, setLabelFont, setLabelAlignment,
    setScrollContentOffsetZero,
}

def maxFloat(a: Float, b: Float): Float = if (a > b) a else b
def hypot2(dx: Float, dy: Float): Float = sqrt(dx * dx + dy * dy)

def asciiUpperStr(s: String): String = {
    let letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    let n = strLen(s);
    if (n == 1) {
        let b = strByteAt(s, 0);
        if (b >= 97 && b <= 122) strSlice(letters, b - 97, b - 96)
        else s
    } else s
}

// ============================================================================
// Symbol Cache & IOSKeycapNodeView (`IOSKeyCanvasView.swift` lines 7–323)
// ============================================================================

def gKeycapSymbolCache: Cell (StrMap (Ptr, Id NSObject)) = cellNew(strMapNew())

def clearKeycapSymbolCache(): Void =
    cellSet(gKeycapSymbolCache, strMapNew())

def cachedKeycapSymbolImage(symName: String): Ptr = {
    let cache = cellGet(gKeycapSymbolCache);
    match strMapGet(cache, symName) {
        Some((rawPtr, _)) -> rawPtr,
        None -> {
            let img = uiSymbolImage(symName, 19.5, 0, true);
            if (!ptrIsNull(img)) {
                let _ = strMapInsert(cache, symName, (img, idRetain(img)));
                ()
            } else ();
            img
        },
    }
}

data IOSKeycapNode {
    knView: Ptr,
    knPrimaryLabel: Ptr,
    knRadicalLabel: Ptr,
    knSymbolView: Ptr,
    knSubscriptLabel: Ptr,
    knSwipeHintLabel: Ptr,
    knCurrentSpec: Cell (Option IOSKeySpec),
    knIsDarkTheme: Cell Bool,
    knIsPressedState: Cell Bool,
    knIsGlyphCovered: Cell Bool,
    knHasAppliedPressVisuals: Cell Bool,
}

def keycapNodeNew(): IOSKeycapNode = {
    let z = cgRect(0.0, 0.0, 0.0, 0.0);
    let v = objcAllocInitFrame("UIView", z);
    let primaryLbl = objcAllocInitFrame("UILabel", z);
    let radicalLbl = objcAllocInitFrame("UILabel", z);
    let symView = objcAllocInitFrame("UIImageView", z);
    let subLbl = objcAllocInitFrame("UILabel", z);
    let swipeLbl = objcAllocInitFrame("UILabel", z);

    if (!ptrIsNull(v)) {
        msgSendVoid1Bool(v, objcSel("setUserInteractionEnabled:"), false);
        setContinuousCorner(viewLayer(v), keyCornerRadius());

        setLabelAlignment(primaryLbl, 1); // .center
        msgSendVoid1Bool(primaryLbl, objcSel("setUserInteractionEnabled:"), false);

        setLabelAlignment(radicalLbl, 1); // .center
        msgSendVoid1I64(radicalLbl, objcSel("setNumberOfLines:"), intToI64(2));
        msgSendVoid1I64(radicalLbl, objcSel("setLineBreakMode:"), intToI64(2)); // .byClipping
        msgSendVoid1Bool(radicalLbl, objcSel("setUserInteractionEnabled:"), false);
        setViewHidden(radicalLbl, true);

        msgSendVoid1I64(symView, objcSel("setContentMode:"), intToI64(4)); // .center
        msgSendVoid1Bool(symView, objcSel("setUserInteractionEnabled:"), false);

        setLabelFont(subLbl, uiSystemFont(12.5, 0));
        setLabelAlignment(subLbl, 2); // .right
        msgSendVoid1Bool(subLbl, objcSel("setUserInteractionEnabled:"), false);

        setLabelFont(swipeLbl, uiSystemFont(9.5, 0));
        setLabelAlignment(swipeLbl, 1); // .center
        msgSendVoid1Bool(swipeLbl, objcSel("setUserInteractionEnabled:"), false);
        setViewHidden(swipeLbl, true);

        msgSendVoid1Ptr(v, objcSel("addSubview:"), primaryLbl);
        msgSendVoid1Ptr(v, objcSel("addSubview:"), radicalLbl);
        msgSendVoid1Ptr(v, objcSel("addSubview:"), symView);
        msgSendVoid1Ptr(v, objcSel("addSubview:"), subLbl);
        msgSendVoid1Ptr(v, objcSel("addSubview:"), swipeLbl);

        msgSendVoid0(primaryLbl, objcSel("release"));
        msgSendVoid0(radicalLbl, objcSel("release"));
        msgSendVoid0(symView, objcSel("release"));
        msgSendVoid0(subLbl, objcSel("release"));
        msgSendVoid0(swipeLbl, objcSel("release"))
    } else ();

    IOSKeycapNode {
        knView: v,
        knPrimaryLabel: primaryLbl,
        knRadicalLabel: radicalLbl,
        knSymbolView: symView,
        knSubscriptLabel: subLbl,
        knSwipeHintLabel: swipeLbl,
        knCurrentSpec: cellNew(None),
        knIsDarkTheme: cellNew(false),
        knIsPressedState: cellNew(false),
        knIsGlyphCovered: cellNew(false),
        knHasAppliedPressVisuals: cellNew(false),
    }
}

def keycapLayoutSublayers(node: IOSKeycapNode, spec: IOSKeySpec): Void =
    if (!ptrIsNull(node.knView)) {
        let b = viewBounds(node.knView);
        setViewFrame(node.knSwipeHintLabel, cgRect(0.0, 1.5, b.size.width, 11.0));
        let hasRadicals = match spec.ksKeycapRadicals {
            Some(rad) -> strLen(rad) > 0,
            None -> false,
        };
        if (hasRadicals) {
            let letterH = maxFloat(13.0, floor(b.size.height * 0.34 + 0.5));
            setViewFrame(node.knPrimaryLabel, cgRect(0.0, 2.0, b.size.width, letterH));
            setViewFrame(
                node.knRadicalLabel,
                cgRect(
                    1.0,
                    2.0 + letterH - 0.5,
                    maxFloat(0.0, b.size.width - 2.0),
                    maxFloat(0.0, b.size.height - letterH - 3.5)
                )
            );
            setViewFrame(node.knSymbolView, b);
            setViewFrame(node.knSubscriptLabel, cgRect(b.size.width - 30.0, b.size.height - 20.0, 24.0, 15.0))
        } else {
            let (xNudge, yNudge) = match spec.ksKind {
                KeyLetter(_) -> {
                    let (cp, len) = utf8FirstScalar(spec.ksPrimaryLabel);
                    let isNonASCII = len > 0 && cp >= 128;
                    let isUpper = len > 0 && cp >= 65 && cp <= 90;
                    let hintShift = match spec.ksSwipeUpSymbol {
                        Some(_) -> 2.0,
                        None -> 0.0,
                    };
                    let base = if (isNonASCII) -0.5 else if (isUpper) -0.3 else -2.2;
                    (0.0, base + hintShift)
                },
                KeySymbol(_) -> {
                    let yn = match spec.ksSwipeUpSymbol {
                        Some(_) -> 1.2,
                        None -> -0.8,
                    };
                    (0.0, yn)
                },
                KeyPlaneSwitch { targetPlane: _, switchLabel: _ } -> (0.0, -0.8),
                KeyModeToggle -> {
                    let hasCorner = match spec.ksCornerSubscript {
                        Some(_) -> true,
                        None -> false,
                    };
                    if (hasCorner) (-6.0, -3.0) else (0.0, -0.5)
                },
                _ -> (0.0, 0.0),
            };
            setViewFrame(node.knPrimaryLabel, rectOffset(b, xNudge, yNudge));
            setViewFrame(node.knRadicalLabel, cgRect(0.0, 0.0, 0.0, 0.0));
            setViewFrame(node.knSymbolView, b);
            setViewFrame(node.knSubscriptLabel, cgRect(b.size.width - 30.0, b.size.height - 20.0, 24.0, 15.0))
        }
    } else ()

def keycapUpdateContent(node: IOSKeycapNode, spec: IOSKeySpec, dark: Bool): Void =
    if (!ptrIsNull(node.knView)) {
        let fgColor =
            if (spec.ksIsBlueAccent) uiColorPureWhite()
            else if (dark) uiColorPureWhite()
            else uiColorBlack();
        let subColor = if (dark) uiColorWhite(1.0, 0.30) else uiColorWhite(0.0, 0.20);
        let modeSecondaryColor = if (dark) uiColorWhite(1.0, 0.45) else uiColorWhite(0.0, 0.38);

        match spec.ksSystemSymbol {
            Some(symName) -> {
                setViewHidden(node.knPrimaryLabel, true);
                setViewHidden(node.knRadicalLabel, true);
                setViewHidden(node.knSymbolView, false);
                let img = cachedKeycapSymbolImage(symName);
                msgSendVoid1Ptr(node.knSymbolView, objcSel("setImage:"), img);
                msgSendVoid1Ptr(node.knSymbolView, objcSel("setTintColor:"), fgColor)
            },
            None ->
                if (strLen(spec.ksPrimaryLabel) > 0) {
                    setViewHidden(node.knSymbolView, true);
                    setViewHidden(node.knPrimaryLabel, false);
                    let secInline = match spec.ksSecondaryInlineLabel {
                        Some(s) -> s,
                        None -> "",
                    };
                    let radTxt = match spec.ksKeycapRadicals {
                        Some(r) -> r,
                        None -> "",
                    };
                    if (strLen(secInline) > 0) {
                        setViewHidden(node.knRadicalLabel, true);
                        let _ = uiSetDualAttributedLabel(
                            node.knPrimaryLabel,
                            spec.ksPrimaryLabel,
                            uiSystemFont(16.5, 1), // medium
                            fgColor,
                            secInline,
                            uiSystemFont(12.0, 0), // regular
                            modeSecondaryColor
                        );
                        ()
                    } else if (strLen(radTxt) > 0) {
                        msgSendVoid1Ptr(node.knPrimaryLabel, objcSel("setAttributedText:"), ptrNull());
                        setLabelFont(node.knPrimaryLabel, uiSystemFont(12.5, 2)); // semibold
                        setLabelTextColor(node.knPrimaryLabel, fgColor);
                        setLabelText(node.knPrimaryLabel, asciiUpperStr(spec.ksPrimaryLabel));

                        let radColor = if (dark) uiColorWhite(1.0, 0.74) else uiColorWhite(0.0, 0.64);
                        uiSetRadicalAttributedLabel(node.knRadicalLabel, radTxt, 9.0, radColor, 1.02, 0.5);
                        setViewHidden(node.knRadicalLabel, false)
                    } else {
                        setViewHidden(node.knRadicalLabel, true);
                        msgSendVoid1Ptr(node.knPrimaryLabel, objcSel("setAttributedText:"), ptrNull());
                        let (fontSize, weightCode) = match spec.ksKind {
                            KeyLetter(_) -> {
                                let (cp, len) = utf8FirstScalar(spec.ksPrimaryLabel);
                                let isNonASCII = len > 0 && cp >= 128;
                                let isUpper = len > 0 && cp >= 65 && cp <= 90;
                                let sz = if (isNonASCII) 20.5 else if (isUpper) 22.5 else 24.5;
                                (sz, 0)
                            },
                            KeyT9(digit) ->
                                if (digit == 49) (14.5, 0) else (16.5, 1),
                            KeyT9Clear -> (15.0, 0),
                            KeySymbol(s) ->
                                (if (utf8ScalarCount(s) > 1) 16.5 else 21.5, 0),
                            KeyPlaneSwitch { targetPlane: _, switchLabel: _ } -> (18.0, 0),
                            KeyReturn ->
                                (16.0, if (spec.ksIsBlueAccent) 2 else 0),
                            _ -> (17.5, 0),
                        };
                        setLabelFont(node.knPrimaryLabel, uiSystemFont(fontSize, weightCode));
                        setLabelTextColor(node.knPrimaryLabel, fgColor);
                        setLabelText(node.knPrimaryLabel, spec.ksPrimaryLabel)
                    }
                } else {
                    setViewHidden(node.knPrimaryLabel, true);
                    setViewHidden(node.knRadicalLabel, true);
                    setViewHidden(node.knSymbolView, true)
                },
        };

        let radEmpty = match spec.ksKeycapRadicals {
            Some(r) -> strLen(r) == 0,
            None -> true,
        };
        match spec.ksSwipeUpSymbol {
            Some(hint) if (radEmpty) -> {
                setViewHidden(node.knSwipeHintLabel, false);
                setLabelText(node.knSwipeHintLabel, hint);
                setLabelTextColor(
                    node.knSwipeHintLabel,
                    if (dark) uiColorWhite(1.0, 0.48) else uiColorWhite(0.0, 0.42)
                )
            },
            _ -> setViewHidden(node.knSwipeHintLabel, true),
        };

        match spec.ksCornerSubscript {
            Some(sub) if (strLen(sub) > 0) -> {
                setViewHidden(node.knSubscriptLabel, false);
                setLabelText(node.knSubscriptLabel, sub);
                setLabelTextColor(
                    node.knSubscriptLabel,
                    if (spec.ksKind == KeyModeToggle) modeSecondaryColor else subColor
                )
            },
            _ -> setViewHidden(node.knSubscriptLabel, true),
        }
    } else ()

def keycapApplyPressVisuals(
    node: IOSKeycapNode,
    pressed: Bool,
    glyphCovered: Bool,
    spec: IOSKeySpec,
    dark: Bool,
    animatedRelease: Bool
): Void =
    if (!ptrIsNull(node.knView)) {
        let normalBg =
            if (spec.ksIsBlueAccent) uiColorSystemBlue(1.0)
            else if (spec.ksUsesFunctionFill) {
                if (dark) uiColorWhite(1.0, 0.09)
                else uiColorRgba(184.0 / 255.0, 188.0 / 255.0, 198.0 / 255.0, 1.0)
            } else {
                if (dark) uiColorWhite(1.0, 0.175)
                else uiColorPureWhite()
            };
        let pressedBg =
            if (spec.ksIsBlueAccent) uiColorSystemBlue(0.80)
            else if (dark) uiColorWhite(1.0, 0.30)
            else uiColorRgba(214.0 / 255.0, 216.0 / 255.0, 222.0 / 255.0, 1.0);

        let targetBg = if (pressed) pressedBg else normalBg;
        let targetTransform = if (pressed) cgAffineTranslate(0.0, 0.45) else cgAffineIdentity();
        let contentAlpha = if (glyphCovered) 0.0 else 1.0;

        let applyFn = () -> {
            setViewBgColor(node.knView, targetBg);
            setViewTransform(node.knView, targetTransform);
            setViewAlpha(node.knPrimaryLabel, contentAlpha);
            if (!isViewHidden(node.knRadicalLabel)) {
                setViewAlpha(node.knRadicalLabel, contentAlpha)
            } else ();
            if (!isViewHidden(node.knSwipeHintLabel)) {
                setViewAlpha(node.knSwipeHintLabel, contentAlpha)
            } else ()
        };

        if (animatedRelease) {
            let opts = uiAnimOptCurveEaseOut() | uiAnimOptAllowUserInteraction() | uiAnimOptBeginFromCurrentState();
            uiAnimate(0.065, opts, applyFn)
        } else {
            uiPerformWithoutAnimation(applyFn)
        }
    } else ()

def keycapConfigure(
    node: IOSKeycapNode,
    spec: IOSKeySpec,
    dark: Bool,
    pressed: Bool,
    glyphCovered: Bool
): Void =
    if (!ptrIsNull(node.knView)) {
        if (!rectEq(viewFrame(node.knView), spec.ksFrame)) {
            uiPerformWithoutAnimation(() -> {
                setViewFrame(node.knView, spec.ksFrame);
                keycapLayoutSublayers(node, spec)
            })
        } else ();

        let sameSpec = match cellGet(node.knCurrentSpec) {
            Some(prev) -> keySpecEq(prev, spec),
            None -> false,
        };
        let specOrThemeChanged = !sameSpec || (cellGet(node.knIsDarkTheme) != dark);
        cellSet(node.knCurrentSpec, Some(spec));
        cellSet(node.knIsDarkTheme, dark);

        if (specOrThemeChanged) {
            uiPerformWithoutAnimation(() -> {
                keycapUpdateContent(node, spec, dark);
                keycapLayoutSublayers(node, spec)
            })
        } else ();

        let wasPressed = cellGet(node.knIsPressedState);
        let wasCovered = cellGet(node.knIsGlyphCovered);
        if (specOrThemeChanged || !cellGet(node.knHasAppliedPressVisuals) || pressed != wasPressed || glyphCovered != wasCovered) {
            keycapApplyPressVisuals(node, pressed, glyphCovered, spec, dark, !pressed && wasPressed);
            cellSet(node.knHasAppliedPressVisuals, true);
            cellSet(node.knIsPressedState, pressed);
            cellSet(node.knIsGlyphCovered, glyphCovered)
        } else ()
    } else ()

def keycapUpdatePressState(node: IOSKeycapNode, pressed: Bool, glyphCovered: Bool, dark: Bool): Void =
    if (cellGet(node.knHasAppliedPressVisuals)) {
        match cellGet(node.knCurrentSpec) {
            Some(spec) -> {
                let wasPressed = cellGet(node.knIsPressedState);
                let wasCovered = cellGet(node.knIsGlyphCovered);
                if (pressed != wasPressed || glyphCovered != wasCovered || dark != cellGet(node.knIsDarkTheme)) {
                    cellSet(node.knIsDarkTheme, dark);
                    keycapApplyPressVisuals(node, pressed, glyphCovered, spec, dark, !pressed && wasPressed);
                    cellSet(node.knIsPressedState, pressed);
                    cellSet(node.knIsGlyphCovered, glyphCovered)
                } else ()
            },
            None -> (),
        }
    } else ()

