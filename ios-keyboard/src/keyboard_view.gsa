/// Pixel-accurate iOS 26/27 keyboard canvas & candidate ribbon (`JuxuIOSKeyboardView`).
/// Matches `main`'s exact visual specification:
/// - Transparent system glass backdrop (`isOpaque = false`, `backgroundColor = .clear`)
/// - Light/Dark adaptive palette (`traitCollection.userInterfaceStyle`)
/// - Flat shadowless keycaps (`cornerRadius = 7.8pt`), `UIColor.systemBlue` Return key
/// - Crisp vector SF Symbols (`UIImage.systemImageNamed:withConfiguration:`) — zero Unicode/emoji icons
/// - Exact font sizes (`24.5pt` lowercase / `22.5pt` uppercase / `16.5pt+12pt` dual-weight 中/英)
/// - Adaptive-width candidate ribbon measured via `NSString.sizeWithAttributes:` + right `chevron.down` SF Symbol
/// - Expandable candidate drawer, idle next-word predictions, key callout, repeat delete, spacebar trackpad.

use std.option.{Option, Some, None}
use std.vec.{Vec, vecNew, vecLen, vecPush, vecGetOr, vecClear}
use sys.time.{monotonicMs}
use objc.{
    objcClass, objcSel, objcAllocateClass, objcAddMethod, objcRegisterClass,
    msgSend0, msgSend1Ptr, msgSend1I64, msgSendBool0, msgSendI64_0,
    msgSendVoid0, msgSendVoid1Ptr, msgSendVoid1Bool, msgSendVoid1I64,
}
use juxu_core.{
    EngineSnapshot, Candidate, emptyCandidate,
    Touch, T9Touch, LockT9Syllable, SelectPage, SelectAbs, ToggleAscii,
    KeySpace, KeyBackspace, KeyReturn,
    keySpecial, allCandidates, predictNext, acceptPrediction,
    snapConsumed, snapCommitText,
}
use juxu_shared.{
    JuxuSession, sessionStep, sessionState,
    PunctuationAction, InsertPair, SkipClose, Plain,
    punctuationTrackerHandleSymbol, formatAutoSpace,
    CGRect, CGPoint, CGSize, cgRect, rectContainsPoint, nsStr, nsStrPtrToString,
    msgSendRect0, msgSendPoint1Ptr, msgSend4Float, msgSend2Ptr,
}
use layout_engine.{
    KeyboardMode, ModeQwerty, ModeT9, ModeNumbers, ModeSymbols,
    KeySpec, KeyAction, KeyClass, CharClass, FuncClass,
    ActLetter, ActDigitT9, ActSymbol, ActShift, ActBackspace,
    ActSwitchMode, ActToggleAscii, ActGlobe, ActSpace, ActReturn,
    emptyKeySpec, buildLayoutForMode, hitTestKeys,
    ribbonHeight, keyCornerRadius, t9SyllableRailWidth,
}
use marked_text.{proxyCommitText, proxySetMarkedText, proxyDeleteBackward}

extern "objc_msgSend" def msgSendUiBezierRounded(cls: Ptr, sel: Ptr, rect: CGRect, radius: Float): Ptr
extern "objc_msgSend" def msgSendUiFont(cls: Ptr, sel: Ptr, size: Float, weight: Float): Ptr
extern "objc_msgSend" def msgSendUiDrawInRect(str: Ptr, sel: Ptr, rect: CGRect, attrs: Ptr): Void
extern "objc_msgSend" def msgSendUiSizeAttrs(str: Ptr, sel: Ptr, attrs: Ptr): CGSize
extern "objc_msgSend" def msgSendAttrDrawInRect(attrStr: Ptr, sel: Ptr, rect: CGRect): Void
extern "objc_msgSend" def msgSendAttrSize(attrStr: Ptr, sel: Ptr): CGSize
extern "objc_msgSend" def msgSendSymbolCfg(cls: Ptr, sel: Ptr, ptSize: Float, weight: Int64): Ptr
extern "objc_msgSend" def msgSendImageDrawInRect(img: Ptr, sel: Ptr, rect: CGRect): Void
extern "objc_msgSend" def msgSendScheduledTimer(
    cls: Ptr, sel: Ptr, interval: Float, target: Ptr, action: Ptr, userInfo: Ptr, repeats: Bool
): Ptr

def gIosSession: Cell (Option JuxuSession) = cellNew(None)
def gIosVc: Cell Ptr = cellNew(ptrNull())
def gIosView: Cell Ptr = cellNew(ptrNull())
def gIosMode: Cell KeyboardMode = cellNew(ModeQwerty)
def gIosAscii: Cell Bool = cellNew(false)
def gIosShifted: Cell Bool = cellNew(false)
def gShowGlobe: Cell Bool = cellNew(false)
def gIosKeys: Cell (Vec KeySpec) = cellNew(vecNew())
def gIosSnap: Cell (Option EngineSnapshot) = cellNew(None)
def gIosPreds: Cell (Vec String) = cellNew(vecNew())
def gRibbonRects: Cell (Vec CGRect) = cellNew(vecNew())
def gDrawerOpen: Cell Bool = cellNew(false)
def gDrawerCands: Cell (Vec Candidate) = cellNew(vecNew())
def gActiveKey: Cell (Option KeySpec) = cellNew(None)
def gSpaceDragActive: Cell Bool = cellNew(false)
def gSpaceDragLastX: Cell Float = cellNew(0.0)
def gDeleteTimer: Cell Ptr = cellNew(ptrNull())

pub def iosCanvasBind(vc: Ptr, view: Ptr, session: JuxuSession): Void = {
    cellSet(gIosVc, vc);
    cellSet(gIosView, view);
    cellSet(gIosSession, Some(session));
    let needsGlobe = if (!ptrIsNull(vc)) msgSendBool0(vc, objcSel("needsInputModeSwitchKey")) else false;
    cellSet(gShowGlobe, needsGlobe);
    let snap = sessionState(session);
    cellSet(gIosAscii, snap.asciiMode);
    cellSet(gIosSnap, Some(snap));
    cellSet(gIosPreds, predictNext(session.engine, 6))
}

pub def iosCanvasRefreshPredictions(): Void =
    match cellGet(gIosSession) {
        Some(s) -> {
            cellSet(gIosPreds, predictNext(s.engine, 6));
            let v = cellGet(gIosView);
            if (!ptrIsNull(v)) msgSendVoid0(v, objcSel("setNeedsDisplay")) else ()
        },
        None -> (),
    }

def stopDeleteTimer(): Void = {
    let t = cellGet(gDeleteTimer);
    if (!ptrIsNull(t)) {
        msgSendVoid0(t, objcSel("invalidate"));
        cellSet(gDeleteTimer, ptrNull())
    } else ()
}

def isDarkMode(view: Ptr): Bool = {
    let tc = msgSend0(view, objcSel("traitCollection"));
    if (ptrIsNull(tc)) false
    else msgSendI64_0(tc, objcSel("userInterfaceStyle")) == intToI64(2)
}

def uiColorRgba(r: Float, g: Float, b: Float, a: Float): Ptr =
    msgSend4Float(objcClass("UIColor"), objcSel("colorWithRed:green:blue:alpha:"), r, g, b, a)

def uiSystemBlue(): Ptr =
    msgSend0(objcClass("UIColor"), objcSel("systemBlueColor"))

def uiTextAttrs(size: Float, weight: Float, color: Ptr): Ptr = {
    let font = msgSendUiFont(objcClass("UIFont"), objcSel("systemFontOfSize:weight:"), size, weight);
    let para = msgSend0(msgSend0(objcClass("NSMutableParagraphStyle"), objcSel("alloc")), objcSel("init"));
    msgSendVoid1I64(para, objcSel("setAlignment:"), intToI64(1));
    let d = msgSend0(objcClass("NSMutableDictionary"), objcSel("dictionary"));
    let _ = msgSend2Ptr(d, objcSel("setObject:forKey:"), font, nsStr("NSFont"));
    let _ = msgSend2Ptr(d, objcSel("setObject:forKey:"), color, nsStr("NSColor"));
    let _ = msgSend2Ptr(d, objcSel("setObject:forKey:"), para, nsStr("NSParagraphStyle"));
    d
}

def fillRounded(r: CGRect, radius: Float, col: Ptr): Void = {
    msgSendVoid0(col, objcSel("setFill"));
    let p = msgSendUiBezierRounded(objcClass("UIBezierPath"), objcSel("bezierPathWithRoundedRect:cornerRadius:"), r, radius);
    msgSendVoid0(p, objcSel("fill"))
}

def drawCenteredText(text: String, rect: CGRect, attrs: Ptr): Void = {
    let ns = nsStr(text);
    let sz = msgSendUiSizeAttrs(ns, objcSel("sizeWithAttributes:"), attrs);
    let dy = (rect.size.height - sz.height) * 0.5;
    let r = cgRect(rect.origin.x, rect.origin.y + dy, rect.size.width, sz.height + 2.0);
    msgSendUiDrawInRect(ns, objcSel("drawInRect:withAttributes:"), r, attrs)
}

def drawDualLabel(primary: String, secondary: String, rect: CGRect, fgColor: Ptr, mutedColor: Ptr): Void = {
    let f1 = msgSendUiFont(objcClass("UIFont"), objcSel("systemFontOfSize:weight:"), 16.5, 0.23);
    let f2 = msgSendUiFont(objcClass("UIFont"), objcSel("systemFontOfSize:weight:"), 12.0, 0.0);
    let d1 = msgSend0(objcClass("NSMutableDictionary"), objcSel("dictionary"));
    let _ = msgSend2Ptr(d1, objcSel("setObject:forKey:"), f1, nsStr("NSFont"));
    let _ = msgSend2Ptr(d1, objcSel("setObject:forKey:"), fgColor, nsStr("NSColor"));
    let d2 = msgSend0(objcClass("NSMutableDictionary"), objcSel("dictionary"));
    let _ = msgSend2Ptr(d2, objcSel("setObject:forKey:"), f2, nsStr("NSFont"));
    let _ = msgSend2Ptr(d2, objcSel("setObject:forKey:"), mutedColor, nsStr("NSColor"));

    let m = msgSend2Ptr(
        msgSend0(objcClass("NSMutableAttributedString"), objcSel("alloc")),
        objcSel("initWithString:attributes:"), nsStr(primary), d1
    );
    let s2 = msgSend2Ptr(
        msgSend0(objcClass("NSAttributedString"), objcSel("alloc")),
        objcSel("initWithString:attributes:"), nsStr(secondary), d2
    );
    msgSendVoid1Ptr(m, objcSel("appendAttributedString:"), s2);
    let sz = msgSendAttrSize(m, objcSel("size"));
    let dx = (rect.size.width - sz.width) * 0.5;
    let dy = (rect.size.height - sz.height) * 0.5;
    msgSendAttrDrawInRect(m, objcSel("drawInRect:"), cgRect(rect.origin.x + dx, rect.origin.y + dy, sz.width + 2.0, sz.height + 2.0))
}

def drawSfSymbolCentered(symName: String, ptSize: Float, rect: CGRect, tintColor: Ptr): Void = {
    // UIImageSymbolWeightRegular == 4
    let cfg = msgSendSymbolCfg(objcClass("UIImageSymbolConfiguration"), objcSel("configurationWithPointSize:weight:"), ptSize, intToI64(4));
    let img = msgSend2Ptr(objcClass("UIImage"), objcSel("systemImageNamed:withConfiguration:"), nsStr(symName), cfg);
    if (!ptrIsNull(img)) {
        let tinted = msgSend1Ptr(img, objcSel("imageWithTintColor:"), tintColor);
        let finalImg = if (!ptrIsNull(tinted)) tinted else img;
        let sz = msgSendRect0(finalImg, objcSel("size")); // note: size returns CGSize (first 2 doubles)
        let iw = if (sz.origin.x > 1.0 && sz.origin.x < 44.0) sz.origin.x else ptSize * 1.15;
        let ih = if (sz.origin.y > 1.0 && sz.origin.y < 44.0) sz.origin.y else ptSize * 1.05;
        let dx = (rect.size.width - iw) * 0.5;
        let dy = (rect.size.height - ih) * 0.5;
        msgSendImageDrawInRect(finalImg, objcSel("drawInRect:"), cgRect(rect.origin.x + dx, rect.origin.y + dy, iw, ih))
    } else ()
}

def iosViewDrawRect(self: Ptr, _cmd: Ptr, _dirty: CGRect): Void = {
    let bounds = msgSendRect0(self, objcSel("bounds"));
    let dark = isDarkMode(self);
    // Transparent backing! Let iOS 26/27 native glass keyboard tray show through cleanly.

    let fgPrimary = if (dark) uiColorRgba(1.0, 1.0, 1.0, 1.0) else uiColorRgba(0.0, 0.0, 0.0, 1.0);
    let fgWhite = uiColorRgba(1.0, 1.0, 1.0, 1.0);
    let fgMuted = if (dark) uiColorRgba(1.0, 1.0, 1.0, 0.52) else uiColorRgba(0.0, 0.0, 0.0, 0.45);
    let fgModeSub = if (dark) uiColorRgba(1.0, 1.0, 1.0, 0.45) else uiColorRgba(0.0, 0.0, 0.0, 0.38);

    // 1. Adaptive-width Candidate / Prediction Ribbon (top 53pt, transparent glass backing)
    let ribRects = cellGet(gRibbonRects);
    vecClear(ribRects);

    let hasCands = match cellGet(gIosSnap) {
        Some(snap) -> vecLen(snap.pageCandidates) > 0,
        None -> false,
    };

    if (hasCands) {
        match cellGet(gIosSnap) {
            Some(snap) -> {
                let cands = snap.pageCandidates;
                let n = vecLen(cands);
                let dummy = emptyCandidate();
                let expandW = 44.0;
                let maxX = bounds.size.width - expandW - 4.0;
                let attrsTop = uiTextAttrs(18.5, 0.23, fgPrimary);
                let attrsCand = uiTextAttrs(18.0, 0.0, fgPrimary);
                let curX = cellNew(8.0);
                let i = cellNew(0);
                while (cellGet(i) < n && cellGet(curX) < maxX) {
                    let idx = cellGet(i);
                    let c = vecGetOr(cands, idx, dummy);
                    let attrs = if (idx == 0) attrsTop else attrsCand;
                    let sz = msgSendUiSizeAttrs(nsStr(c.text), objcSel("sizeWithAttributes:"), attrs);
                    let slotW = sz.width + 24.0;
                    if (idx == 0 || cellGet(curX) + slotW <= maxX) {
                        let r = cgRect(cellGet(curX), 6.0, slotW, ribbonHeight() - 12.0);
                        vecPush(ribRects, r);
                        drawCenteredText(c.text, r, attrs);
                        cellSet(curX, cellGet(curX) + slotW + 2.0)
                    } else {
                        cellSet(curX, maxX + 1.0)
                    };
                    cellSet(i, idx + 1)
                };
                // Right-edge SF Symbol chevron
                let expSym = if (cellGet(gDrawerOpen)) "chevron.up" else "chevron.down";
                drawSfSymbolCentered(expSym, 16.0, cgRect(bounds.size.width - expandW, 6.0, expandW, ribbonHeight() - 12.0), fgMuted)
            },
            None -> (),
        }
    } else {
        // Idle next-word prediction chips (adaptive width)
        let preds = cellGet(gIosPreds);
        let pn = vecLen(preds);
        let attrsPred = uiTextAttrs(17.5, 0.0, fgPrimary);
        let curX = cellNew(8.0);
        let maxX = bounds.size.width - 8.0;
        let i = cellNew(0);
        while (cellGet(i) < pn && cellGet(curX) < maxX) {
            let idx = cellGet(i);
            let w = vecGetOr(preds, idx, "");
            let sz = msgSendUiSizeAttrs(nsStr(w), objcSel("sizeWithAttributes:"), attrsPred);
            let slotW = sz.width + 26.0;
            if (idx == 0 || cellGet(curX) + slotW <= maxX) {
                let r = cgRect(cellGet(curX), 6.0, slotW, ribbonHeight() - 12.0);
                vecPush(ribRects, r);
                drawCenteredText(w, r, attrsPred);
                cellSet(curX, cellGet(curX) + slotW + 4.0)
            } else {
                cellSet(curX, maxX + 1.0)
            };
            cellSet(i, idx + 1)
        }
    };

    // 2. Expanded Candidate Drawer (overlays key area when open)
    if (cellGet(gDrawerOpen)) {
        let drawerBg = if (dark) uiColorRgba(0.14, 0.14, 0.16, 0.92) else uiColorRgba(0.96, 0.96, 0.98, 0.92);
        fillRounded(cgRect(6.0, ribbonHeight(), bounds.size.width - 12.0, bounds.size.height - ribbonHeight() - 6.0), 12.0, drawerBg);
        let allC = cellGet(gDrawerCands);
        let cn = vecLen(allC);
        let limit = if (cn < 24) cn else 24;
        let cols = 4;
        let cellW = (bounds.size.width - 12.0) / intToFloat(cols);
        let cellH = 36.0;
        let attrsD = uiTextAttrs(17.5, 0.0, fgPrimary);
        let dummy = emptyCandidate();
        let i = cellNew(0);
        while (cellGet(i) < limit) {
            let idx = cellGet(i);
            let row = idx / cols;
            let col = idx % cols;
            let c = vecGetOr(allC, idx, dummy);
            let r = cgRect(6.0 + intToFloat(col) * cellW, ribbonHeight() + intToFloat(row) * cellH, cellW, cellH);
            drawCenteredText(c.text, r, attrsD);
            cellSet(i, idx + 1)
        }
    } else {
        // Exact `main` Light / Dark keycap colors (IOSKeyCanvasView.swift lines 283-292)
        let charBg = if (dark) uiColorRgba(1.0, 1.0, 1.0, 0.175) else uiColorRgba(1.0, 1.0, 1.0, 1.0);
        let funcBg = if (dark) uiColorRgba(1.0, 1.0, 1.0, 0.09) else uiColorRgba(184.0 / 255.0, 188.0 / 255.0, 198.0 / 255.0, 1.0);
        let pressBg = if (dark) uiColorRgba(1.0, 1.0, 1.0, 0.30) else uiColorRgba(214.0 / 255.0, 216.0 / 255.0, 222.0 / 255.0, 1.0);
        let blueBg = uiSystemBlue();
        let bluePressBg = uiColorRgba(0.0, 122.0 / 255.0, 1.0, 0.80);

        // T9 left syllable rail (when in ModeT9)
        if (cellGet(gIosMode) == ModeT9) {
            let railRect = cgRect(6.67, ribbonHeight(), t9SyllableRailWidth(), 157.0);
            fillRounded(railRect, keyCornerRadius(), funcBg);
            let attrsSyl = uiTextAttrs(16.0, 0.23, fgPrimary);
            match cellGet(gIosSnap) {
                Some(snap) -> match snap.t9 {
                    Some(t9) -> {
                        let sn = vecLen(t9.t9Syllables);
                        let lim = if (sn < 4) sn else 4;
                        let si = cellNew(0);
                        while (cellGet(si) < lim) {
                            let idx = cellGet(si);
                            let syl = vecGetOr(t9.t9Syllables, idx, "");
                            drawCenteredText(syl, cgRect(6.67, ribbonHeight() + intToFloat(idx) * 38.0, t9SyllableRailWidth(), 38.0), attrsSyl);
                            cellSet(si, idx + 1)
                        }
                    },
                    None -> (),
                },
                None -> (),
            }
        } else ();

        // Flat shadowless keycaps with exact typography & SF Symbols
        let keys = cellGet(gIosKeys);
        let kn = vecLen(keys);
        let kDummy = emptyKeySpec();
        let letterSize = if (cellGet(gIosShifted)) 22.5 else 24.5;
        let attrsLetter = uiTextAttrs(letterSize, 0.0, fgPrimary);
        let attrsFunc = uiTextAttrs(17.5, 0.0, fgPrimary);
        let attrsReturn = uiTextAttrs(16.0, 0.23, fgWhite);
        let attrsSpace = uiTextAttrs(16.0, 0.0, fgPrimary);

        let ki = cellNew(0);
        while (cellGet(ki) < kn) {
            let k = vecGetOr(keys, cellGet(ki), kDummy);
            let isPressed = match cellGet(gActiveKey) {
                Some(ak) -> ak.action == k.action,
                None -> false,
            };
            let fillCol = if (k.isBlueAccent) {
                if (isPressed) bluePressBg else blueBg
            } else if (isPressed) {
                pressBg
            } else if (k.usesFuncFill) {
                funcBg
            } else {
                charBg
            };
            let drawRect = if (isPressed) {
                cgRect(k.frame.origin.x, k.frame.origin.y + 0.45, k.frame.size.width, k.frame.size.height)
            } else k.frame;
            fillRounded(drawRect, keyCornerRadius(), fillCol);

            let fg = if (k.isBlueAccent) fgWhite else fgPrimary;
            if (strLen(k.sfSymbol) > 0) {
                drawSfSymbolCentered(k.sfSymbol, 19.5, drawRect, fg)
            } else if (strLen(k.secondaryLabel) > 0) {
                drawDualLabel(k.label, k.secondaryLabel, drawRect, fg, fgModeSub)
            } else if (k.isBlueAccent) {
                drawCenteredText(k.label, drawRect, attrsReturn)
            } else if (k.action == ActSpace) {
                drawCenteredText(k.label, drawRect, attrsSpace)
            } else if (k.keyClass == CharClass && cellGet(gIosMode) == ModeQwerty) {
                drawCenteredText(k.label, drawRect, attrsLetter)
            } else {
                drawCenteredText(k.label, drawRect, attrsFunc)
            };
            cellSet(ki, cellGet(ki) + 1)
        };

        // Floating Key Callout Bubble for pressed CharClass key in QWERTY
        if (cellGet(gIosMode) == ModeQwerty) {
            match cellGet(gActiveKey) {
                Some(ak) if (ak.keyClass == CharClass) -> {
                    let cw = ak.frame.size.width + 16.0;
                    let ch = 54.0;
                    let cx = ak.frame.origin.x - 8.0;
                    let cy = ak.frame.origin.y - ch - 4.0;
                    let popRect = cgRect(if (cx < 2.0) 2.0 else cx, if (cy < 2.0) 2.0 else cy, cw, ch);
                    let popBg = if (dark) uiColorRgba(0.28, 0.28, 0.30, 1.0) else uiColorRgba(1.0, 1.0, 1.0, 1.0);
                    fillRounded(popRect, 11.0, popBg);
                    drawCenteredText(ak.label, popRect, uiTextAttrs(30.0, 0.0, fgPrimary))
                },
                _ -> (),
            }
        } else ()
    }
}

def rebuildLayout(self: Ptr): Void = {
    let bounds = msgSendRect0(self, objcSel("bounds"));
    if (bounds.size.width > 10.0) {
        cellSet(gIosKeys, buildLayoutForMode(
            cellGet(gIosMode),
            bounds.size.width,
            cellGet(gIosAscii),
            cellGet(gIosShifted),
            cellGet(gShowGlobe)
        ));
        msgSendVoid0(self, objcSel("setNeedsDisplay"))
    } else ()
}

def iosViewLayoutSubviews(self: Ptr, _cmd: Ptr): Void =
    rebuildLayout(self)

def applySnapToProxy(snap: EngineSnapshot): Void = {
    cellSet(gIosSnap, Some(snap));
    cellSet(gIosAscii, snap.asciiMode);
    if (vecLen(snap.pageCandidates) == 0) cellSet(gDrawerOpen, false) else ();
    let vc = cellGet(gIosVc);
    if (!ptrIsNull(vc)) {
        let proxy = msgSend0(vc, objcSel("textDocumentProxy"));
        let committed = snapCommitText(snap);
        if (strLen(committed) > 0) {
            match cellGet(gIosSession) {
                Some(s) -> {
                    let before = nsStrPtrToString(msgSend0(proxy, objcSel("documentContextBeforeInput")));
                    let formatted = formatAutoSpace(before, committed, cellGet(s.autoSpace));
                    match punctuationTrackerHandleSymbol(s.punctuation, formatted, "") {
                        InsertPair(close) -> {
                            proxyCommitText(proxy, formatted + close);
                            msgSendVoid1I64(proxy, objcSel("adjustTextPositionByCharacterOffset:"), intToI64(-1))
                        },
                        SkipClose -> msgSendVoid1I64(proxy, objcSel("adjustTextPositionByCharacterOffset:"), intToI64(1)),
                        Plain -> proxyCommitText(proxy, formatted),
                    };
                    cellSet(gIosPreds, predictNext(s.engine, 6))
                },
                None -> proxyCommitText(proxy, committed),
            }
        } else ();
        proxySetMarkedText(proxy, snap.displayPreedit)
    } else ()
}

def performBackspace(self: Ptr): Void = {
    let vc = cellGet(gIosVc);
    match cellGet(gIosSession) {
        Some(s) -> {
            let snap = sessionStep(s, keySpecial(KeyBackspace, monotonicMs()));
            if (snapConsumed(snap)) applySnapToProxy(snap)
            else if (!ptrIsNull(vc)) proxyDeleteBackward(msgSend0(vc, objcSel("textDocumentProxy")))
            else ()
        },
        None -> (),
    };
    msgSendVoid0(self, objcSel("setNeedsDisplay"))
}

def onDeleteRepeatTimer(self: Ptr, _cmd: Ptr, _timer: Ptr): Void =
    performBackspace(self)

def dispatchKeyRelease(self: Ptr, k: KeySpec, pt: CGPoint): Void = {
    let vc = cellGet(gIosVc);
    match cellGet(gIosSession) {
        None -> (),
        Some(s) -> {
            let nowMs = monotonicMs();
            match k.action {
                ActLetter(ch) -> {
                    let actualCh = if (cellGet(gIosShifted) && ch >= 97 && ch <= 122) ch - 32 else ch;
                    if (cellGet(gIosShifted)) {
                        cellSet(gIosShifted, false);
                        rebuildLayout(self)
                    } else ();
                    let snap = sessionStep(s, Touch {
                        ascii: actualCh, x: pt.x, y: pt.y, normalized: false, atMs: nowMs,
                    });
                    applySnapToProxy(snap)
                },
                ActDigitT9(d) -> {
                    let snap = sessionStep(s, T9Touch {
                        digit: d, x: pt.x, y: pt.y, normalized: false, atMs: nowMs,
                    });
                    applySnapToProxy(snap)
                },
                ActSymbol(sym) -> {
                    if (!ptrIsNull(vc)) {
                        let proxy = msgSend0(vc, objcSel("textDocumentProxy"));
                        match punctuationTrackerHandleSymbol(s.punctuation, sym, "") {
                            InsertPair(close) -> {
                                proxyCommitText(proxy, sym + close);
                                msgSendVoid1I64(proxy, objcSel("adjustTextPositionByCharacterOffset:"), intToI64(-1))
                            },
                            SkipClose -> msgSendVoid1I64(proxy, objcSel("adjustTextPositionByCharacterOffset:"), intToI64(1)),
                            Plain -> proxyCommitText(proxy, sym),
                        }
                    } else ()
                },
                ActSpace -> {
                    let snap = sessionStep(s, keySpecial(KeySpace, nowMs));
                    if (snapConsumed(snap)) applySnapToProxy(snap)
                    else if (!ptrIsNull(vc)) proxyCommitText(msgSend0(vc, objcSel("textDocumentProxy")), " ")
                    else ()
                },
                ActBackspace -> performBackspace(self),
                ActReturn -> {
                    let snap = sessionStep(s, keySpecial(KeyReturn, nowMs));
                    if (snapConsumed(snap)) applySnapToProxy(snap)
                    else if (!ptrIsNull(vc)) proxyCommitText(msgSend0(vc, objcSel("textDocumentProxy")), "\n")
                    else ()
                },
                ActToggleAscii -> {
                    let snap = sessionStep(s, ToggleAscii);
                    applySnapToProxy(snap);
                    rebuildLayout(self)
                },
                ActSwitchMode(nextMode) -> {
                    cellSet(gIosMode, nextMode);
                    rebuildLayout(self)
                },
                ActShift -> {
                    cellSet(gIosShifted, !cellGet(gIosShifted));
                    rebuildLayout(self)
                },
                ActGlobe -> {
                    if (!ptrIsNull(vc)) msgSendVoid0(vc, objcSel("advanceToNextInputMode")) else ()
                },
            }
        },
    };
    msgSendVoid0(self, objcSel("setNeedsDisplay"))
}

def iosTouchesBegan(self: Ptr, _cmd: Ptr, touches: Ptr, _event: Ptr): Void = {
    let t = msgSend0(touches, objcSel("anyObject"));
    if (!ptrIsNull(t)) {
        let pt = msgSendPoint1Ptr(t, objcSel("locationInView:"), self);
        let bounds = msgSendRect0(self, objcSel("bounds"));
        if (pt.y < ribbonHeight()) {
            match (cellGet(gIosSession), cellGet(gIosSnap)) {
                (Some(s), Some(snap)) -> {
                    let n = vecLen(snap.pageCandidates);
                    if (n > 0 && pt.x >= bounds.size.width - 44.0) {
                        let opening = !cellGet(gDrawerOpen);
                        cellSet(gDrawerOpen, opening);
                        if (opening) cellSet(gDrawerCands, allCandidates(s.engine, 24)) else ();
                        msgSendVoid0(self, objcSel("setNeedsDisplay"))
                    } else {
                        let rects = cellGet(gRibbonRects);
                        let rn = vecLen(rects);
                        let z = cgRect(0.0, 0.0, 0.0, 0.0);
                        let i = cellNew(0);
                        let done = cellNew(false);
                        while (cellGet(i) < rn && !cellGet(done)) {
                            let idx = cellGet(i);
                            if (rectContainsPoint(vecGetOr(rects, idx, z), pt)) {
                                cellSet(done, true);
                                if (n > 0) {
                                    let nextSnap = sessionStep(s, SelectPage { index: idx, atMs: monotonicMs() });
                                    applySnapToProxy(nextSnap);
                                    msgSendVoid0(self, objcSel("setNeedsDisplay"))
                                } else {
                                    let word = vecGetOr(cellGet(gIosPreds), idx, "");
                                    let vc = cellGet(gIosVc);
                                    if (!ptrIsNull(vc) && strLen(word) > 0) {
                                        proxyCommitText(msgSend0(vc, objcSel("textDocumentProxy")), word);
                                        acceptPrediction(s.engine, word, monotonicMs());
                                        cellSet(gIosPreds, predictNext(s.engine, 6));
                                        msgSendVoid0(self, objcSel("setNeedsDisplay"))
                                    } else ()
                                }
                            } else ();
                            cellSet(i, idx + 1)
                        }
                    }
                },
                _ -> (),
            }
        } else if (cellGet(gDrawerOpen)) {
            let cols = 4;
            let cellW = (bounds.size.width - 12.0) / intToFloat(cols);
            let row = floatToInt((pt.y - ribbonHeight()) / 36.0);
            let col = floatToInt((pt.x - 6.0) / cellW);
            let idx = row * cols + col;
            if (idx >= 0 && idx < vecLen(cellGet(gDrawerCands))) {
                match cellGet(gIosSession) {
                    Some(s) -> {
                        cellSet(gDrawerOpen, false);
                        let nextSnap = sessionStep(s, SelectAbs { index: idx, atMs: monotonicMs() });
                        applySnapToProxy(nextSnap);
                        msgSendVoid0(self, objcSel("setNeedsDisplay"))
                    },
                    None -> (),
                }
            } else ()
        } else if (cellGet(gIosMode) == ModeT9 && pt.x < t9SyllableRailWidth() + 7.0 && pt.y < ribbonHeight() + 160.0) {
            let sIdx = floatToInt((pt.y - ribbonHeight()) / 38.0);
            match (cellGet(gIosSession), cellGet(gIosSnap)) {
                (Some(s), Some(snap)) -> match snap.t9 {
                    Some(t9) if (sIdx >= 0 && sIdx < vecLen(t9.t9Syllables)) -> {
                        let syl = vecGetOr(t9.t9Syllables, sIdx, "");
                        let nextSnap = sessionStep(s, LockT9Syllable(syl));
                        applySnapToProxy(nextSnap);
                        msgSendVoid0(self, objcSel("setNeedsDisplay"))
                    },
                    _ -> (),
                },
                _ -> (),
            }
        } else {
            let hit = hitTestKeys(cellGet(gIosKeys), pt);
            cellSet(gActiveKey, hit);
            cellSet(gSpaceDragActive, false);
            cellSet(gSpaceDragLastX, pt.x);
            match hit {
                Some(k) if (k.action == ActBackspace) -> {
                    stopDeleteTimer();
                    let timer = msgSendScheduledTimer(
                        objcClass("NSTimer"),
                        objcSel("scheduledTimerWithTimeInterval:target:selector:userInfo:repeats:"),
                        0.12, self, objcSel("onDeleteRepeatTimer:"), ptrNull(), true
                    );
                    cellSet(gDeleteTimer, timer)
                },
                _ -> (),
            };
            msgSendVoid0(self, objcSel("setNeedsDisplay"))
        }
    } else ()
}

def iosTouchesMoved(self: Ptr, _cmd: Ptr, touches: Ptr, _event: Ptr): Void = {
    let t = msgSend0(touches, objcSel("anyObject"));
    if (!ptrIsNull(t)) {
        let pt = msgSendPoint1Ptr(t, objcSel("locationInView:"), self);
        match cellGet(gActiveKey) {
            Some(ak) if (ak.action == ActSpace) -> {
                let dx = pt.x - cellGet(gSpaceDragLastX);
                if (dx >= 14.0 || dx <= -14.0) {
                    let steps = floatToInt(dx / 14.0);
                    cellSet(gSpaceDragActive, true);
                    cellSet(gSpaceDragLastX, cellGet(gSpaceDragLastX) + intToFloat(steps) * 14.0);
                    let vc = cellGet(gIosVc);
                    if (!ptrIsNull(vc)) {
                        let proxy = msgSend0(vc, objcSel("textDocumentProxy"));
                        msgSendVoid1I64(proxy, objcSel("adjustTextPositionByCharacterOffset:"), intToI64(steps))
                    } else ()
                } else ()
            },
            Some(prev) -> match hitTestKeys(cellGet(gIosKeys), pt) {
                Some(next) if (prev.keyClass == next.keyClass) -> {
                    cellSet(gActiveKey, Some(next));
                    msgSendVoid0(self, objcSel("setNeedsDisplay"))
                },
                _ -> (),
            },
            None -> (),
        }
    } else ()
}

def iosTouchesEnded(self: Ptr, _cmd: Ptr, touches: Ptr, _event: Ptr): Void = {
    stopDeleteTimer();
    let wasSpaceDrag = cellGet(gSpaceDragActive);
    cellSet(gSpaceDragActive, false);
    let t = msgSend0(touches, objcSel("anyObject"));
    match cellGet(gActiveKey) {
        Some(k) -> {
            cellSet(gActiveKey, None);
            if (!wasSpaceDrag) {
                let pt = if (!ptrIsNull(t)) msgSendPoint1Ptr(t, objcSel("locationInView:"), self)
                         else CGPoint { x: k.frame.origin.x, y: k.frame.origin.y };
                dispatchKeyRelease(self, k, pt)
            } else {
                msgSendVoid0(self, objcSel("setNeedsDisplay"))
            }
        },
        None -> (),
    }
}

def iosTouchesCancelled(self: Ptr, _cmd: Ptr, _touches: Ptr, _event: Ptr): Void = {
    stopDeleteTimer();
    cellSet(gSpaceDragActive, false);
    cellSet(gActiveKey, None);
    msgSendVoid0(self, objcSel("setNeedsDisplay"))
}

extern init(100) def registerIosKeyboardViewClass(): Void = {
    let cls = objcAllocateClass("UIView", "JuxuIOSKeyboardView");
    if (!ptrIsNull(cls)) {
        let _ = objcAddMethod(cls, "drawRect:", cFnPtr(iosViewDrawRect), "v@:{CGRect={CGPoint=dd}{CGSize=dd}}");
        let _ = objcAddMethod(cls, "layoutSubviews", cFnPtr(iosViewLayoutSubviews), "v@:");
        let _ = objcAddMethod(cls, "touchesBegan:withEvent:", cFnPtr(iosTouchesBegan), "v@:@@");
        let _ = objcAddMethod(cls, "touchesMoved:withEvent:", cFnPtr(iosTouchesMoved), "v@:@@");
        let _ = objcAddMethod(cls, "touchesEnded:withEvent:", cFnPtr(iosTouchesEnded), "v@:@@");
        let _ = objcAddMethod(cls, "touchesCancelled:withEvent:", cFnPtr(iosTouchesCancelled), "v@:@@");
        let _ = objcAddMethod(cls, "onDeleteRepeatTimer:", cFnPtr(onDeleteRepeatTimer), "v@:@");
        objcRegisterClass(cls)
    } else ()
}
