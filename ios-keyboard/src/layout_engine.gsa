pub def wubiRadicalsForAscii(ascii: Int, schemaId: Int): Option String = {
    let idx =
        if (ascii >= 97 && ascii <= 122) ascii - 97
        else if (ascii >= 65 && ascii <= 90) ascii - 65
        else -1;
    if (idx < 0) None
    else if (schemaId == 86) Some(vecGetOr(wubi86RadicalTable(), idx, ""))
    else if (schemaId == 98) Some(vecGetOr(wubi98RadicalTable(), idx, ""))
    else if (schemaId == 6) Some(vecGetOr(wubi06RadicalTable(), idx, ""))
    else None
}

// ============================================================================
// Bottom Row Punctuation & Plane Stay-vs-Return Rules
// ============================================================================

pub def bottomRowPunctuation(asciiMode: Bool): (String, String) =
    if (asciiMode) (",", ".") else ("，", "。")

def isAllNumberScalars(s: String): Bool = {
    let scs = utf8ToScalars(s);
    let n = vecLen(scs);
    if (n == 0) false
    else {
        let i = cellNew(0);
        let ok = cellNew(true);
        while (cellGet(i) < n && cellGet(ok)) {
            let cp = vecGetOr(scs, cellGet(i), 0);
            // ASCII '0'..'9' or fullwidth '０'..'９'
            let isNum = (cp >= 48 && cp <= 57) || (cp >= 0xFF10 && cp <= 0xFF19);
            if (!isNum) cellSet(ok, false) else ();
            cellSet(i, cellGet(i) + 1)
        };
        cellGet(ok)
    }
}

pub def shouldReturnToLettersAfterSymbol(sym: String, plane: IOSKeyPlane): Bool =
    if (strLen(sym) > 0 && isAllNumberScalars(sym)) false
    else match plane {
        PlaneNumbers -> {
            let stay = sym == "-"
                || sym == "/"
                || sym == ":"
                || sym == "："
                || sym == "."
                || sym == "￥"
                || sym == "¥"
                || sym == "$";
            !stay
        },
        PlaneSymbols -> {
            let stay = sym == "~" || sym == "～" || sym == "…";
            !stay
        },
        PlaneLetters -> false,
    }

// ============================================================================
// IOSKeyboardLayoutEngine & LayoutSnapshot
// ============================================================================

pub data LayoutSnapshot {
    lsBounds: CGRect,
    lsKeys: Vec IOSKeySpec,
    lsCenters52: Vec Float,
    lsOriginX: Float,
    lsOriginY: Float,
    lsPitchX: Float,
    lsPitchY: Float,
    lsBottomRowMinY: Float,
    lsIsT9Layout: Bool,
    lsT9SidebarFrame: CGRect,
    lsT9Centers16: Vec Float,
    lsT9OriginX: Float,
    lsT9OriginY: Float,
    lsT9PitchX: Float,
    lsT9PitchY: Float,
}

pub data IOSKeyboardLayoutEngine {
    lePlane: Cell IOSKeyPlane,
    leShiftState: Cell IOSShiftState,
    leAsciiMode: Cell Bool,
    leSchemaId: Cell Int,
    lePinyinT9Layout: Cell Bool,
    leCangjieKeycapRadicals: Cell Bool,
    leWubiKeycapRadicals: Cell Bool,
    leSwipeUpInputEnabled: Cell Bool,
    leSpaceCommaKeyEnabled: Cell Bool,
    leIsZLookupActive: Cell Bool,
    leShowInlineGlobeKey: Cell Bool,
    leReturnRole: Cell IOSReturnKeyRole,
    leIsComposing: Cell Bool,
    leIsTrackpadActive: Cell Bool,
    leValidNextMask: Cell Int,
    leNextKeyPriors: Cell (Vec Int),
    leTouchOffsets: Cell (Vec Float),
    leT9ValidNextMask: Cell Int,
    leT9NextKeyPriors: Cell (Vec Int),
    leT9TouchOffsets: Cell (Vec Float),
    leLastShiftTapTime: Cell Float,
}

pub def layoutEngineNew(): IOSKeyboardLayoutEngine =
    IOSKeyboardLayoutEngine {
        lePlane: cellNew(PlaneLetters),
        leShiftState: cellNew(ShiftLower),
        leAsciiMode: cellNew(false),
        leSchemaId: cellNew(86),
        lePinyinT9Layout: cellNew(false),
        leCangjieKeycapRadicals: cellNew(true),
        leWubiKeycapRadicals: cellNew(false),
        leSwipeUpInputEnabled: cellNew(false),
        leSpaceCommaKeyEnabled: cellNew(false),
        leIsZLookupActive: cellNew(false),
        leShowInlineGlobeKey: cellNew(false),
        leReturnRole: cellNew(ReturnNormal),
        leIsComposing: cellNew(false),
        leIsTrackpadActive: cellNew(false),
        leValidNextMask: cellNew(0x03FF_FFFF),
        leNextKeyPriors: cellNew(makeFilledIntVec(26, 100)),
        leTouchOffsets: cellNew(makeFilledFloatVec(52, 0.0)),
        leT9ValidNextMask: cellNew(0xFF),
        leT9NextKeyPriors: cellNew(makeFilledIntVec(8, 100)),
        leT9TouchOffsets: cellNew(makeFilledFloatVec(16, 0.0)),
        leLastShiftTapTime: cellNew(0.0),
    }

pub def layoutIsT9PinyinActive(eng: IOSKeyboardLayoutEngine): Bool =
    cellGet(eng.lePlane) == PlaneLetters
        && !cellGet(eng.leAsciiMode)
        && cellGet(eng.leSchemaId) == 20
        && cellGet(eng.lePinyinT9Layout)

pub def layoutTapShift(eng: IOSKeyboardLayoutEngine, timestamp: Float): Void =
    match cellGet(eng.leShiftState) {
        ShiftLower -> {
            cellSet(eng.leShiftState, ShiftUpperOnce);
            cellSet(eng.leLastShiftTapTime, timestamp)
        },
        ShiftUpperOnce -> {
            if (timestamp - cellGet(eng.leLastShiftTapTime) <= 0.34) {
                cellSet(eng.leShiftState, ShiftCapsLocked)
            } else {
                cellSet(eng.leShiftState, ShiftLower)
            };
            cellSet(eng.leLastShiftTapTime, 0.0)
        },
        ShiftCapsLocked -> {
            cellSet(eng.leShiftState, ShiftLower);
            cellSet(eng.leLastShiftTapTime, 0.0)
        },
    }

pub def layoutConsumeOneShotShiftIfNeeded(eng: IOSKeyboardLayoutEngine): Void =
    if (cellGet(eng.leShiftState) == ShiftUpperOnce) {
        cellSet(eng.leShiftState, ShiftLower)
    } else ()

pub def layoutSwitchPlane(eng: IOSKeyboardLayoutEngine, target: IOSKeyPlane): Void = {
    cellSet(eng.lePlane, target);
    if (target != PlaneLetters && cellGet(eng.leShiftState) == ShiftUpperOnce) {
        cellSet(eng.leShiftState, ShiftLower)
    } else ()
}

pub def layoutSpaceCornerTag(eng: IOSKeyboardLayoutEngine): Option String =
    if (cellGet(eng.leIsTrackpadActive)) None
    else if (cellGet(eng.leAsciiMode)) Some("EN")
    else {
        let sid = cellGet(eng.leSchemaId);
        if (sid == 20) Some(if (cellGet(eng.lePinyinT9Layout)) "九" else "拼")
        else if (sid == 21) Some("双")
        else if (sid == 10) Some("鹤")
        else if (sid == 33 || sid == 35 || sid == 36) Some("仓")
        else Some("五")
    }

pub def layoutShowsCangjieRadicals(eng: IOSKeyboardLayoutEngine): Bool = {
    let sid = cellGet(eng.leSchemaId);
    cellGet(eng.leCangjieKeycapRadicals)
        && !cellGet(eng.leAsciiMode)
        && !shiftIsUppercase(cellGet(eng.leShiftState))
        && !cellGet(eng.leIsZLookupActive)
        && (sid == 33 || sid == 35 || sid == 36)
}

pub def layoutShowsWubiRadicals(eng: IOSKeyboardLayoutEngine): Bool = {
    let sid = cellGet(eng.leSchemaId);
    cellGet(eng.leWubiKeycapRadicals)
        && !cellGet(eng.leAsciiMode)
        && !shiftIsUppercase(cellGet(eng.leShiftState))
        && (sid == 86 || sid == 98 || sid == 6)
}

def formatWubiRadicals(eng: IOSKeyboardLayoutEngine, ascii: Int): Option String =
    if (cellGet(eng.leIsTrackpadActive) || !layoutShowsWubiRadicals(eng)) None
    else wubiRadicalsForAscii(ascii, cellGet(eng.leSchemaId))

def asciiByteToLetterStr(ascii: Int, upper: Bool): String = {
    let lower = if (ascii >= 65 && ascii <= 90) ascii + 32 else ascii;
    let target = if (upper && lower >= 97 && lower <= 122) lower - 32 else lower;
    let alphabet = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
    let offset = target - 32;
    if (offset >= 0 && offset < strLen(alphabet)) strSlice(alphabet, offset, offset + 1)
    else ""
}

def formatLetter(eng: IOSKeyboardLayoutEngine, ascii: Int): String =
    if (cellGet(eng.leIsTrackpadActive)) ""
    else if (layoutShowsCangjieRadicals(eng)) {
        match cangjieRadicalForAscii(ascii) {
            Some(rad) -> rad,
            None -> asciiByteToLetterStr(ascii, shiftIsUppercase(cellGet(eng.leShiftState))),
        }
    } else asciiByteToLetterStr(ascii, shiftIsUppercase(cellGet(eng.leShiftState)))

def appendTenRow(
    labels: Vec String,
    rowIdx: Int,
    rowY: Float,
    outerX: Float,
    pitchX: Float,
    keyW: Float,
    keyH: Float,
    trackpadActive: Bool,
    specs: Vec IOSKeySpec
): Void = {
    let n = vecLen(labels);
    let c = cellNew(0);
    while (cellGet(c) < n) {
        let idx = cellGet(c);
        let s = vecGetOr(labels, idx, "");
        let x = outerX + intToFloat(idx) * pitchX;
        vecPush(
            specs,
            keySpecSimple(
                "S_" + intToStr(rowIdx) + "_" + intToStr(idx),
                KeySymbol(s),
                cgRect(x, rowY, keyW, keyH),
                if (trackpadActive) "" else s
            )
        );
        cellSet(c, idx + 1)
    }
}

def appendSpanSymbols(
    labels: Vec String,
    rowY: Float,
    minX: Float,
    maxX: Float,
    gapX: Float,
    keyH: Float,
    trackpadActive: Bool,
    specs: Vec IOSKeySpec
): Void = {
    let cnt = vecLen(labels);
    if (cnt > 0) {
        let nf = intToFloat(cnt);
        let kw = ((maxX - minX) - gapX * (nf - 1.0)) / nf;
        let i = cellNew(0);
        while (cellGet(i) < cnt) {
            let idx = cellGet(i);
            let s = vecGetOr(labels, idx, "");
            let x = minX + intToFloat(idx) * (kw + gapX);
            vecPush(
                specs,
                keySpecSimple(
                    "SM_" + intToStr(idx),
                    KeySymbol(s),
                    cgRect(x, rowY, kw, keyH),
                    if (trackpadActive) "" else s
                )
            );
            cellSet(i, idx + 1)
        }
    } else ()
}

def vecFrom10(
    s0: String, s1: String, s2: String, s3: String, s4: String,
    s5: String, s6: String, s7: String, s8: String, s9: String
): Vec String = {
    let v: Vec String = vecWithCap(10);
    vecPush(v, s0); vecPush(v, s1); vecPush(v, s2); vecPush(v, s3); vecPush(v, s4);
    vecPush(v, s5); vecPush(v, s6); vecPush(v, s7); vecPush(v, s8); vecPush(v, s9);
    v
}

def vecFrom5(s0: String, s1: String, s2: String, s3: String, s4: String): Vec String = {
    let v: Vec String = vecWithCap(5);
    vecPush(v, s0); vecPush(v, s1); vecPush(v, s2); vecPush(v, s3); vecPush(v, s4);
    v
}

def vecFrom6(s0: String, s1: String, s2: String, s3: String, s4: String, s5: String): Vec String = {
    let v: Vec String = vecWithCap(6);
    vecPush(v, s0); vecPush(v, s1); vecPush(v, s2); vecPush(v, s3); vecPush(v, s4); vecPush(v, s5);
    v
}

def appendCommaBottomRow(
    eng: IOSKeyboardLayoutEngine,
    w: Float,
    outerX: Float,
    gapX: Float,
    pitchX: Float,
    keyW: Float,
    keyH: Float,
    y: Float,
    specs: Vec IOSKeySpec
): Void = {
    let trackpad = cellGet(eng.leIsTrackpadActive);
    let ascii = cellGet(eng.leAsciiMode);
    let role = cellGet(eng.leReturnRole);
    let sideW = pitchX * commaRowSideWidth();
    let modeW = pitchX * commaRowModeWidth();
    let hasCommaKey = cellGet(eng.lePlane) == PlaneLetters;
    let commaX = outerX + sideW + gapX;
    let spaceX = if (hasCommaKey) commaX + keyW + gapX else commaX;
    let modeX = w - outerX - sideW - gapX - modeW;
    let spaceW = modeX - gapX - spaceX;
    let returnX = modeX + modeW + gapX;
    let targetPlane = if (hasCommaKey) PlaneNumbers else PlaneLetters;
    let planeLabel = if (hasCommaKey) "123" else "ABC";

    vecPush(
        specs,
        makeKeySpec(
            "B_plane",
            KeyPlaneSwitch { targetPlane: targetPlane, switchLabel: planeLabel },
            cgRect(outerX, y, sideW, keyH),
            if (trackpad) "" else planeLabel,
            None,
            None,
            None,
            None,
            false,
            None,
            true
        )
    );

    if (hasCommaKey) {
        let (commaSym, periodSym) = bottomRowPunctuation(ascii);
        vecPush(
            specs,
            makeKeySpec(
                "B_comma",
                KeySymbol(commaSym),
                cgRect(commaX, y, keyW, keyH),
                if (trackpad) "" else commaSym,
                None,
                None,
                None,
                None,
                false,
                if (trackpad) None else Some(periodSym),
                false
            )
        )
    } else ();

    vecPush(
        specs,
        makeKeySpec(
            "B_space",
            KeySpace,
            cgRect(spaceX, y, spaceW, keyH),
            "",
            None,
            layoutSpaceCornerTag(eng),
            None,
            None,
            false,
            None,
            false
        )
    );

    let modeFrame = cgRect(modeX, y, modeW, keyH);
    if (cellGet(eng.leShowInlineGlobeKey)) {
        vecPush(
            specs,
            makeKeySpec(
                "B_globe",
                KeyGlobe,
                modeFrame,
                "",
                None,
                None,
                None,
                if (trackpad) None else Some("globe"),
                false,
                None,
                false
            )
        )
    } else {
        vecPush(
            specs,
            makeKeySpec(
                "B_mode",
                KeyModeToggle,
                modeFrame,
                if (trackpad) "" else (if (ascii) "英" else "中"),
                None,
                if (trackpad) None else Some(if (ascii) "中" else "英"),
                None,
                None,
                false,
                None,
                false
            )
        )
    };

    let useBlue = returnRoleIsBlueProminent(role);
    vecPush(
        specs,
        makeKeySpec(
            "B_return",
            KeyReturn,
            cgRect(returnX, y, w - outerX - returnX, keyH),
            if (trackpad) "" else (if (useBlue) returnRoleTitle(role) else ""),
            None,
            None,
            None,
            if (trackpad) None else (if (useBlue) None else Some("return.left")),
            useBlue,
            None,
            true
        )
    )
}

def computeT9Layout(
    eng: IOSKeyboardLayoutEngine,
    w: Float,
    h: Float,
    outerX: Float,
    gapX: Float,
    rowGap: Float,
    keyH: Float,
    pitchY: Float,
    row0Y: Float,
    row1Y: Float,
    row2Y: Float,
    row3Y: Float
): LayoutSnapshot = {
    let trackpad = cellGet(eng.leIsTrackpadActive);
    let role = cellGet(eng.leReturnRole);
    let usableW = w - outerX * 2.0 - gapX * 4.0;
    let sideW = floor(usableW * 0.175);
    let midW = (usableW - sideW * 2.0) / 3.0;
    let col0X = outerX;
    let col1X = col0X + sideW + gapX;
    let col2X = col1X + midW + gapX;
    let col3X = col2X + midW + gapX;
    let col4X = col3X + midW + gapX;
    let midPitchX = midW + gapX;

    let sidebarFrame = cgRect(col0X, row0Y, sideW, row2Y + keyH - row0Y);
    let specs: Vec IOSKeySpec = vecWithCap(15);

    let pushT9 = (digit: Int, label: String, sub: String, x: Float, y: Float) -> {
        let subOpt = if (trackpad || strLen(sub) == 0) None else Some(sub);
        vecPush(
            specs,
            makeKeySpec(
                "T9_" + intToStr(digit),
                KeyT9(digit),
                cgRect(x, y, midW, keyH),
                if (trackpad) "" else label,
                None,
                subOpt,
                None,
                None,
                false,
                None,
                false
            )
        )
    };

    pushT9(49, "分词", "", col1X, row0Y);
    pushT9(50, "ABC", "2", col2X, row0Y);
    pushT9(51, "DEF", "3", col3X, row0Y);
    pushT9(52, "GHI", "4", col1X, row1Y);
    pushT9(53, "JKL", "5", col2X, row1Y);
    pushT9(54, "MNO", "6", col3X, row1Y);
    pushT9(55, "PQRS", "7", col1X, row2Y);
    pushT9(56, "TUV", "8", col2X, row2Y);
    pushT9(57, "WXYZ", "9", col3X, row2Y);

    vecPush(
        specs,
        makeKeySpec(
            "K_backspace",
            KeyBackspace,
            cgRect(col4X, row0Y, sideW, keyH),
            "",
            None,
            None,
            None,
            if (trackpad) None else Some("delete.backward"),
            false,
            None,
            false
        )
    );
    vecPush(
        specs,
        keySpecSimple(
            "T9_clear",
            KeyT9Clear,
            cgRect(col4X, row1Y, sideW, keyH),
            if (trackpad) "" else "重输"
        )
    );

    let useBlue = returnRoleIsBlueProminent(role);
    vecPush(
        specs,
        makeKeySpec(
            "B_return",
            KeyReturn,
            cgRect(col4X, row2Y, sideW, keyH * 2.0 + rowGap),
            if (trackpad) "" else (if (useBlue) returnRoleTitle(role) else ""),
            None,
            None,
            None,
            if (trackpad) None else (if (useBlue) None else Some("return.left")),
            useBlue,
            None,
            false
        )
    );

    vecPush(
        specs,
        keySpecSimple(
            "B_plane",
            KeyPlaneSwitch { targetPlane: PlaneNumbers, switchLabel: "123" },
            cgRect(col0X, row3Y, sideW, keyH),
            if (trackpad) "" else "123"
        )
    );

    if (cellGet(eng.leShowInlineGlobeKey)) {
        vecPush(
            specs,
            makeKeySpec(
                "B_globe",
                KeyGlobe,
                cgRect(col1X, row3Y, midW, keyH),
                "",
                None,
                None,
                None,
                if (trackpad) None else Some("globe"),
                false,
                None,
                false
            )
        )
    } else {
        vecPush(
            specs,
            makeKeySpec(
                "B_mode",
                KeyModeToggle,
                cgRect(col1X, row3Y, midW, keyH),
                if (trackpad) "" else "中",
                if (trackpad) None else Some("/英"),
                None,
                None,
                None,
                false,
                None,
                false
            )
        )
    };

    vecPush(
        specs,
        makeKeySpec(
            "B_space",
            KeySpace,
            cgRect(col2X, row3Y, midW * 2.0 + gapX, keyH),
            "",
            None,
            layoutSpaceCornerTag(eng),
            None,
            None,
            false,
            None,
            false
        )
    );

    let k1MidX = col1X + midW * 0.5;
    let k1MidY = row0Y + keyH * 0.5;
    LayoutSnapshot {
        lsBounds: cgRect(0.0, 0.0, w, h),
        lsKeys: specs,
        lsCenters52: makeFilledFloatVec(52, 0.0),
        lsOriginX: k1MidX,
        lsOriginY: k1MidY,
        lsPitchX: midPitchX,
        lsPitchY: pitchY,
        lsBottomRowMinY: row3Y,
        lsIsT9Layout: true,
        lsT9SidebarFrame: sidebarFrame,
        lsT9Centers16: canonicalT9Centers16(),
        lsT9OriginX: k1MidX,
        lsT9OriginY: k1MidY,
        lsT9PitchX: midPitchX,
        lsT9PitchY: pitchY,
    }
}

pub def computeLayout(eng: IOSKeyboardLayoutEngine, size: CGSize): LayoutSnapshot = {
    let w = maxFloat(280.0, size.width);
    let isLandscape = w > 540.0;
    let maxReasonableH = if (isLandscape) 220.0 else 225.0;
    let h = minFloat(maxFloat(168.0, size.height), maxReasonableH);

    let outerX = if (isLandscape) 8.0 else roundHalfAway(w * (20.0 / 1320.0) * 3.0) / 3.0;
    let gapX = if (isLandscape) 6.5 else roundHalfAway(w * (18.0 / 1320.0) * 3.0) / 3.0;
    let topPad = if (isLandscape) 2.0 else 0.0;
    let bottomPad = if (isLandscape) 4.5 else 7.0;
    let rowGap = if (isLandscape) 8.0 else 11.0;

    let usableH = h - topPad - bottomPad - rowGap * 3.0;
    let keyH = maxFloat(34.0, floor(usableH / 4.0));
    let pitchY = keyH + rowGap;

    let stdKeyW = (w - outerX * 2.0 - gapX * 9.0) / 10.0;
    let pitchX = stdKeyW + gapX;

    let row0Y = topPad;
    let row1Y = topPad + pitchY;
    let row2Y = topPad + pitchY * 2.0;
    let row3Y = topPad + pitchY * 3.0;

    if (layoutIsT9PinyinActive(eng)) {
        computeT9Layout(eng, w, h, outerX, gapX, rowGap, keyH, pitchY, row0Y, row1Y, row2Y, row3Y)
    } else {
        let row1StartX = outerX + pitchX * 0.5;
        let colRow1X = (i: Int) -> row1StartX + intToFloat(i) * pitchX;
        let specs: Vec IOSKeySpec = vecWithCap(33);
        let plane = cellGet(eng.lePlane);
        let ascii = cellGet(eng.leAsciiMode);
        let trackpad = cellGet(eng.leIsTrackpadActive);
        let swipeOn = cellGet(eng.leSwipeUpInputEnabled);

        match plane {
            PlaneLetters -> {
                let row0 = "qwertyuiop";
                let c0 = cellNew(0);
                while (cellGet(c0) < 10) {
                    let c = cellGet(c0);
                    let b = strByteAt(row0, c);
                    let x = outerX + intToFloat(c) * pitchX;
                    let swipeSym = if (trackpad || !swipeOn) None else swipeUpSymbolForLetter(b, ascii);
                    vecPush(
                        specs,
                        makeKeySpec(
                            "L_" + intToStr(b),
                            KeyLetter(b),
                            cgRect(x, row0Y, stdKeyW, keyH),
                            formatLetter(eng, b),
                            None,
                            None,
                            formatWubiRadicals(eng, b),
                            None,
                            false,
                            swipeSym,
                            false
                        )
                    );
                    cellSet(c0, c + 1)
                };

                let row1 = "asdfghjkl";
                let c1 = cellNew(0);
                while (cellGet(c1) < 9) {
                    let c = cellGet(c1);
                    let b = strByteAt(row1, c);
                    let swipeSym = if (trackpad || !swipeOn) None else swipeUpSymbolForLetter(b, ascii);
                    vecPush(
                        specs,
                        makeKeySpec(
                            "L_" + intToStr(b),
                            KeyLetter(b),
                            cgRect(colRow1X(c), row1Y, stdKeyW, keyH),
                            formatLetter(eng, b),
                            None,
                            None,
                            formatWubiRadicals(eng, b),
                            None,
                            false,
                            swipeSym,
                            false
                        )
                    );
                    cellSet(c1, c + 1)
                };

                let sideKeyW = stdKeyW * 1.342;
                let shiftSym = match cellGet(eng.leShiftState) {
                    ShiftLower -> "shift",
                    ShiftUpperOnce -> "shift.fill",
                    ShiftCapsLocked -> "capslock.fill",
                };
                vecPush(
                    specs,
                    makeKeySpec(
                        "K_shift",
                        KeyShift,
                        cgRect(outerX, row2Y, sideKeyW, keyH),
                        "",
                        None,
                        None,
                        None,
                        if (trackpad) None else Some(shiftSym),
                        false,
                        None,
                        false
                    )
                );

                let row2 = "zxcvbnm";
                let c2 = cellNew(0);
                while (cellGet(c2) < 7) {
                    let c = cellGet(c2);
                    let b = strByteAt(row2, c);
                    let swipeSym = if (trackpad || !swipeOn) None else swipeUpSymbolForLetter(b, ascii);
                    vecPush(
                        specs,
                        makeKeySpec(
                            "L_" + intToStr(b),
                            KeyLetter(b),
                            cgRect(colRow1X(c + 1), row2Y, stdKeyW, keyH),
                            formatLetter(eng, b),
                            None,
                            None,
                            formatWubiRadicals(eng, b),
                            None,
                            false,
                            swipeSym,
                            false
                        )
                    );
                    cellSet(c2, c + 1)
                };

                vecPush(
                    specs,
                    makeKeySpec(
                        "K_backspace",
                        KeyBackspace,
                        cgRect(w - outerX - sideKeyW, row2Y, sideKeyW, keyH),
                        "",
                        None,
                        None,
                        None,
                        if (trackpad) None else Some("delete.backward"),
                        false,
                        None,
                        false
                    )
                )
            },
            PlaneNumbers -> {
                let r0 = vecFrom10("1", "2", "3", "4", "5", "6", "7", "8", "9", "0");
                appendTenRow(r0, 0, row0Y, outerX, pitchX, stdKeyW, keyH, trackpad, specs);

                let r1 =
                    if (ascii) vecFrom10("-", "/", ":", ";", "(", ")", "$", "&", "@", "\"")
                    else vecFrom10("-", "/", "：", "；", "（", "）", "￥", "@", "“", "”");
                appendTenRow(r1, 1, row1Y, outerX, pitchX, stdKeyW, keyH, trackpad, specs);

                let sideKeyW = stdKeyW * 1.342;
                vecPush(
                    specs,
                    keySpecSimple(
                        "P_symbols",
                        KeyPlaneSwitch { targetPlane: PlaneSymbols, switchLabel: "#+=" },
                        cgRect(outerX, row2Y, sideKeyW, keyH),
                        if (trackpad) "" else "#+="
                    )
                );

                let puncMid =
                    if (ascii) vecFrom5(".", ",", "?", "!", "'")
                    else vecFrom6("。", "，", "、", "？", "！", ".");
                appendSpanSymbols(puncMid, row2Y, colRow1X(1), colRow1X(7) + stdKeyW, gapX, keyH, trackpad, specs);

                vecPush(
                    specs,
                    makeKeySpec(
                        "K_backspace",
                        KeyBackspace,
                        cgRect(w - outerX - sideKeyW, row2Y, sideKeyW, keyH),
                        "",
                        None,
                        None,
                        None,
                        if (trackpad) None else Some("delete.backward"),
                        false,
                        None,
                        false
                    )
                )
            },
            PlaneSymbols -> {
                let r0 = vecFrom10("[", "]", "{", "}", "#", "%", "^", "*", "+", "=");
                appendTenRow(r0, 0, row0Y, outerX, pitchX, stdKeyW, keyH, trackpad, specs);

                let r1 =
                    if (ascii) vecFrom10("_", "\\", "|", "~", "<", ">", "€", "£", "¥", "•")
                    else vecFrom10("——", "\\", "|", "～", "《", "》", "【", "】", "…", "·");
                appendTenRow(r1, 1, row1Y, outerX, pitchX, stdKeyW, keyH, trackpad, specs);

                let sideKeyW = stdKeyW * 1.342;
                vecPush(
                    specs,
                    keySpecSimple(
                        "P_numbers",
                        KeyPlaneSwitch { targetPlane: PlaneNumbers, switchLabel: "123" },
                        cgRect(outerX, row2Y, sideKeyW, keyH),
                        if (trackpad) "" else "123"
                    )
                );

                let symMid = vecFrom5("…", "‘", "’", "〈", "〉");
                appendSpanSymbols(symMid, row2Y, colRow1X(1), colRow1X(7) + stdKeyW, gapX, keyH, trackpad, specs);

                vecPush(
                    specs,
                    makeKeySpec(
                        "K_backspace",
                        KeyBackspace,
                        cgRect(w - outerX - sideKeyW, row2Y, sideKeyW, keyH),
                        "",
                        None,
                        None,
                        None,
                        if (trackpad) None else Some("delete.backward"),
                        false,
                        None,
                        false
                    )
                )
            },
        };

        if (cellGet(eng.leSpaceCommaKeyEnabled)) {
            appendCommaBottomRow(eng, w, outerX, gapX, pitchX, stdKeyW, keyH, row3Y, specs)
        } else {
            let leftPairSpan = (colRow1X(1) + stdKeyW) - outerX;
            let leftEachW = (leftPairSpan - gapX) * 0.5;
            let targetPlane = if (plane == PlaneLetters) PlaneNumbers else PlaneLetters;
            let planeLabel = if (plane == PlaneLetters) "123" else "ABC";

            vecPush(
                specs,
                keySpecSimple(
                    "B_plane",
                    KeyPlaneSwitch { targetPlane: targetPlane, switchLabel: planeLabel },
                    cgRect(outerX, row3Y, leftEachW, keyH),
                    if (trackpad) "" else planeLabel
                )
            );

            let secondLeftX = outerX + leftEachW + gapX;
            if (cellGet(eng.leShowInlineGlobeKey)) {
                vecPush(
                    specs,
                    makeKeySpec(
                        "B_globe",
                        KeyGlobe,
                        cgRect(secondLeftX, row3Y, leftEachW, keyH),
                        "",
                        None,
                        None,
                        None,
                        if (trackpad) None else Some("globe"),
                        false,
                        None,
                        false
                    )
                )
            } else {
                vecPush(
                    specs,
                    makeKeySpec(
                        "B_mode",
                        KeyModeToggle,
                        cgRect(secondLeftX, row3Y, leftEachW, keyH),
                        if (trackpad) "" else (if (ascii) "EN" else "中"),
                        if (trackpad) None else Some(if (ascii) "/中" else "/英"),
                        None,
                        None,
                        None,
                        false,
                        None,
                        false
                    )
                )
            };

            let spaceMinX = colRow1X(2);
            let spaceMaxX = colRow1X(6) + stdKeyW;
            vecPush(
                specs,
                makeKeySpec(
                    "B_space",
                    KeySpace,
                    cgRect(spaceMinX, row3Y, spaceMaxX - spaceMinX, keyH),
                    "",
                    None,
                    layoutSpaceCornerTag(eng),
                    None,
                    None,
                    false,
                    None,
                    false
                )
            );

            let returnMinX = colRow1X(7);
            let returnMaxX = w - outerX;
            let role = cellGet(eng.leReturnRole);
            let useBlue = returnRoleIsBlueProminent(role);
            vecPush(
                specs,
                makeKeySpec(
                    "B_return",
                    KeyReturn,
                    cgRect(returnMinX, row3Y, returnMaxX - returnMinX, keyH),
                    if (trackpad) "" else (if (useBlue) returnRoleTitle(role) else ""),
                    None,
                    None,
                    None,
                    if (trackpad) None else (if (useBlue) None else Some("return.left")),
                    useBlue,
                    None,
                    false
                )
            )
        };

        let qMidX = outerX + stdKeyW * 0.5;
        let qMidY = row0Y + keyH * 0.5;
        let centersArr = arrayNew(52, 0.0);
        let fillRowCenters = (rowStr: String, xBias: Float, yRow: Float) -> {
            let len = strLen(rowStr);
            let i = cellNew(0);
            while (cellGet(i) < len) {
                let c = cellGet(i);
                let idx = strByteAt(rowStr, c) - 97;
                arraySet(centersArr, idx * 2, intToFloat(c) + xBias);
                arraySet(centersArr, idx * 2 + 1, yRow);
                cellSet(i, c + 1)
            }
        };
        fillRowCenters("qwertyuiop", 0.0, 0.0);
        fillRowCenters("asdfghjkl", 0.5, 1.0);
        fillRowCenters("zxcvbnm", 1.5, 2.0);
        let centers52: Vec Float = vecWithCap(52);
        let k = cellNew(0);
        while (cellGet(k) < 52) {
            vecPush(centers52, arrayGet(centersArr, cellGet(k)));
            cellSet(k, cellGet(k) + 1)
        };

        LayoutSnapshot {
            lsBounds: cgRect(0.0, 0.0, w, h),
            lsKeys: specs,
            lsCenters52: centers52,
            lsOriginX: qMidX,
            lsOriginY: qMidY,
            lsPitchX: pitchX,
            lsPitchY: pitchY,
            lsBottomRowMinY: row3Y,
            lsIsT9Layout: false,
            lsT9SidebarFrame: cgRect(0.0, 0.0, 0.0, 0.0),
            lsT9Centers16: canonicalT9Centers16(),
            lsT9OriginX: 0.0,
            lsT9OriginY: 0.0,
            lsT9PitchX: 1.0,
            lsT9PitchY: 1.0,
        }
    }
}

// ============================================================================
// Compensated Letter Point & Dynamic Voronoi Hit-Testing
// ============================================================================

pub def compensatedLetterPoint(point: CGPoint, snap: LayoutSnapshot): CGPoint = {
    let row0MidY = snap.lsOriginY;
    if (point.y > row0MidY && point.y < snap.lsBottomRowMinY - 5.0) {
        cgPoint(point.x, point.y - ergonomicThumbYBias())
    } else {
        point
    }
}

def anyPriorNonNeutral(priors: Vec Int, expectedLen: Int): Bool =
    if (vecLen(priors) != expectedLen) false
    else {
        let i = cellNew(0);
        let found = cellNew(false);
        while (cellGet(i) < expectedLen && !cellGet(found)) {
            if (vecGetOr(priors, cellGet(i), 100) != 100) cellSet(found, true) else ();
            cellSet(i, cellGet(i) + 1)
        };
        cellGet(found)
    }

def anyTouchOffsetNonZero(offsets: Vec Float, expectedLen: Int): Bool =
    if (vecLen(offsets) != expectedLen) false
    else {
        let i = cellNew(0);
        let found = cellNew(false);
        while (cellGet(i) < expectedLen && !cellGet(found)) {
            if (abs(vecGetOr(offsets, cellGet(i), 0.0)) > 0.0001) cellSet(found, true) else ();
            cellSet(i, cellGet(i) + 1)
        };
        cellGet(found)
    }

def isCharacterKeyKind(kind: IOSKeyKind): Bool =
    match kind {
        KeyLetter(_) -> true,
        KeyT9(_) -> true,
        KeySymbol(_) -> true,
        _ -> false,
    }

pub def hitTestFull(
    point: CGPoint,
    snap: LayoutSnapshot,
    validNextMask: Int,
    nextKeyPriors: Vec Int,
    touchOffsets: Vec Float,
    t9ValidNextMask: Int,
    t9NextKeyPriors: Vec Int,
    t9TouchOffsets: Vec Float
): Option IOSKeySpec =
    if (!rectContainsPoint(rectInset(snap.lsBounds, -18.0, -28.0), point)) None
    else {
        let keys = snap.lsKeys;
        let keyCount = vecLen(keys);
        let dummyKey = keySpecSimple("", KeySpace, cgRect(0.0, 0.0, 0.0, 0.0), "");

        // 1. Functional keys checked against unbiased `point` first
        let funcHit: Cell (Option IOSKeySpec) = cellNew(None);
        let fi = cellNew(0);
        while (cellGet(fi) < keyCount && match cellGet(funcHit) { None -> true, Some(_) -> false }) {
            let k = vecGetOr(keys, cellGet(fi), dummyKey);
            if (!isCharacterKeyKind(k.ksKind) && rectContainsPoint(k.ksFrame, point)) {
                cellSet(funcHit, Some(k))
            } else ();
            cellSet(fi, cellGet(fi) + 1)
        };

        match cellGet(funcHit) {
            Some(fk) -> Some(fk),
            None -> {
                // 2. Apply ergonomic upward compensation strictly inside the 3 letter/symbol rows
                let qPt = compensatedLetterPoint(point, snap);

                let hasMaskWeights =
                    if (snap.lsIsT9Layout) (t9ValidNextMask != 0xFF && t9ValidNextMask != 0)
                    else (validNextMask != 0x03FF_FFFF && validNextMask != 0);
                let hasNeuralPriors =
                    if (snap.lsIsT9Layout) anyPriorNonNeutral(t9NextKeyPriors, 8)
                    else anyPriorNonNeutral(nextKeyPriors, 26);
                let hasTouchOffsets =
                    if (snap.lsIsT9Layout) anyTouchOffsetNonZero(t9TouchOffsets, 16)
                    else anyTouchOffsetNonZero(touchOffsets, 52);
                let hasDynamicWeights = hasMaskWeights || hasNeuralPriors || hasTouchOffsets;

                let personalShift = (ascii: Int) ->
                    if (!hasTouchOffsets || ascii < 97 || ascii > 122) (0.0, 0.0)
                    else {
                        let idx = ascii - 97;
                        let dx = clampFloat(vecGetOr(touchOffsets, idx * 2, 0.0), -0.20, 0.20) * snap.lsPitchX;
                        let dy = clampFloat(vecGetOr(touchOffsets, idx * 2 + 1, 0.0), -0.20, 0.20) * snap.lsPitchY;
                        (dx, dy)
                    };

                let personalT9Shift = (digit: Int) ->
                    if (!hasTouchOffsets || digit < 50 || digit > 57) (0.0, 0.0)
                    else {
                        let idx = digit - 50;
                        let dx = clampFloat(vecGetOr(t9TouchOffsets, idx * 2, 0.0), -0.20, 0.20) * snap.lsT9PitchX;
                        let dy = clampFloat(vecGetOr(t9TouchOffsets, idx * 2 + 1, 0.0), -0.20, 0.20) * snap.lsT9PitchY;
                        (dx, dy)
                    };

                let directOrCoreHit: Cell (Option IOSKeySpec) = cellNew(None);
                if (!hasDynamicWeights) {
                    let di = cellNew(0);
                    while (cellGet(di) < keyCount && match cellGet(directOrCoreHit) { None -> true, Some(_) -> false }) {
                        let k = vecGetOr(keys, cellGet(di), dummyKey);
                        if (rectContainsPoint(k.ksFrame, qPt)) {
                            cellSet(directOrCoreHit, Some(k))
                        } else ();
                        cellSet(di, cellGet(di) + 1)
                    }
                } else {
                    // Sacred Keycap Core
                    let ci = cellNew(0);
                    while (cellGet(ci) < keyCount && match cellGet(directOrCoreHit) { None -> true, Some(_) -> false }) {
                        let k = vecGetOr(keys, cellGet(ci), dummyKey);
                        match k.ksKind {
                            KeyLetter(ascii) -> {
                                let (px, py) = personalShift(ascii);
                                let core = rectInset(rectOffset(k.ksFrame, px * 0.5, py * 0.5), 3.0, 2.6);
                                if (rectContainsPoint(core, qPt)) cellSet(directOrCoreHit, Some(k)) else ()
                            },
                            KeyT9(digit) -> {
                                let (px, py) = personalT9Shift(digit);
                                let core = rectInset(rectOffset(k.ksFrame, px * 0.5, py * 0.5), 4.5, 2.8);
                                if (rectContainsPoint(core, qPt)) cellSet(directOrCoreHit, Some(k)) else ()
                            },
                            KeySymbol(_) ->
                                if (rectContainsPoint(k.ksFrame, qPt)) cellSet(directOrCoreHit, Some(k)) else (),
                            _ -> (),
                        };
                        cellSet(ci, cellGet(ci) + 1)
                    }
                };

                match cellGet(directOrCoreHit) {
                    Some(ck) -> Some(ck),
                    None -> {
                        // 3. C⁰-continuous signed distance Voronoi evaluation across all keys
                        let best: Cell (Option IOSKeySpec) = cellNew(None);
                        let bestScore = cellNew(1.0e18);
                        let maxLetterBottomY = snap.lsBottomRowMinY - 6.0;

                        let vi = cellNew(0);
                        while (cellGet(vi) < keyCount) {
                            let k = vecGetOr(keys, cellGet(vi), dummyKey);
                            let effRect = cellNew(k.ksFrame);
                            let deadKeyPenalty = cellNew(0.0);
                            let evalPt = cellNew(qPt);

                            match k.ksKind {
                                KeySpace -> {
                                    cellSet(evalPt, point);
                                    cellSet(
                                        effRect,
                                        cgRect(
                                            k.ksFrame.origin.x - 2.2,
                                            k.ksFrame.origin.y - 4.5,
                                            k.ksFrame.size.width + 4.4,
                                            k.ksFrame.size.height + 14.5
                                        )
                                    )
                                },
                                KeyPlaneSwitch { targetPlane: _, switchLabel: lbl } ->
                                    if (k.ksFrame.origin.y >= snap.lsBottomRowMinY - 1.0 && lbl != "#+=") {
                                        cellSet(evalPt, point);
                                        cellSet(
                                            effRect,
                                            cgRect(
                                                k.ksFrame.origin.x - 2.0,
                                                k.ksFrame.origin.y - 3.0,
                                                k.ksFrame.size.width + 2.0,
                                                k.ksFrame.size.height + 12.0
                                            )
                                        )
                                    } else (),
                                KeySymbol(_) ->
                                    if (k.ksFrame.origin.y >= snap.lsBottomRowMinY - 1.0) {
                                        cellSet(evalPt, point);
                                        cellSet(
                                            effRect,
                                            cgRect(
                                                k.ksFrame.origin.x,
                                                k.ksFrame.origin.y - 3.0,
                                                k.ksFrame.size.width,
                                                k.ksFrame.size.height + 12.0
                                            )
                                        )
                                    } else (),
                                KeyModeToggle -> {
                                    cellSet(evalPt, point);
                                    cellSet(
                                        effRect,
                                        cgRect(
                                            k.ksFrame.origin.x,
                                            k.ksFrame.origin.y - 3.0,
                                            k.ksFrame.size.width,
                                            k.ksFrame.size.height + 12.0
                                        )
                                    )
                                },
                                KeyGlobe -> {
                                    cellSet(evalPt, point);
                                    cellSet(
                                        effRect,
                                        cgRect(
                                            k.ksFrame.origin.x,
                                            k.ksFrame.origin.y - 3.0,
                                            k.ksFrame.size.width,
                                            k.ksFrame.size.height + 12.0
                                        )
                                    )
                                },
                                KeyReturn -> {
                                    cellSet(evalPt, point);
                                    cellSet(
                                        effRect,
                                        cgRect(
                                            k.ksFrame.origin.x,
                                            k.ksFrame.origin.y - 3.0,
                                            k.ksFrame.size.width,
                                            k.ksFrame.size.height + 12.0
                                        )
                                    )
                                },
                                KeyShift -> cellSet(evalPt, point),
                                KeyBackspace -> cellSet(evalPt, point),
                                KeyT9Clear -> cellSet(evalPt, point),
                                KeyT9(digit) ->
                                    if (hasDynamicWeights && digit >= 50 && digit <= 57) {
                                        let (px, py) = personalT9Shift(digit);
                                        let shifted = rectOffset(cellGet(effRect), px, py);
                                        let idx = digit - 50;
                                        let bit = 1 << idx;
                                        let pVal =
                                            if (vecLen(t9NextKeyPriors) == 8) vecGetOr(t9NextKeyPriors, idx, 100)
                                            else if ((t9ValidNextMask & bit) != 0) 100
                                            else 0;
                                        if ((hasMaskWeights && (t9ValidNextMask & bit) == 0) || pVal == 0) {
                                            cellSet(effRect, rectInset(shifted, 3.2, 2.4));
                                            cellSet(deadKeyPenalty, 4.2)
                                        } else {
                                            let bias = intToFloat(pVal - 100) / 25.0;
                                            let expX =
                                                if (hasMaskWeights) clampFloat(3.6 + bias * 1.0, 1.0, 5.2)
                                                else clampFloat(bias * 1.3, -1.5, 3.4);
                                            let expY =
                                                if (hasMaskWeights) clampFloat(2.8 + bias * 0.7, 0.8, 3.8)
                                                else clampFloat(bias * 0.9, -1.0, 2.4);
                                            cellSet(deadKeyPenalty, (0.0 - bias) * (if (hasMaskWeights) 1.05 else 0.8));
                                            let expanded = rectInset(shifted, 0.0 - expX, 0.0 - expY);
                                            if (rectMaxY(expanded) > maxLetterBottomY) {
                                                let clampedH = maxFloat(k.ksFrame.size.height, maxLetterBottomY - expanded.origin.y);
                                                cellSet(effRect, cgRect(expanded.origin.x, expanded.origin.y, expanded.size.width, clampedH))
                                            } else {
                                                cellSet(effRect, expanded)
                                            }
                                        }
                                    } else (),
                                KeyLetter(ascii) ->
                                    if (hasDynamicWeights && ascii >= 97 && ascii <= 122) {
                                        let (px, py) = personalShift(ascii);
                                        let shifted = rectOffset(cellGet(effRect), px, py);
                                        let idx = ascii - 97;
                                        let bit = 1 << idx;
                                        let pVal =
                                            if (vecLen(nextKeyPriors) == 26) vecGetOr(nextKeyPriors, idx, 100)
                                            else if ((validNextMask & bit) != 0) 100
                                            else 0;
                                        if ((hasMaskWeights && (validNextMask & bit) == 0) || pVal == 0) {
                                            cellSet(effRect, rectInset(shifted, 2.8, 2.2));
                                            cellSet(deadKeyPenalty, 4.2)
                                        } else {
                                            let bias = intToFloat(pVal - 100) / 25.0;
                                            let (expX, expY, pen) =
                                                if (!hasMaskWeights) {
                                                    (
                                                        clampFloat(bias * 1.45, -1.6, 3.8),
                                                        clampFloat(bias * 0.95, -1.0, 2.4),
                                                        (0.0 - bias) * 0.85
                                                    )
                                                } else {
                                                    (
                                                        clampFloat(4.8 + bias * 1.65, 0.0, 6.8),
                                                        clampFloat(3.2 + bias * 0.75, 0.6, 4.0),
                                                        (0.0 - bias) * 1.15
                                                    )
                                                };
                                            cellSet(deadKeyPenalty, pen);
                                            let expanded = rectInset(shifted, 0.0 - expX, 0.0 - expY);
                                            if (rectMaxY(expanded) > maxLetterBottomY) {
                                                let clampedH = maxFloat(k.ksFrame.size.height, maxLetterBottomY - expanded.origin.y);
                                                cellSet(effRect, cgRect(expanded.origin.x, expanded.origin.y, expanded.size.width, clampedH))
                                            } else {
                                                cellSet(effRect, expanded)
                                            }
                                        }
                                    } else (),
                            };

                            let er = cellGet(effRect);
                            let ep = cellGet(evalPt);
                            let erMaxX = rectMaxX(er);
                            let erMaxY = rectMaxY(er);
                            let dx = maxFloat(er.origin.x - ep.x, maxFloat(0.0, ep.x - erMaxX));
                            let dy = maxFloat(er.origin.y - ep.y, maxFloat(0.0, ep.y - erMaxY));
                            let score =
                                if (dx == 0.0 && dy == 0.0) {
                                    let innerDepth = minFloat(
                                        minFloat(ep.x - er.origin.x, erMaxX - ep.x),
                                        minFloat(ep.y - er.origin.y, erMaxY - ep.y)
                                    );
                                    (0.0 - innerDepth) + cellGet(deadKeyPenalty)
                                } else {
                                    hypot2(dx, dy) + cellGet(deadKeyPenalty)
                                };

                            if (score < cellGet(bestScore)) {
                                cellSet(bestScore, score);
                                cellSet(best, Some(k))
                            } else ();

                            cellSet(vi, cellGet(vi) + 1)
                        };
                        cellGet(best)
                    },
                }
            },
        }
    }

/// Convenience `hitTest` with default neutral weights.
pub def hitTest(point: CGPoint, snap: LayoutSnapshot): Option IOSKeySpec =
    hitTestFull(point, snap, 0x03FF_FFFF, vecNew(), vecNew(), 0xFF, vecNew(), vecNew())

/// Convenience `hitTest` with `validNextMask` only.
pub def hitTestWithMask(point: CGPoint, snap: LayoutSnapshot, validNextMask: Int): Option IOSKeySpec =
    hitTestFull(point, snap, validNextMask, vecNew(), vecNew(), 0xFF, vecNew(), vecNew())
