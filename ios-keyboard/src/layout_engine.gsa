/// 1:1 port of `iOS/Shared/IOSKeyboardLayoutEngine.swift` (1,247 lines)
/// plus `IOSSwipeUp` (`iOS/Shared/IOSKeyboardGesturesAndEditing.swift` lines 4–50).

use std.option.{Option, Some, None}
use std.vec.{Vec, vecNew, vecWithCap, vecLen, vecPush, vecGetOr}
use std.str.{intToStr}
use std.math.{abs, floor, sqrt}
use std.generic
use juxu_shared.{
    CGPoint, CGSize, CGRect, cgPoint, cgSize, cgRect,
    rectContainsPoint, rectInset, rectMaxX, rectMaxY,
    utf8ToScalars,
}

// ============================================================================
// Math & Geometry Helpers
// ============================================================================

def minFloat(a: Float, b: Float): Float = if (a < b) a else b
def maxFloat(a: Float, b: Float): Float = if (a > b) a else b
def clampFloat(v: Float, lo: Float, hi: Float): Float = maxFloat(lo, minFloat(hi, v))

def roundHalfAway(x: Float): Float =
    if (x >= 0.0) floor(x + 0.5) else 0.0 - floor(0.0 - x + 0.5)

def hypot2(dx: Float, dy: Float): Float =
    sqrt(dx * dx + dy * dy)

pub def rectOffset(r: CGRect, dx: Float, dy: Float): CGRect =
    cgRect(r.origin.x + dx, r.origin.y + dy, r.size.width, r.size.height)

pub def rectEq(a: CGRect, b: CGRect): Bool =
    a.origin.x == b.origin.x
        && a.origin.y == b.origin.y
        && a.size.width == b.size.width
        && a.size.height == b.size.height

pub def sizeEq(a: CGSize, b: CGSize): Bool =
    a.width == b.width && a.height == b.height

pub def optStrEq(a: Option String, b: Option String): Bool =
    match (a, b) {
        (None, None) -> true,
        (Some(sa), Some(sb)) -> sa == sb,
        _ -> false,
    }

pub def optBoolEq(a: Option Bool, b: Option Bool): Bool =
    match (a, b) {
        (None, None) -> true,
        (Some(ba), Some(bb)) -> ba == bb,
        _ -> false,
    }

// ============================================================================
// Core Algebraic Types (`IOSKeyPlane`, `IOSShiftState`, `IOSReturnKeyRole`, `IOSKeyKind`, `IOSKeySpec`)
// ============================================================================

pub data IOSKeyPlane : Eq {
    PlaneLetters,
    PlaneNumbers,
    PlaneSymbols,
}

pub data IOSShiftState : Eq {
    ShiftLower,
    ShiftUpperOnce,
    ShiftCapsLocked,
}

pub def shiftIsUppercase(s: IOSShiftState): Bool =
    s != ShiftLower

pub data IOSReturnKeyRole : Eq {
    ReturnNormal,
    ReturnGo,
    ReturnSearch,
    ReturnSend,
    ReturnNext,
    ReturnDone,
    ReturnJoin,
    ReturnContinue,
}

pub def returnRoleTitle(r: IOSReturnKeyRole): String =
    match r {
        ReturnNormal -> "",
        ReturnGo -> "前往",
        ReturnSearch -> "搜索",
        ReturnSend -> "发送",
        ReturnNext -> "下一项",
        ReturnDone -> "完成",
        ReturnJoin -> "加入",
        ReturnContinue -> "继续",
    }

pub def returnRoleIsBlueProminent(r: IOSReturnKeyRole): Bool =
    r != ReturnNormal

/// Map `UIReturnKeyType` (`NSInteger`) to `IOSReturnKeyRole` (`KeyboardViewController.mapReturnKeyType`).
pub def mapUIReturnKeyType(rawType: Int64): IOSReturnKeyRole = {
    let t = i64ToInt(rawType);
    if (t == 1) ReturnGo
    else if (t == 2 || t == 6 || t == 8) ReturnSearch
    else if (t == 3) ReturnJoin
    else if (t == 4) ReturnNext
    else if (t == 7) ReturnSend
    else if (t == 9) ReturnDone
    else if (t == 11) ReturnContinue
    else ReturnNormal
}

pub data IOSKeyKind : Eq {
    KeyLetter(Int),
    KeyT9(Int),
    KeyT9Clear,
    KeySymbol(String),
    KeyShift,
    KeyBackspace,
    KeyPlaneSwitch { targetPlane: IOSKeyPlane, switchLabel: String },
    KeyGlobe,
    KeyModeToggle,
    KeySpace,
    KeyReturn,
}

pub data IOSKeySpec {
    ksId: String,
    ksKind: IOSKeyKind,
    ksFrame: CGRect,
    ksPrimaryLabel: String,
    ksSecondaryInlineLabel: Option String,
    ksCornerSubscript: Option String,
    ksKeycapRadicals: Option String,
    ksSystemSymbol: Option String,
    ksIsBlueAccent: Bool,
    ksSwipeUpSymbol: Option String,
    ksUsesFunctionFill: Bool,
}

pub def makeKeySpec(
    id: String,
    kind: IOSKeyKind,
    frame: CGRect,
    primaryLabel: String,
    secondaryInlineLabel: Option String,
    cornerSubscript: Option String,
    keycapRadicals: Option String,
    systemSymbol: Option String,
    isBlueAccent: Bool,
    swipeUpSymbol: Option String,
    usesFunctionFill: Bool
): IOSKeySpec =
    IOSKeySpec {
        ksId: id,
        ksKind: kind,
        ksFrame: frame,
        ksPrimaryLabel: primaryLabel,
        ksSecondaryInlineLabel: secondaryInlineLabel,
        ksCornerSubscript: cornerSubscript,
        ksKeycapRadicals: keycapRadicals,
        ksSystemSymbol: systemSymbol,
        ksIsBlueAccent: isBlueAccent,
        ksSwipeUpSymbol: swipeUpSymbol,
        ksUsesFunctionFill: usesFunctionFill,
    }

pub def keySpecSimple(id: String, kind: IOSKeyKind, frame: CGRect, primaryLabel: String): IOSKeySpec =
    makeKeySpec(id, kind, frame, primaryLabel, None, None, None, None, false, None, false)

pub def keySpecEq(a: IOSKeySpec, b: IOSKeySpec): Bool =
    a.ksId == b.ksId
        && a.ksKind == b.ksKind
        && rectEq(a.ksFrame, b.ksFrame)
        && a.ksPrimaryLabel == b.ksPrimaryLabel
        && optStrEq(a.ksSecondaryInlineLabel, b.ksSecondaryInlineLabel)
        && optStrEq(a.ksCornerSubscript, b.ksCornerSubscript)
        && optStrEq(a.ksKeycapRadicals, b.ksKeycapRadicals)
        && optStrEq(a.ksSystemSymbol, b.ksSystemSymbol)
        && a.ksIsBlueAccent == b.ksIsBlueAccent
        && optStrEq(a.ksSwipeUpSymbol, b.ksSwipeUpSymbol)
        && a.ksUsesFunctionFill == b.ksUsesFunctionFill

pub instance Eq IOSKeySpec {
    def (==)(a: IOSKeySpec, b: IOSKeySpec): Bool = keySpecEq(a, b)
    def (!=)(a: IOSKeySpec, b: IOSKeySpec): Bool = !keySpecEq(a, b)
}

// ============================================================================
// IOSSwipeUp (`iOS/Shared/IOSKeyboardGesturesAndEditing.swift` lines 4–50)
// ============================================================================

/// Secondary character entered by swiping up on letter `a..z`.
pub def swipeUpSymbolForLetter(letter: Int, asciiMode: Bool): Option String =
    if (letter == 113) Some("1")       // q
    else if (letter == 119) Some("2")  // w
    else if (letter == 101) Some("3")  // e
    else if (letter == 114) Some("4")  // r
    else if (letter == 116) Some("5")  // t
    else if (letter == 121) Some("6")  // y
    else if (letter == 117) Some("7")  // u
    else if (letter == 105) Some("8")  // i
    else if (letter == 111) Some("9")  // o
    else if (letter == 112) Some("0")  // p
    else if (letter == 97) Some("-")   // a
    else if (letter == 115) Some("/")  // s
    else if (letter == 100) Some(if (asciiMode) ":" else "：")   // d
    else if (letter == 102) Some(if (asciiMode) ";" else "；")   // f
    else if (letter == 103) Some(if (asciiMode) "(" else "（")   // g
    else if (letter == 104) Some(if (asciiMode) ")" else "）")   // h
    else if (letter == 106) Some(if (asciiMode) "~" else "～")   // j
    else if (letter == 107) Some(if (asciiMode) "'" else "“")    // k
    else if (letter == 108) Some(if (asciiMode) "\"" else "”")   // l
    else if (letter == 122) Some("@")                            // z
    else if (letter == 120) Some(if (asciiMode) "_" else "·")    // x
    else if (letter == 99) Some("#")                             // c
    else if (letter == 118) Some(if (asciiMode) "&" else "`")    // v
    else if (letter == 98) Some(if (asciiMode) "?" else "？")    // b
    else if (letter == 110) Some(if (asciiMode) "!" else "！")    // n
    else if (letter == 109) Some(if (asciiMode) "..." else "…")  // m
    else None

pub def swipeUpArmDistance(keyHeight: Float, isComposing: Bool): Float =
    if (isComposing) maxFloat(35.0, keyHeight * 0.80)
    else maxFloat(26.0, keyHeight * 0.60)

pub def swipeUpIsActive(
    start: CGPoint,
    current: CGPoint,
    keyHeight: Float,
    wasActive: Bool,
    isComposing: Bool
): Bool = {
    let up = start.y - current.y;
    let threshold = swipeUpArmDistance(keyHeight, isComposing) * (if (wasActive) 0.6 else 1.0);
    let maxLateralRatio = if (isComposing) 0.42 else 0.55;
    up >= threshold && abs(current.x - start.x) <= up * maxLateralRatio
}

// ============================================================================
// Metrics & Constants
// ============================================================================

pub def keyCornerRadius(): Float = 7.8
pub def trayTopCornerRadius(): Float = 26.0
pub def candidateBarHeight(): Float = 53.0
pub def landscapeCandidateBarHeight(): Float = 40.0
pub def ergonomicThumbYBias(): Float = 2.6
pub def portraitTotalHeight(): Float = 273.0
pub def landscapeTotalHeight(): Float = 204.0

pub def targetTrayHeight(width: Float): Float =
    if (width > 540.0) landscapeTotalHeight() else portraitTotalHeight()

pub def targetRibbonHeight(width: Float): Float =
    if (width > 540.0) landscapeCandidateBarHeight() else candidateBarHeight()

def commaRowSideWidth(): Float = 1.85
def commaRowModeWidth(): Float = 1.15

def makeFilledIntVec(n: Int, val: Int): Vec Int = {
    let v: Vec Int = vecWithCap(n);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        vecPush(v, val);
        cellSet(i, cellGet(i) + 1)
    };
    v
}

def makeFilledFloatVec(n: Int, val: Float): Vec Float = {
    let v: Vec Float = vecWithCap(n);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        vecPush(v, val);
        cellSet(i, cellGet(i) + 1)
    };
    v
}

pub def canonicalT9Centers16(): Vec Float = {
    let v: Vec Float = vecWithCap(16);
    // 2: ABC (1, 0)
    vecPush(v, 1.0); vecPush(v, 0.0);
    // 3: DEF (2, 0)
    vecPush(v, 2.0); vecPush(v, 0.0);
    // 4: GHI (0, 1)
    vecPush(v, 0.0); vecPush(v, 1.0);
    // 5: JKL (1, 1)
    vecPush(v, 1.0); vecPush(v, 1.0);
    // 6: MNO (2, 1)
    vecPush(v, 2.0); vecPush(v, 1.0);
    // 7: PQRS (0, 2)
    vecPush(v, 0.0); vecPush(v, 2.0);
    // 8: TUV (1, 2)
    vecPush(v, 1.0); vecPush(v, 2.0);
    // 9: WXYZ (2, 2)
    vecPush(v, 2.0); vecPush(v, 2.0);
    v
}

// ============================================================================
// Cangjie & Wubi 86 / 98 / 06 Radical Tables
// ============================================================================

pub def cangjieRadicalTable(): Vec String = {
    let v: Vec String = vecWithCap(26);
    vecPush(v, "日"); vecPush(v, "月"); vecPush(v, "金"); vecPush(v, "木"); vecPush(v, "水");
    vecPush(v, "火"); vecPush(v, "土"); vecPush(v, "竹"); vecPush(v, "戈"); vecPush(v, "十");
    vecPush(v, "大"); vecPush(v, "中"); vecPush(v, "一"); vecPush(v, "弓"); vecPush(v, "人");
    vecPush(v, "心"); vecPush(v, "手"); vecPush(v, "口"); vecPush(v, "尸"); vecPush(v, "廿");
    vecPush(v, "山"); vecPush(v, "女"); vecPush(v, "田"); vecPush(v, "難"); vecPush(v, "卜");
    vecPush(v, "重");
    v
}

pub def cangjieRadicalForAscii(ascii: Int): Option String = {
    let idx =
        if (ascii >= 97 && ascii <= 122) ascii - 97
        else if (ascii >= 65 && ascii <= 90) ascii - 65
        else -1;
    if (idx < 0) None
    else Some(vecGetOr(cangjieRadicalTable(), idx, ""))
}

