/// Pixel-accurate iOS 26/27 virtual keyboard geometry & hit-testing (`IOSKeyboardLayoutEngine`).
/// Matches `main`'s exact portrait metrics:
/// - Total height: 273pt (53pt transparent candidate ribbon + 220pt 4-row keyboard)
/// - On 440pt width: outerX = 6.67pt, gapX = 6.00pt, stdKeyW = 37.27pt, keyH = 45.0pt, rowGap = 11.0pt, bottomPad = 7.0pt
/// - Row 1 (`a..l`) locked to `outerX + pitchX * 0.5`; Row 2 (`z..m`) locked to `colRow1X[1..7]` (`s..k`)
/// - Row 3 exact iOS 26 4-key grid: `[123]` | `[中/英]` | `[空格]` (white char fill) | `[换行]` (systemBlue accent)
/// - No duplicate globe key on Face ID devices (`needsInputModeSwitchKey == false`).

use std.option.{Option, Some, None}
use std.vec.{Vec, vecNew, vecLen, vecPush, vecGetOr}
use std.math.{floor}
use std.generic
use juxu_shared.{CGRect, CGPoint, cgRect, rectContainsPoint}

pub def portraitTotalHeight(): Float = 273.0
pub def ribbonHeight(): Float = 53.0
pub def keyAreaHeight(): Float = 220.0
pub def keyHeight(): Float = 45.0
pub def rowGap(): Float = 11.0
pub def keyGapX(): Float = 6.0
pub def keyCornerRadius(): Float = 7.8
pub def bottomCushion(): Float = 7.0
pub def t9SyllableRailWidth(): Float = 72.0

pub data KeyboardMode : Eq {
    ModeQwerty,
    ModeT9,
    ModeNumbers,
    ModeSymbols,
}

pub data KeyClass : Eq {
    CharClass,
    FuncClass,
}

pub data KeyAction : Eq {
    ActLetter(Int),
    ActDigitT9(Int),
    ActSymbol(String),
    ActShift,
    ActBackspace,
    ActSwitchMode(KeyboardMode),
    ActToggleAscii,
    ActGlobe,
    ActSpace,
    ActReturn,
}

pub data KeySpec {
    label: String,
    secondaryLabel: String,
    sfSymbol: String,
    action: KeyAction,
    keyClass: KeyClass,
    usesFuncFill: Bool,
    isBlueAccent: Bool,
    frame: CGRect,
}

pub def emptyKeySpec(): KeySpec =
    KeySpec {
        label: "",
        secondaryLabel: "",
        sfSymbol: "",
        action: ActSpace,
        keyClass: FuncClass,
        usesFuncFill: true,
        isBlueAccent: false,
        frame: cgRect(0.0, 0.0, 0.0, 0.0),
    }

def round3(v: Float): Float =
    floor(v * 3.0 + 0.5) / 3.0

def makeCharKey(label: String, act: KeyAction, frame: CGRect): KeySpec =
    KeySpec {
        label: label,
        secondaryLabel: "",
        sfSymbol: "",
        action: act,
        keyClass: CharClass,
        usesFuncFill: false,
        isBlueAccent: false,
        frame: frame,
    }

def makeFuncKey(label: String, secondary: String, sym: String, act: KeyAction, frame: CGRect, blue: Bool): KeySpec =
    KeySpec {
        label: label,
        secondaryLabel: secondary,
        sfSymbol: sym,
        action: act,
        keyClass: FuncClass,
        usesFuncFill: true,
        isBlueAccent: blue,
        frame: frame,
    }

/// Compute exact iOS 26 horizontal metrics for `viewWidth`.
def computeRowMetrics(viewWidth: Float): (Float, Float, Float, Float) = {
    let w = if (viewWidth < 280.0) 280.0 else viewWidth;
    let isLandscape = w > 540.0;
    let outerX = if (isLandscape) 8.0 else round3(w * (20.0 / 1320.0));
    let gapX = if (isLandscape) 6.5 else round3(w * (18.0 / 1320.0));
    let stdKeyW = (w - outerX * 2.0 - gapX * 9.0) / 10.0;
    let pitchX = stdKeyW + gapX;
    (outerX, gapX, stdKeyW, pitchX)
}

def appendBottomRow4Key(
    out: Vec KeySpec,
    viewWidth: Float,
    outerX: Float,
    gapX: Float,
    stdKeyW: Float,
    pitchX: Float,
    y3: Float,
    mode: KeyboardMode,
    asciiMode: Bool,
    showGlobe: Bool,
): Void = {
    let kh = keyHeight();
    let row1StartX = outerX + pitchX * 0.5;
    let col1X = row1StartX + pitchX;
    let col2X = row1StartX + pitchX * 2.0;
    let col6MaxX = row1StartX + pitchX * 6.0 + stdKeyW;

    let leftPairSpan = (col1X + stdKeyW) - outerX;
    let leftEachW = (leftPairSpan - gapX) * 0.5;

    let (planeLbl, targetMode) = match mode {
        ModeQwerty -> ("123", ModeNumbers),
        _ -> ("ABC", ModeQwerty),
    };
    vecPush(out, makeFuncKey(planeLbl, "", "", ActSwitchMode(targetMode), cgRect(outerX, y3, leftEachW, kh), false));

    let secondLeftX = outerX + leftEachW + gapX;
    if (showGlobe) {
        vecPush(out, makeFuncKey("", "", "globe", ActGlobe, cgRect(secondLeftX, y3, leftEachW, kh), false))
    } else {
        let (pLbl, sLbl) = if (asciiMode) ("EN", "/中") else ("中", "/英");
        vecPush(out, makeFuncKey(pLbl, sLbl, "", ActToggleAscii, cgRect(secondLeftX, y3, leftEachW, kh), false))
    };

    // Spacebar: d.minX .. j.maxX, white char-key fill like native iOS 26!
    let spaceX = col2X;
    let spaceW = col6MaxX - col2X;
    vecPush(out, KeySpec {
        label: if (asciiMode) "space" else "空格",
        secondaryLabel: "",
        sfSymbol: "",
        action: ActSpace,
        keyClass: FuncClass,
        usesFuncFill: false,
        isBlueAccent: false,
        frame: cgRect(spaceX, y3, spaceW, kh),
    });

    // Return key: systemBlue accent fill with crisp white text!
    let retX = col6MaxX + gapX;
    let retW = (viewWidth - outerX) - retX;
    vecPush(out, makeFuncKey(if (asciiMode) "return" else "换行", "", "", ActReturn, cgRect(retX, y3, retW, kh), true))
}

/// Build the pixel-exact iOS 26 QWERTY portrait layout (`ribbonHeight` = 53pt at top).
pub def buildQwertyLayout(viewWidth: Float, asciiMode: Bool, shifted: Bool, showGlobe: Bool): Vec KeySpec = {
    let out: Vec KeySpec = vecNew();
    let (outerX, gapX, stdKeyW, pitchX) = computeRowMetrics(viewWidth);
    let kh = keyHeight();
    let rg = rowGap();
    let pitchY = kh + rg;
    let y0 = ribbonHeight();
    let y1 = y0 + pitchY;
    let y2 = y0 + pitchY * 2.0;
    let y3 = y0 + pitchY * 3.0;
    let row1StartX = outerX + pitchX * 0.5;

    // Row 0: q w e r t y u i o p
    let r0 = if (shifted) "QWERTYUIOP" else "qwertyuiop";
    let r0Lower = "qwertyuiop";
    let i0 = cellNew(0);
    while (cellGet(i0) < 10) {
        let idx = cellGet(i0);
        let x = outerX + intToFloat(idx) * pitchX;
        vecPush(out, makeCharKey(
            strSlice(r0, idx, idx + 1),
            ActLetter(strByteAt(r0Lower, idx)),
            cgRect(x, y0, stdKeyW, kh)
        ));
        cellSet(i0, idx + 1)
    };

    // Row 1: a s d f g h j k l
    let r1 = if (shifted) "ASDFGHJKL" else "asdfghjkl";
    let r1Lower = "asdfghjkl";
    let i1 = cellNew(0);
    while (cellGet(i1) < 9) {
        let idx = cellGet(i1);
        let x = row1StartX + intToFloat(idx) * pitchX;
        vecPush(out, makeCharKey(
            strSlice(r1, idx, idx + 1),
            ActLetter(strByteAt(r1Lower, idx)),
            cgRect(x, y1, stdKeyW, kh)
        ));
        cellSet(i1, idx + 1)
    };

    // Row 2: [shift] + z x c v b n m (aligned with s..k) + [delete.backward]
    let sideKeyW = stdKeyW * 1.342;
    let shiftSym = if (shifted) "shift.fill" else "shift";
    vecPush(out, makeFuncKey("", "", shiftSym, ActShift, cgRect(outerX, y2, sideKeyW, kh), false));

    let r2 = if (shifted) "ZXCVBNM" else "zxcvbnm";
    let r2Lower = "zxcvbnm";
    let i2 = cellNew(0);
    while (cellGet(i2) < 7) {
        let idx = cellGet(i2);
        let x = row1StartX + intToFloat(idx + 1) * pitchX;
        vecPush(out, makeCharKey(
            strSlice(r2, idx, idx + 1),
            ActLetter(strByteAt(r2Lower, idx)),
            cgRect(x, y2, stdKeyW, kh)
        ));
        cellSet(i2, idx + 1)
    };
    vecPush(out, makeFuncKey("", "", "delete.backward", ActBackspace, cgRect(viewWidth - outerX - sideKeyW, y2, sideKeyW, kh), false));

    // Row 3: exact 4-key grid
    appendBottomRow4Key(out, viewWidth, outerX, gapX, stdKeyW, pitchX, y3, ModeQwerty, asciiMode, showGlobe);
    out
}

/// Build the Numbers & Symbols layouts matching `main`'s `.numbers` and `.symbols` planes.
pub def buildNumbersOrSymbolsLayout(viewWidth: Float, isSymbols: Bool, asciiMode: Bool, showGlobe: Bool): Vec KeySpec = {
    let out: Vec KeySpec = vecNew();
    let (outerX, gapX, stdKeyW, pitchX) = computeRowMetrics(viewWidth);
    let kh = keyHeight();
    let rg = rowGap();
    let pitchY = kh + rg;
    let y0 = ribbonHeight();
    let y1 = y0 + pitchY;
    let y2 = y0 + pitchY * 2.0;
    let y3 = y0 + pitchY * 3.0;
    let row1StartX = outerX + pitchX * 0.5;

    let pushRow10 = (y: Float, items: Vec String) -> {
        let i = cellNew(0);
        while (cellGet(i) < 10) {
            let idx = cellGet(i);
            let s = vecGetOr(items, idx, "");
            vecPush(out, makeCharKey(s, ActSymbol(s), cgRect(outerX + intToFloat(idx) * pitchX, y, stdKeyW, kh)));
            cellSet(i, idx + 1)
        }
    };

    let r0: Vec String = vecNew();
    let r1: Vec String = vecNew();
    if (!isSymbols) {
        vecPush(r0, "1"); vecPush(r0, "2"); vecPush(r0, "3"); vecPush(r0, "4"); vecPush(r0, "5");
        vecPush(r0, "6"); vecPush(r0, "7"); vecPush(r0, "8"); vecPush(r0, "9"); vecPush(r0, "0");
        if (asciiMode) {
            vecPush(r1, "-"); vecPush(r1, "/"); vecPush(r1, ":"); vecPush(r1, ";"); vecPush(r1, "(");
            vecPush(r1, ")"); vecPush(r1, "$"); vecPush(r1, "&"); vecPush(r1, "@"); vecPush(r1, "\"")
        } else {
            vecPush(r1, "-"); vecPush(r1, "/"); vecPush(r1, "："); vecPush(r1, "；"); vecPush(r1, "（");
            vecPush(r1, "）"); vecPush(r1, "￥"); vecPush(r1, "@"); vecPush(r1, "“"); vecPush(r1, "”")
        }
    } else {
        vecPush(r0, "["); vecPush(r0, "]"); vecPush(r0, "{"); vecPush(r0, "}"); vecPush(r0, "#");
        vecPush(r0, "%"); vecPush(r0, "^"); vecPush(r0, "*"); vecPush(r0, "+"); vecPush(r0, "=");
        vecPush(r1, "——"); vecPush(r1, "\\"); vecPush(r1, "|"); vecPush(r1, "～"); vecPush(r1, "《");
        vecPush(r1, "》"); vecPush(r1, "【"); vecPush(r1, "】"); vecPush(r1, "…"); vecPush(r1, "·")
    };
    pushRow10(y0, r0);
    pushRow10(y1, r1);

    let sideKeyW = stdKeyW * 1.342;
    let (swLbl, swMode) = if (!isSymbols) ("#+=", ModeSymbols) else ("123", ModeNumbers);
    vecPush(out, makeFuncKey(swLbl, "", "", ActSwitchMode(swMode), cgRect(outerX, y2, sideKeyW, kh), false));

    let mid: Vec String = vecNew();
    if (!isSymbols) {
        vecPush(mid, "。"); vecPush(mid, "，"); vecPush(mid, "、"); vecPush(mid, "？"); vecPush(mid, "！"); vecPush(mid, ".")
    } else {
        vecPush(mid, "…"); vecPush(mid, "‘"); vecPush(mid, "’"); vecPush(mid, "〈"); vecPush(mid, "〉")
    };
    let mn = vecLen(mid);
    let minX = row1StartX + pitchX;
    let maxX = row1StartX + pitchX * 7.0 + stdKeyW;
    let spanW = maxX - minX;
    let mw = (spanW - gapX * intToFloat(mn - 1)) / intToFloat(mn);
    let mi = cellNew(0);
    while (cellGet(mi) < mn) {
        let idx = cellGet(mi);
        let s = vecGetOr(mid, idx, "");
        vecPush(out, makeCharKey(s, ActSymbol(s), cgRect(minX + intToFloat(idx) * (mw + gapX), y2, mw, kh)));
        cellSet(mi, idx + 1)
    };
    vecPush(out, makeFuncKey("", "", "delete.backward", ActBackspace, cgRect(viewWidth - outerX - sideKeyW, y2, sideKeyW, kh), false));

    let curMode = if (isSymbols) ModeSymbols else ModeNumbers;
    appendBottomRow4Key(out, viewWidth, outerX, gapX, stdKeyW, pitchX, y3, curMode, asciiMode, showGlobe);
    out
}

/// Build the T9 9-key Pinyin portrait layout.
pub def buildT9Layout(viewWidth: Float, asciiMode: Bool, showGlobe: Bool): Vec KeySpec = {
    let out: Vec KeySpec = vecNew();
    let (outerX, gapX, _, _) = computeRowMetrics(viewWidth);
    let kh = keyHeight();
    let rg = rowGap();
    let pitchY = kh + rg;
    let y0 = ribbonHeight();
    let railW = t9SyllableRailWidth();
    let rightW = 64.0;
    let gridX = outerX + railW + gapX;
    let gridW = viewWidth - outerX * 2.0 - railW - rightW - gapX * 2.0;
    let cellW = (gridW - gapX * 2.0) / 3.0;
    let rightX = gridX + gridW + gapX;

    let addPad = (row: Int, col: Int, label: String, act: KeyAction) -> {
        let x = gridX + intToFloat(col) * (cellW + gapX);
        let y = y0 + intToFloat(row) * pitchY;
        vecPush(out, makeCharKey(label, act, cgRect(x, y, cellW, kh)))
    };

    addPad(0, 0, "，。", ActSymbol("，"));
    addPad(0, 1, "ABC", ActDigitT9(2));
    addPad(0, 2, "DEF", ActDigitT9(3));
    vecPush(out, makeFuncKey("", "", "delete.backward", ActBackspace, cgRect(rightX, y0, rightW, kh), false));

    addPad(1, 0, "GHI", ActDigitT9(4));
    addPad(1, 1, "JKL", ActDigitT9(5));
    addPad(1, 2, "MNO", ActDigitT9(6));
    let (pLbl, sLbl) = if (asciiMode) ("EN", "/中") else ("中", "/英");
    vecPush(out, makeFuncKey(pLbl, sLbl, "", ActToggleAscii, cgRect(rightX, y0 + pitchY, rightW, kh), false));

    addPad(2, 0, "PQRS", ActDigitT9(7));
    addPad(2, 1, "TUV", ActDigitT9(8));
    addPad(2, 2, "WXYZ", ActDigitT9(9));
    vecPush(out, makeFuncKey("全键", "", "", ActSwitchMode(ModeQwerty), cgRect(rightX, y0 + pitchY * 2.0, rightW, kh), false));

    let y3 = y0 + pitchY * 3.0;
    vecPush(out, makeFuncKey("123", "", "", ActSwitchMode(ModeNumbers), cgRect(outerX, y3, railW, kh), false));
    if (showGlobe) {
        vecPush(out, makeFuncKey("", "", "globe", ActGlobe, cgRect(gridX, y3, cellW, kh), false));
        vecPush(out, KeySpec {
            label: "空格", secondaryLabel: "", sfSymbol: "",
            action: ActSpace, keyClass: FuncClass, usesFuncFill: false, isBlueAccent: false,
            frame: cgRect(gridX + cellW + gapX, y3, cellW * 2.0 + gapX, kh),
        })
    } else {
        vecPush(out, KeySpec {
            label: "空格", secondaryLabel: "", sfSymbol: "",
            action: ActSpace, keyClass: FuncClass, usesFuncFill: false, isBlueAccent: false,
            frame: cgRect(gridX, y3, gridW, kh),
        })
    };
    vecPush(out, makeFuncKey("换行", "", "", ActReturn, cgRect(rightX, y3, rightW, kh), true));
    out
}

pub def buildLayoutForMode(mode: KeyboardMode, viewWidth: Float, asciiMode: Bool, shifted: Bool, showGlobe: Bool): Vec KeySpec =
    match mode {
        ModeQwerty -> buildQwertyLayout(viewWidth, asciiMode, shifted, showGlobe),
        ModeT9 -> buildT9Layout(viewWidth, asciiMode, showGlobe),
        ModeNumbers -> buildNumbersOrSymbolsLayout(viewWidth, false, asciiMode, showGlobe),
        ModeSymbols -> buildNumbersOrSymbolsLayout(viewWidth, true, asciiMode, showGlobe),
    }

/// Hit-test a touch point against `keys`.
pub def hitTestKeys(keys: Vec KeySpec, pt: CGPoint): Option KeySpec = {
    let n = vecLen(keys);
    let dummy = emptyKeySpec();
    let found: Cell (Option KeySpec) = cellNew(None);
    let i = cellNew(0);
    while (cellGet(i) < n && match cellGet(found) { None -> true, Some(_) -> false }) {
        let k = vecGetOr(keys, cellGet(i), dummy);
        if (rectContainsPoint(k.frame, pt)) cellSet(found, Some(k)) else ();
        cellSet(i, cellGet(i) + 1)
    };
    cellGet(found)
}
