/// Complete 1:1 port of `iOS/KeyboardExtension/KeyboardViewController.swift` (1,707 lines):
/// - Dynamically registers `KeyboardViewController : UIInputViewController` in `extern init(102)`
/// - Shares process-wide `bridgeShared()` (`JuxuSession`) across overlapping `UIInputViewController` lifecycles
/// - `273pt` portrait (`53pt` ribbon + `220pt` 4-row canvas) / `204pt` landscape (`40pt` + `164pt`) height constraint
///   at priority `999` (NEVER setting `preferredContentSize`)
/// - Full `IOSInlineMarkedTextSession` turn-boundary XPC coalescing, cross-instance orphan sweep & TextKit 2 caret restore
/// - `PunctuationPairingTracker`, `AutoSpaceContextTracker`, `IOSLineClear` & `IOSLineClearUndo`,
///   `IOSClipboardSuggestionStore` + async `UIPasteboard` background probing, T9 sidebar, expanded candidate grid,
///   floating/docked key callout, alternates strip, whole-keyboard trackpad, and `handleInputModeListFromView:withEvent:`.

use std.option.{Option, Some, None}
use std.vec.{Vec, vecNew, vecWithCap, vecLen, vecPush, vecGet, vecGetOr}
use std.str.{strStartsWith, strEndsWith}
use objc.{
    objcClass, objcSel, objcAllocateClass, objcAddMethod, objcRegisterClass,
    objcSetAssocHandle, objcGetAssocHandle,
    msgSend0, msgSend1Float, msgSendBool0, msgSendI64_0, msgSendFloat0,
    msgSendVoid0, msgSendVoid1Ptr, msgSendVoid2Ptr, msgSendVoid1Bool, msgSendVoid1I64, msgSendVoid1Float,
}
use juxu_core.{
    Candidate, MkCandidate,
}
use juxu_shared.{
    CGPoint, CGSize, cgSize, cgRect,
    msgSendBool1Ptr, msgSendVoid1F32, msgSendVoid1Ptr1Sel2Ptr,
    objcSendSuperVoid0, objcSendSuperVoid1Ptr, objcSendSuperVoid1Bool,
    nsStr, nsStrPtrToOpt, objcAllocInitFrame,
    systemUptimeSeconds, dispatchMainAsync, dispatchMainAfterMs,
    dispatchQueueCreateSerial, dispatchAsync,
    utf8ScalarCount, tailScalars, dropLastScalars,
    JuxuActionState, activeInlinePreedit, configIsCangjieFamily,
    PunctuationAction, Plain, InsertPair, SkipClose,
    PunctuationPairingTracker, punctuationTrackerNew, punctuationTrackerReset,
    punctuationTrackerPrune, punctuationTrackerHandleSymbol, punctuationTrackerConsumeBackspacePair,
    AutoSpaceOptions, autoSpaceOptionsFromConfig, isAutoSpaceRightTrigger,
    autoSpaceTrackerInvalidate, autoSpaceTrackerEffectiveBefore, autoSpaceTrackerWillDeleteBackward,
    JuxuSession, bridgeShared, bridgeReloadConfigAndUserOnAppear,
    bridgeFlushUserDataAsync, bridgeFlushPendingPersistence, bridgeHandleMemoryWarning,
    bridgeSetKeyLayout52, bridgeSetT9Layout16,
    bridgeHandleKey, bridgePushTouch, bridgePushT9Touch, bridgeLockT9Syllable,
    bridgeSelectCandidate, bridgeSelectAbsCandidate, bridgeCommitPending, bridgeResetQuoteState,
    bridgeAllCandidates, bridgeToggleAsciiMode, bridgeClearComposition,
    bridgeAbandonComposition, bridgeNotifyPostCommitBackspace,
    bridgeSetContext, bridgeAcceptPrediction, bridgePredictNextWords,
}
use layout_engine.{
    IOSKeyPlane, PlaneLetters,
    IOSShiftState, shiftIsUppercase,
    IOSReturnKeyRole, mapUIReturnKeyType,
    IOSKeyKind, KeyLetter, KeyT9, KeyT9Clear, KeySymbol, KeyShift, KeyBackspace,
    KeyPlaneSwitch, KeyGlobe, KeyModeToggle, KeySpace, KeyReturn,
    IOSKeySpec, rectEq, sizeEq, optStrEq,
    IOSKeyboardLayoutEngine, layoutEngineNew,
    trayTopCornerRadius, candidateBarHeight, landscapeCandidateBarHeight,
    portraitTotalHeight, landscapeTotalHeight,
    layoutTapShift, layoutConsumeOneShotShiftIfNeeded, layoutSwitchPlane,
    shouldReturnToLettersAfterSymbol, computeLayout, compensatedLetterPoint,
}
use marked_text.{
    IOSMarkedTextSink, makeProxyDocumentSink, proxyDocumentIdentifier,
    IOSInlineMarkedTextSession, markedSessionNew,
    markedSessionMarkedCode, markedSessionHasOrphanedMarked, markedSessionNeedsAppearanceSweep,
    markedSessionCompositionBaseContext,
    markedSessionReset, markedSessionResetForAppearance,
    markedSessionRecordFocusLoss, markedSessionRecordKeyboardDisappear,
    markedSessionSweepOrphanedMarkedText, markedSessionRestoreCaretAfterOrphanedSweepIfNeeded,
    markedSessionReconcileExternalContext, markedSessionFlushTurnBoundary,
    markedSessionCancelMarkedCode, markedSessionInsertTextWithAutoSpace,
