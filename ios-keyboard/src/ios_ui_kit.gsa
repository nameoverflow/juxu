/// Strongly-typed UIKit / QuartzCore / CoreHaptics Geisha wrappers for `ios-keyboard`.

use objc.{
    objcClass, objcSel,
    msgSend0, msgSend1Ptr, msgSend1Float, msgSendI64_0, msgSendFloat0,
    msgSendVoid0, msgSendVoid1Ptr, msgSendVoid1Bool, msgSendVoid1I64, msgSendVoid1Float,
}
use juxu_shared.{
    CGPoint, CGSize, CGRect, CGAffineTransform,
    msgSend1Ptr1Float, msgSendVoid1F32, msgSendVoid1Rect, msgSendVoid1Point,
    msgSendVoid1Size, msgSendVoid1Transform,
    msgSendRect0, msgSendPoint1Ptr, msgSendPoint1Point1Ptr, msgSendRect1Rect1Ptr,
    nsStr,
}

