    rectIntersectsRect, rectMidX, rectMidY, rectMaxX, rectMaxY,
    strUtf16Len, utf8ToScalars, scalarsToUtf8, dropLastScalars,
    AutoSpaceOptions,
    autoSpaceTrackerNew, autoSpaceTrackerEffectiveBefore, autoSpaceTrackerPrepareCommit,
    PunctuationAction, Plain, InsertPair, SkipClose,
    closerForOpen, punctuationAction, punctuationShouldDeletePair, punctuationPruned, punctuationCursorStaysInPairs,
    activeInlinePreedit,
    bridgeNew, bridgeApplyAndSaveConfig, bridgeSwitchSchema,
