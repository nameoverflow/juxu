/// Pure Geisha iOS Host App (`Juxu.app`, embedding `JuxuKeyboard.appex`):
/// 1:1 port of `iOS/HostApp/JuxuIOSApp.swift` + `iOS/HostApp/HostAppViews.swift`.

use sys.env.{argCount}
use objc.{
    objcClass, objcSel, objcAllocateClass, objcAddMethod, objcAddProtocol, objcRegisterClass,
    msgSend0, msgSend1Ptr, msgSend1I64, msgSendI64_0,
    msgSendVoid0, msgSendVoid1Ptr, msgSendVoid1I64, msgSendVoid1Bool,
}
use juxu_shared.{
    i64ToPtr,
    msgSendVoid1Ptr1I64, msgSendVoid1Ptr1Sel2Ptr,
    nsStr, nsStrPtrToString, objcAllocInit, systemUptimeSeconds,
    bridgeShared, bridgeLoadConfigAndUser, bridgeFlushUserDataSync, bridgeHandleMemoryWarning,
}
use uikit_kit.{
    notifWillEnterForeground, notifDidEnterBackground, asciiLower,
}
use custom_views.{registerCustomViewClasses}
use tab_home.{registerHomeTabClass, refreshHomeTab, dismissHomeKeyboardState}
use tab_typing.{registerTypingTabClass, refreshTypingTab}
use tab_typo.{registerTypoTabClass, refreshTypoTab}
use tab_lexicon.{registerLexiconTabClass, refreshLexiconTab, syncLexiconTabUiOnly, dismissLexiconKeyboardState}

extern "UIApplicationMain" def c_UIApplicationMain(argc: Int, argv: Ptr, principal: Ptr, delegate: Ptr): Int
extern "_NSGetArgv" def c_NSGetArgv(): Ptr
extern "objc_msgSend" def msgSendInitTabItem(obj: Ptr, sel: Ptr, title: Ptr, img: Ptr, tag: Int64): Ptr

def gAppWindow: Cell Ptr = cellNew(ptrNull())
def gMainTabs: Cell Ptr = cellNew(ptrNull())
def gLastFgReloadUptime: Cell Float = cellNew(0.0)

// ============================================================================
// `IOSHostTab` Navigation Wrapping & Tab Bar Construction
// ============================================================================

def makeNavForTab(vcClassName: String, title: String, iconName: String, tag: Int, hideNavBar: Bool): Ptr = {
    let vc = objcAllocInit(vcClassName);
    if (!hideNavBar) {
        msgSendVoid1Ptr(vc, objcSel("setTitle:"), nsStr(title))
    } else ();

    let navAlloc = msgSend0(objcClass("UINavigationController"), objcSel("alloc"));
    let nav = msgSend1Ptr(navAlloc, objcSel("initWithRootViewController:"), vc);
    if (hideNavBar) {
        msgSendVoid1Bool(nav, objcSel("setNavigationBarHidden:"), true)
    } else {
        let navBar = msgSend0(nav, objcSel("navigationBar"));
        if (!ptrIsNull(navBar)) {
            msgSendVoid1Bool(navBar, objcSel("setPrefersLargeTitles:"), true)
        } else ()
    };

    let img = msgSend1Ptr(objcClass("UIImage"), objcSel("systemImageNamed:"), nsStr(iconName));
    let itemAlloc = msgSend0(objcClass("UITabBarItem"), objcSel("alloc"));
    let tabItem = msgSendInitTabItem(
        itemAlloc,
        objcSel("initWithTitle:image:tag:"),
        nsStr(title),
        img,
        intToI64(tag)
    );
    msgSendVoid1Ptr(nav, objcSel("setTabBarItem:"), tabItem);
    let _ = msgSendVoid1Ptr1I64;
    nav
}

def makeMainTabBarController(): Ptr = {
    let _ = bridgeShared();
    let nav0 = makeNavForTab("JuxuHomeTabVC", "首页与试手", "keyboard.badge.ellipsis", 0, true);
    let nav1 = makeNavForTab("JuxuTypingTabVC", "输入设置", "slider.horizontal.3", 1, false);
    let nav2 = makeNavForTab("JuxuTypoTabVC", "误触与热区", "hand.point.up.left", 2, false);
    let nav3 = makeNavForTab("JuxuLexiconTabVC", "个人词库", "text.book.closed", 3, false);

    let arr = msgSend0(objcClass("NSMutableArray"), objcSel("array"));
    msgSendVoid1Ptr(arr, objcSel("addObject:"), nav0);
    msgSendVoid1Ptr(arr, objcSel("addObject:"), nav1);
    msgSendVoid1Ptr(arr, objcSel("addObject:"), nav2);
    msgSendVoid1Ptr(arr, objcSel("addObject:"), nav3);

    let tabs = objcAllocInit("UITabBarController");
    msgSendVoid1Ptr(tabs, objcSel("setViewControllers:"), arr);
    msgSendVoid1I64(tabs, objcSel("setSelectedIndex:"), intToI64(0));
    cellSet(gMainTabs, tabs);
    tabs
}

// ============================================================================
// Deep-Link URL Routing (`juxu://...`, `HostAppViews.swift` lines 817-833)
// ============================================================================

def stripSlashes(s: String): String = {
    let n = strLen(s);
    let lo = cellNew(0);
    while (cellGet(lo) < n && strByteAt(s, cellGet(lo)) == 47) {
        cellSet(lo, cellGet(lo) + 1)
    };
    let hi = cellNew(n);
    while (cellGet(hi) > cellGet(lo) && strByteAt(s, cellGet(hi) - 1) == 47) {
        cellSet(hi, cellGet(hi) - 1)
    };
    strSlice(s, cellGet(lo), cellGet(hi))
}

def handleDeepLinkUrl(nsUrl: Ptr): Bool =
    if (ptrIsNull(nsUrl)) false
    else {
        let scheme = asciiLower(nsStrPtrToString(msgSend0(nsUrl, objcSel("scheme"))));
        if (scheme != "juxu") false
        else {
            dismissHomeKeyboardState();
            dismissLexiconKeyboardState();
            let hostRaw = nsStrPtrToString(msgSend0(nsUrl, objcSel("host")));
            let pathRaw = nsStrPtrToString(msgSend0(nsUrl, objcSel("path")));
            let dest = asciiLower(if (strLen(hostRaw) > 0) hostRaw else stripSlashes(pathRaw));
            let targetIdx =
                if (dest == "settings" || dest == "typing" || dest == "schema") 1
                else if (dest == "typo" || dest == "hitbox") 2
                else if (dest == "lexicon" || dest == "phrases") 3
                else if (dest == "home" || dest == "sandbox") 0
                else 1;
            let tabs = cellGet(gMainTabs);
            if (!ptrIsNull(tabs)) {
                msgSendVoid1I64(tabs, objcSel("setSelectedIndex:"), intToI64(targetIdx));
                if (targetIdx == 0) refreshHomeTab()
                else if (targetIdx == 1) refreshTypingTab()
                else if (targetIdx == 2) refreshTypoTab()
                else refreshLexiconTab()
            } else ();
            true
        }
    }

def handleOpenUrlContexts(urlContextsSet: Ptr): Void =
    if (!ptrIsNull(urlContextsSet)) {
        let arr = msgSend0(urlContextsSet, objcSel("allObjects"));
        if (!ptrIsNull(arr)) {
            let n = i64ToInt(msgSendI64_0(arr, objcSel("count")));
            let i = cellNew(0);
            while (cellGet(i) < n) {
                let idx = cellGet(i);
                let ctx = msgSend1I64(arr, objcSel("objectAtIndex:"), intToI64(idx));
                if (!ptrIsNull(ctx)) {
                    let url = msgSend0(ctx, objcSel("URL"));
                    let _ = handleDeepLinkUrl(url);
                    ()
                } else ();
                cellSet(i, idx + 1)
            }
        } else ()
    } else ()

// ============================================================================
// Foreground / Background Sync (`JuxuIOSApp.swift` lines 12-18)
// ============================================================================

def performForegroundSync(): Void = {
    let now = systemUptimeSeconds();
    if (now - cellGet(gLastFgReloadUptime) >= 0.15 || cellGet(gLastFgReloadUptime) == 0.0) {
        cellSet(gLastFgReloadUptime, now);
        let s = bridgeShared();
        bridgeLoadConfigAndUser(s, true);
        refreshHomeTab();
        refreshTypingTab();
        refreshTypoTab();
        syncLexiconTabUiOnly()
    } else ()
}

def performBackgroundFlush(): Void = {
    let s = bridgeShared();
    bridgeFlushUserDataSync(s)
}

// ============================================================================
// `JuxuIOSSceneDelegate` & `JuxuIOSAppDelegate`
// ============================================================================

def sceneGetWindow(_self: Ptr, _cmd: Ptr): Ptr =
    cellGet(gAppWindow)

def sceneSetWindow(_self: Ptr, _cmd: Ptr, w: Ptr): Void =
    cellSet(gAppWindow, w)

def sceneWillConnect(_self: Ptr, _cmd: Ptr, scene: Ptr, _session: Ptr, connectionOptions: Ptr): Void = {
    let winAlloc = msgSend0(objcClass("UIWindow"), objcSel("alloc"));
    let win = msgSend1Ptr(winAlloc, objcSel("initWithWindowScene:"), scene);
    let tabs = makeMainTabBarController();
    msgSendVoid1Ptr(win, objcSel("setRootViewController:"), tabs);
    msgSendVoid0(win, objcSel("makeKeyAndVisible"));
    cellSet(gAppWindow, win);

    if (!ptrIsNull(connectionOptions)) {
        let urlContexts = msgSend0(connectionOptions, objcSel("URLContexts"));
        handleOpenUrlContexts(urlContexts)
    } else ()
}

def sceneOpenUrlContexts(_self: Ptr, _cmd: Ptr, _scene: Ptr, urlContexts: Ptr): Void =
    handleOpenUrlContexts(urlContexts)

def sceneWillEnterForeground(_self: Ptr, _cmd: Ptr, _scene: Ptr): Void =
    performForegroundSync()

def sceneDidBecomeActive(_self: Ptr, _cmd: Ptr, _scene: Ptr): Void =
    performForegroundSync()

def sceneDidEnterBackground(_self: Ptr, _cmd: Ptr, _scene: Ptr): Void =
    performBackgroundFlush()

def appOnWillEnterForeground(_self: Ptr, _cmd: Ptr, _notif: Ptr): Void =
    performForegroundSync()

def appOnDidEnterBackground(_self: Ptr, _cmd: Ptr, _notif: Ptr): Void =
    performBackgroundFlush()

def appDidFinishLaunching(self: Ptr, _cmd: Ptr, _app: Ptr, _opts: Ptr): Bool = {
    let _ = bridgeShared();
    let nc = msgSend0(objcClass("NSNotificationCenter"), objcSel("defaultCenter"));
    if (!ptrIsNull(nc)) {
        msgSendVoid1Ptr1Sel2Ptr(nc, objcSel("addObserver:selector:name:object:"), self, objcSel("onAppWillEnterForeground:"), notifWillEnterForeground(), ptrNull());
        msgSendVoid1Ptr1Sel2Ptr(nc, objcSel("addObserver:selector:name:object:"), self, objcSel("onAppDidEnterBackground:"), notifDidEnterBackground(), ptrNull())
    } else ();
    true
}

def appOpenUrl(_self: Ptr, _cmd: Ptr, _app: Ptr, url: Ptr, _opts: Ptr): Bool =
    handleDeepLinkUrl(url)

def appDidReceiveMemoryWarning(_self: Ptr, _cmd: Ptr, _app: Ptr): Void = {
    let s = bridgeShared();
    bridgeHandleMemoryWarning(s)
}

extern init(100) def registerIosHostAppClasses(): Void = {
    registerCustomViewClasses();
    registerHomeTabClass();
    registerTypingTabClass();
    registerTypoTabClass();
    registerLexiconTabClass();

    let scCls = objcAllocateClass("UIResponder", "JuxuIOSSceneDelegate");
    if (!ptrIsNull(scCls)) {
        let _ = objcAddProtocol(scCls, "UIWindowSceneDelegate");
        let _ = objcAddMethod(scCls, "window", cFnPtr(sceneGetWindow), "@@:");
        let _ = objcAddMethod(scCls, "setWindow:", cFnPtr(sceneSetWindow), "v@:@");
        let _ = objcAddMethod(scCls, "scene:willConnectToSession:options:", cFnPtr(sceneWillConnect), "v@:@@@");
        let _ = objcAddMethod(scCls, "scene:openURLContexts:", cFnPtr(sceneOpenUrlContexts), "v@:@@");
        let _ = objcAddMethod(scCls, "sceneWillEnterForeground:", cFnPtr(sceneWillEnterForeground), "v@:@");
        let _ = objcAddMethod(scCls, "sceneDidBecomeActive:", cFnPtr(sceneDidBecomeActive), "v@:@");
        let _ = objcAddMethod(scCls, "sceneDidEnterBackground:", cFnPtr(sceneDidEnterBackground), "v@:@");
        objcRegisterClass(scCls)
    } else ();

    let appCls = objcAllocateClass("UIResponder", "JuxuIOSAppDelegate");
    if (!ptrIsNull(appCls)) {
        let _ = objcAddProtocol(appCls, "UIApplicationDelegate");
        let _ = objcAddMethod(appCls, "application:didFinishLaunchingWithOptions:", cFnPtr(appDidFinishLaunching), "B@:@@");
        let _ = objcAddMethod(appCls, "application:openURL:options:", cFnPtr(appOpenUrl), "B@:@@@");
        let _ = objcAddMethod(appCls, "applicationDidReceiveMemoryWarning:", cFnPtr(appDidReceiveMemoryWarning), "v@:@");
        let _ = objcAddMethod(appCls, "onAppWillEnterForeground:", cFnPtr(appOnWillEnterForeground), "v@:@");
        let _ = objcAddMethod(appCls, "onAppDidEnterBackground:", cFnPtr(appOnDidEnterBackground), "v@:@");
        objcRegisterClass(appCls)
    } else ()
}

def main(): Void = {
    let argvSlot = c_NSGetArgv();
    let argv = if (ptrIsNull(argvSlot)) ptrNull() else i64ToPtr(ptrReadI64Le(argvSlot, 0));
    let argc = if (ptrIsNull(argv)) 0 else argCount();
    let _ = c_UIApplicationMain(argc, argv, ptrNull(), nsStr("JuxuIOSAppDelegate"));
    ()
}
