def imkMenu(self: Ptr, _cmd: Ptr): Ptr = {
    let s = activeSession();
    let cfg = cellGet(s.jsConfig);
    let curSchema = schemaId(cfg.schema);
    let curCategory = categoryForSchemaId(curSchema);

    let m = msgSendMenuInitTitle(
        msgSend0(objcClass("NSMenu"), objcSel("alloc")),
        objcSel("initWithTitle:"),
        nsStr("句序")
    );

    let cats = allSchemaCategories();
    let dummyCat = curCategory;
    let cIdx = cellNew(0);
    while (cellGet(cIdx) < std.vec.vecLen(cats)) {
        let cat: InputSchemaCategory = std.vec.vecGetOr(cats, cellGet(cIdx), dummyCat);
        let catTitle = categoryRawValue(cat);
        let catItem = makeMenuItem(catTitle, ptrNull(), None, curCategory == cat, 0);
        let sub = msgSendMenuInitTitle(
            msgSend0(objcClass("NSMenu"), objcSel("alloc")),
            objcSel("initWithTitle:"),
            nsStr(catTitle)
        );
        let opts = schemaOptionsForCategory(cat);
        let dummyOpt = InputSchemaOption {
            isoId: 86,
            isoCategory: cat,
            isoTitle: "",
            isoShortTitle: "",
            isoTag: "",
            isoDesc: "",
        };
        let oIdx = cellNew(0);
        while (cellGet(oIdx) < std.vec.vecLen(opts)) {
            let opt: InputSchemaOption = std.vec.vecGetOr(opts, cellGet(oIdx), dummyOpt);
            let optItem = makeMenuItem(
                opt.isoTitle,
                self,
                Some(objcSel("selectSchemaFromMenu:")),
                curSchema == opt.isoId,
                opt.isoId
            );
            msgSendVoid1Ptr(sub, objcSel("addItem:"), optItem);
            objcReleaseRaw(optItem);
            cellSet(oIdx, cellGet(oIdx) + 1)
        };
        msgSendVoid1Ptr(catItem, objcSel("setSubmenu:"), sub);
        objcReleaseRaw(sub);
        msgSendVoid1Ptr(m, objcSel("addItem:"), catItem);
        objcReleaseRaw(catItem);
        cellSet(cIdx, cellGet(cIdx) + 1)
    };

    msgSendVoid1Ptr(m, objcSel("addItem:"), msgSend0(objcClass("NSMenuItem"), objcSel("separatorItem")));

    let typoItem = makeMenuItem("误触与热区置信度纠正", self, Some(objcSel("toggleTypoCorrection:")), cfg.typo.enabled, 0);
    msgSendVoid1Ptr(m, objcSel("addItem:"), typoItem);
    objcReleaseRaw(typoItem);

    if (!configIsPinyinFamily(cfg)) {
        let slItem = makeMenuItem("流式无空格连打", self, Some(objcSel("toggleSpaceless:")), cfg.spaceless, 0);
        msgSendVoid1Ptr(m, objcSel("addItem:"), slItem);
        objcReleaseRaw(slItem)
    } else ();

    let orientTitle = if (cfg.orientation == Vertical) "切换为横排候选栏" else "切换为竖排候选栏";
    let orientItem = makeMenuItem(orientTitle, self, Some(objcSel("toggleOrientation:")), false, 0);
    msgSendVoid1Ptr(m, objcSel("addItem:"), orientItem);
    objcReleaseRaw(orientItem);

    let asItem = makeMenuItem("中英文之间自动加空格", self, Some(objcSel("toggleAutoSpace:")), cfg.autoSpaceZhEn, 0);
    msgSendVoid1Ptr(m, objcSel("addItem:"), asItem);
    objcReleaseRaw(asItem);

    if (voiceIsEnabled()) {
        msgSendVoid1Ptr(m, objcSel("addItem:"), msgSend0(objcClass("NSMenuItem"), objcSel("separatorItem")));
        let provTitle = "语音方案：" + voiceProviderDisplayName() + "（点击切换）";
        let provItem = makeMenuItem(provTitle, self, Some(objcSel("toggleVoiceProviderMode:")), false, 0);
        msgSendVoid1Ptr(m, objcSel("addItem:"), provItem);
        objcReleaseRaw(provItem);

        let polItem = makeMenuItem("语音智能整理", self, Some(objcSel("toggleVoiceSmartPolish:")), voiceIsSmartPolishEnabled(), 0);
        msgSendVoid1Ptr(m, objcSel("addItem:"), polItem);
        objcReleaseRaw(polItem)
    } else ();

    msgSendVoid1Ptr(m, objcSel("addItem:"), msgSend0(objcClass("NSMenuItem"), objcSel("separatorItem")));

    let reloadItem = makeMenuItem("重载配置与词库", self, Some(objcSel("reloadConfigAndLexicon:")), false, 0);
    msgSendVoid1Ptr(m, objcSel("addItem:"), reloadItem);
    objcReleaseRaw(reloadItem);

    let prefsItem = makeMenuItem("句序偏好设置…", self, Some(objcSel("showPreferences:")), false, 0);
    msgSendVoid1Ptr(m, objcSel("addItem:"), prefsItem);
    objcReleaseRaw(prefsItem);

    m
}

extern init(102) def registerInputControllerClass(): Void = {
    let cls = objcAllocateClass("IMKInputController", "JuxuInputController");
    if (!ptrIsNull(cls)) {
        let _ = objcAddMethod(cls, "initWithServer:delegate:client:", cFnPtr(imkInitWithServerDelegateClient), "@@:@@@");
        let _ = objcAddMethod(cls, "recognizedEvents:", cFnPtr(imkRecognizedEvents), "Q@:@");
        let _ = objcAddMethod(cls, "activateServer:", cFnPtr(imkActivateServer), "v@:@");
        let _ = objcAddMethod(cls, "deactivateServer:", cFnPtr(imkDeactivateServer), "v@:@");
        let _ = objcAddMethod(cls, "commitComposition:", cFnPtr(imkCommitComposition), "v@:@");
        let _ = objcAddMethod(cls, "handleEvent:client:", cFnPtr(imkHandleEvent), "B@:@@");
        let _ = objcAddMethod(cls, "menu", cFnPtr(imkMenu), "@@:");
        let _ = objcAddMethod(cls, "selectSchemaFromMenu:", cFnPtr(imkSelectSchemaFromMenu), "v@:@");
        let _ = objcAddMethod(cls, "toggleTypoCorrection:", cFnPtr(imkToggleTypoCorrection), "v@:@");
        let _ = objcAddMethod(cls, "toggleSpaceless:", cFnPtr(imkToggleSpaceless), "v@:@");
        let _ = objcAddMethod(cls, "toggleOrientation:", cFnPtr(imkToggleOrientation), "v@:@");
        let _ = objcAddMethod(cls, "toggleAutoSpace:", cFnPtr(imkToggleAutoSpace), "v@:@");
        let _ = objcAddMethod(cls, "toggleVoiceProviderMode:", cFnPtr(imkToggleVoiceProviderMode), "v@:@");
        let _ = objcAddMethod(cls, "toggleVoiceSmartPolish:", cFnPtr(imkToggleVoiceSmartPolish), "v@:@");
        let _ = objcAddMethod(cls, "reloadConfigAndLexicon:", cFnPtr(imkReloadConfigAndLexicon), "v@:@");
        let _ = objcAddMethod(cls, "showPreferences:", cFnPtr(imkShowPreferences), "v@:@");
        let _ = objcAddMethod(cls, "openSettings:", cFnPtr(imkShowPreferences), "v@:@");
        objcRegisterClass(cls)
    } else ()
}
