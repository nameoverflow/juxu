/// Complete 1:1 pure-AppKit port of `Sources/SettingsWindow.swift` (1,056 lines)
/// + `Scripts/RenderPreviews.swift` (321 lines):
/// - `SettingsSection` (`schema`, `typo`, `lexicon`, `voice`, `appearance`)
/// - `SettingsWindow : NSWindow` overriding `performKeyEquivalent:` + `isCloseWindowShortcut(nsEvent)`
///   handling `Cmd+W` (including CapsLock and non-Latin layouts `keyCode == 13`, rejecting Shift/Opt/Ctrl)
/// - 200pt translucent `NSVisualEffectView` (`.sidebar`) left navigation pane + right scrollable grouped-form pane
/// - Section 1 (`方案与输入`): 3 category radio cards + 3 version radio cards + fixed-code commit rules + spaceless/shortcode/z-lookup/rare-charset
/// - Section 2 (`误触与热区`): Bayesian typo switches + threshold sliders + calibration count/reset + interactive 26-key iOS touch simulator + `EvalLogSummary` 6-metric grid & Finder/Clear actions
/// - Section 3 (`组词与词库`): auto-phrase switches/threshold + phrase input & add + user phrase list (`SharedUserPhraseCodePill`, teal `"自动组词"`, count, trash delete) + `"打开配置目录"`
/// - Section 4 (`语音输入`): embeds `voiceBuildSettingsPageView(session, contentWidth)`
/// - Section 5 (`外观与标点`): horizontal/vertical segmented control, page size stepper (`3..9`), Shift toggle mode popup, smart punctuation, emoji, auto-space + digits, `;`/`'` quick select, live `CandidateBarView` preview
/// - `windowWillClose:` cleanup + `voiceOnSettingsWindowClosed()`
/// - `--render-previews <outDir>` 2x Retina PNG preview renderer (`candidates-light.png`, `candidates-dark.png`, `settings-*-*.png`).

use std.option.{Option, Some, None}
use std.vec.{Vec, vecNew, vecWithCap, vecLen, vecPush, vecGetOr}
use std.str.{intToStr, strTrim}
use std.path.{pathJoin, pathDirname, pathBasename}
use sys.fs.{fileExists, mkdirAll}
use objc.{
    Id, NSObject,
    objcClass, objcSel, objcAllocateClass, objcAddMethod, objcRegisterClass,
    objcSetAssocHandle, objcGetAssocHandle, objcReleaseRaw, idAdopt,
    msgSend0, msgSend1Ptr, msgSendInt0, msgSendI64_0, msgSendFloat0,
    msgSendVoid0, msgSendVoid1Ptr, msgSendVoid1I64, msgSendVoid1Bool, msgSendVoid1Float,
}
use juxu_core.{
    schemaId, JuxuConfig,
    Candidate, MkCandidate, emptyCandidate,
    UserPhraseInfo, UserPhrase, MkUserPhrase,
    KeyTouchSample, touchKeyOffsetZero,
}
use juxu_shared.{
    MkJuxuConfig, TypoConfig, MkTypoConfig,
    FourthEmptyBehavior, FourthBlock, FourthClear,
    ShiftToggleMode, CommitCode, CommitFirst, ShiftClear,
    CandidateOrientation, Horizontal, Vertical,
    JuxuSession, JuxuActionState, emptyActionState,
    bridgeNew, bridgeApplyAndSaveConfig, bridgeSwitchSchema,
    bridgeRefreshUserPhrases, bridgeRefreshTouchProfile,
    bridgeHandleKey, bridgePushTouch, bridgeSelectCandidate, bridgeTurnPage, bridgeClearComposition,
    bridgeSetContext, bridgeAddUserPhrase, bridgeRemoveUserPhrase,
    bridgeResetTouchCalibration, bridgeApplyTouchCalibrations,
    bridgeReloadEvalLogSummary, bridgeClearEvalLog,
    InputSchemaCategory, CatWubi, allSchemaCategories,
    categoryRawValue, categorySubtitle, categorySymbolName, categoryDefaultSchemaId, configSchemaCategory,
    InputSchemaOption, schemaOptionsForCategory,
    configIsPinyinFamily, configIsCangjieFamily, configIsWubiFamily,
    calibratedProgressText, formatFixed2Signed, EvalLogMetricItem, evalLogMetrics,
    maxCodeChineseNumeral, pushCodeChineseNumeral, maxCodeDigits, pushCodeDigits,
    CGPoint, CGSize, CGRect, cgPoint, cgSize, cgRect, rectContainsPoint,
    ptrToI64, nsStr, nsStrPtrToString, objcAllocInit, objcAllocInitFrame,
    utf8ScalarCount, tailScalars, scalarToString,
    msgSendRect0, msgSendPoint0, msgSendSize0, msgSendPoint1Point1Ptr,
    msgSendInitFrame, msgSend1Rect1U64_1I64_1Bool,
    msgSendVoid1Rect, msgSendVoid1Size, msgSendVoid1Ptr1Sel, msgSend2Ptr, msgSend1Ptr1I64,
    objcSendSuperBool1Ptr, dispatchMainAsync,
}
use macos_ffi.{
    wallNowMs, objcSendSuperVoid1Size, msgSendDrawInRectImg, msgSendSizeWithAttrs,
    msgSendBitmapInit, msgSendCacheDisplay, msgSendRepUsingType, msgSendWriteToFile,
