/// 1:1 port of `Sources/CandidatePanel.swift` (lines 1-633):
/// - `CandidatePanelMetrics` (`outerCornerRadius = 11.0`, `inset = 4.0`, `pillHeight = 24.0`, `pillCornerRadius = 7.0`, `barHeight = 32.0`)
/// - `NativeCandidateContentView` (pure AppKit `NSView`, `subviews` empty, zero `NSHostingView`, strictly single-line horizontal bar
///   never wrapping + aligned multi-column vertical bar when `st.asVertical == true`, `cleanAnnotation` stripping `⚡`/`⌖` & `%` confidence,
///   baseline-aligned guide digits & monospace comments, hover highlight, clickable `^`/`v` chevron pagers)
/// - `CandidateBarView` helper (`candidateBarCreate` / `candidateBarUpdate`) for Settings & Retina Previews
/// - `CandidatePanelController` (`candidatePanelUpdateState`, `candidatePanelHide`, `candidatePanelSetOnSelect`, `candidatePanelSetOnPage`).

use std.option.{Option, Some, None}
use std.vec.{Vec, vecNew, vecWithCap, vecLen, vecPush, vecGetOr, vecClear}
use std.buf.{bufWithCap, bufPushByte, bufToString}
use std.str.{intToStr, strTrim, strIndexOfByte}
use std.math.{ceil}
use objc.{
    objcClass, objcSel, objcAllocateClass, objcAddMethod, objcRegisterClass,
    objcSetAssocHandle, objcGetAssocHandle, objcReleaseRaw,
    msgSend0, msgSendVoid0, msgSendVoid1Ptr, msgSendVoid1I64, msgSendVoid1Bool, msgSendVoid1Float,
}
use juxu_core.{
    Candidate, emptyCandidate, candidateBadge,
    CandidateBadge, NoBadge, Shortcode, TypoCorrected, Wildcard, PinyinLookup, UserPhraseBadge, EmojiBadge,
}
use juxu_shared.{
    JuxuActionState, emptyActionState,
    CGPoint, CGSize, CGRect, cgPoint, cgSize, cgRect,
    rectContainsPoint, rectMidX, rectMidY, rectMaxX,
    nsStr, objcAllocInit,
    msgSendRect0, msgSendPoint0, msgSendPoint1Point1Ptr,
    msgSendInitFrame, msgSendVoid1Rect, msgSendVoid1Point, msgSend2Ptr,
    objcSendSuperVoid0,
    utf8ScalarCount, headScalars,
}
use macos_ffi.{
    msgSendSizeWithAttrs, msgSendTrackingAreaInit,
    roundFloat, maxFloat,
    fontWeightRegular, nsFontSystem, nsFontMonoDigit, nsFontMono, nsFontAscender, nsFontDescender,
    nsColorWhite, nsColorAlpha, nsColorLabel, nsColorSecondaryLabel, nsColorTertiaryLabel,
    nsColorQuaternaryLabel, nsColorSeparator, nsColorAccent,
    fillRoundedRect, fillHairlineRect, makeTextAttrs,
}
use floating_hud.{
    floatingPanelCreate, visibleScreenFrameForCaret, floatingPanelResolvedOrigin,
    floatingPanelUpdateLevel, floatingPanelPresentWithoutAnimation, floatingPanelHideWithoutAnimation,
    hudBackdropCreate,
}

extern "objc_msgSend" def msgSendDrawAtPointAttrs(
    nsStrObj: Ptr, sel: Ptr, pt: CGPoint, attrs: Ptr
): Void

// ============================================================================
// CandidatePanelMetrics (`CandidatePanel.swift` lines 10-17)
// ============================================================================

pub def candidateOuterCornerRadius(): Float = 11.0
pub def candidateInset(): Float = 4.0
pub def candidatePillHeight(): Float = 24.0
pub def candidatePillCornerRadius(): Float = 7.0
pub def candidateBarHeight(): Float = 32.0

// ============================================================================
// Badge Marker Stripping & Annotation Formatting (`CandidatePanel.swift` lines 112-136)
// ============================================================================

def removeSubstringAll(s: String, marker: String): String = {
    let mLen = strLen(marker);
    let n = strLen(s);
    if (mLen == 0 || n < mLen) s
    else {
        let out = bufWithCap(n);
        let i = cellNew(0);
        while (cellGet(i) < n) {
            let idx = cellGet(i);
            if (idx + mLen <= n && strSlice(s, idx, idx + mLen) == marker) {
                cellSet(i, idx + mLen)
            } else {
                bufPushByte(out, strByteAt(s, idx));
                cellSet(i, idx + 1)
            }
        };
        bufToString(out)
    }
}

def stripBadgeMarkers(s: String): String = {
    let s1 = removeSubstringAll(s, "⚡");
    let s2 = removeSubstringAll(s1, "⌖");
    let s3 = removeSubstringAll(s2, "⟲");
    let s4 = removeSubstringAll(s3, "⇄");
    let s5 = removeSubstringAll(s4, "⎵");
    strTrim(s5)
}

/// Format clean secondary code annotation (`CandidatePanel.swift` `cleanAnnotation(for:)`):
/// - `.shortcode`: strips `⚡` -> `"k"`
/// - `.typoCorrected`: keeps rescued code before `' '` and strips `⌖` -> `"trwu"`
/// - `.pinyinLookup` / `.wildcard`: strips markers -> `"fp · fpi (guō)"`
/// - `.userPhrase` / `.emoji` / `.none`: `""`
pub def cleanCandidateAnnotation(item: Candidate): String =
    if (strLen(item.comment) == 0) ""
    else match candidateBadge(item) {
        Shortcode -> stripBadgeMarkers(item.comment),
        TypoCorrected -> {
            let raw = match strIndexOfByte(item.comment, 32, 0) {
                Some(spIdx) -> strSlice(item.comment, 0, spIdx),
                None -> item.comment,
            };
            stripBadgeMarkers(raw)
        },
        PinyinLookup -> stripBadgeMarkers(item.comment),
        Wildcard -> stripBadgeMarkers(item.comment),
        UserPhraseBadge -> "",
        EmojiBadge -> "",
        NoBadge -> "",
    }

// ============================================================================
// Per-Instance NativeCandidateContentView State & Layout
// ============================================================================

data CellLayout {
    clRelIndex: Int,
    clRect: CGRect,
    clNumberStr: String,
    clNumberOrigin: CGPoint,
    clTextStr: String,
    clTextOrigin: CGPoint,
    clNoteStr: String,
    clNoteOrigin: CGPoint,
}

data CandidateViewState {
    cvsState: Cell JuxuActionState,
    cvsMaxAllowedWidth: Cell Float,
    cvsOnSelect: Cell (Option (Int -> Void)),
    cvsOnTurnPage: Cell (Option (Int -> Void)),
    cvsCellLayouts: Vec CellLayout,
    cvsPrevPageRect: Cell CGRect,
    cvsNextPageRect: Cell CGRect,
    cvsDividerRect: Cell CGRect,
    cvsHoveredIndex: Cell (Option Int),
    cvsTrackingArea: Cell Ptr,
    cvsLayoutValid: Cell Bool,
    cvsCachedSize: Cell CGSize,
}

def gCandidateViewKey: Cell Ptr = cellNew(ptrNull())

def candidateViewAssocKey(): Ptr = {
    let k = cellGet(gCandidateViewKey);
    if (!ptrIsNull(k)) k
    else {
        let nk = ptrAllocBytes(8);
        cellSet(gCandidateViewKey, nk);
        nk
    }
}

def getOrCreateCandidateViewState(view: Ptr): CandidateViewState = {
    let h = objcGetAssocHandle(view, candidateViewAssocKey());
    if (h != intToI64(0)) {
        gcHandleGet(h)
    } else {
        let zRect = cgRect(0.0, 0.0, 0.0, 0.0);
        let st = CandidateViewState {
            cvsState: cellNew(emptyActionState()),
            cvsMaxAllowedWidth: cellNew(1200.0),
            cvsOnSelect: cellNew(None),
            cvsOnTurnPage: cellNew(None),
            cvsCellLayouts: vecNew(),
            cvsPrevPageRect: cellNew(zRect),
            cvsNextPageRect: cellNew(zRect),
            cvsDividerRect: cellNew(zRect),
            cvsHoveredIndex: cellNew(None),
            cvsTrackingArea: cellNew(ptrNull()),
            cvsLayoutValid: cellNew(false),
            cvsCachedSize: cellNew(cgSize(0.0, 0.0)),
        };
        objcSetAssocHandle(view, candidateViewAssocKey(), gcHandleNew(st));
        st
    }
}

def replaceNewlinesWithSpaces(s: String): String = {
    let n = strLen(s);
    let out = bufWithCap(n);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let b = strByteAt(s, cellGet(i));
        bufPushByte(out, if (b == 10 || b == 13) 32 else b);
        cellSet(i, cellGet(i) + 1)
    };
    bufToString(out)
}

def makeTruncatedParaAttrs(font: Ptr, color: Ptr): Ptr = {
    let style = objcAllocInit("NSMutableParagraphStyle");
    // NSLineBreakByTruncatingTail = 4
    msgSendVoid1I64(style, objcSel("setLineBreakMode:"), intToI64(4));
    let maxLineH = ceil(nsFontAscender(font) - nsFontDescender(font)) + 2.0;
    msgSendVoid1Float(style, objcSel("setMaximumLineHeight:"), maxLineH);

    let d = makeTextAttrs(font, color);
    let _ = msgSend2Ptr(d, objcSel("setObject:forKey:"), style, nsStr("NSParagraphStyle"));
    objcReleaseRaw(style);
    d
}

/// Binary-search single-line tail truncation (`makeSingleLineTruncated`, lines 138-176).
def truncateSingleLineText(
    rawText: String,
    font: Ptr,
    color: Ptr,
    maxWidth: Float
): (String, CGSize) = {
    let cleanStr = replaceNewlinesWithSpaces(rawText);
    let baseAttrs = makeTruncatedParaAttrs(font, color);
    let fullSz = msgSendSizeWithAttrs(nsStr(cleanStr), objcSel("sizeWithAttributes:"), baseAttrs);
    let charCnt = utf8ScalarCount(cleanStr);
    if (fullSz.width <= maxWidth || charCnt <= 1) {
        (cleanStr, fullSz)
    } else {
        let low = cellNew(1);
        let high = cellNew(charCnt - 1);
        let initCand = headScalars(cleanStr, 1) + "…";
        let bestStr = cellNew(initCand);
        let bestSz = cellNew(msgSendSizeWithAttrs(nsStr(initCand), objcSel("sizeWithAttributes:"), baseAttrs));
        while (cellGet(low) <= cellGet(high)) {
            let mid = (cellGet(low) + cellGet(high)) / 2;
            let cand = headScalars(cleanStr, mid) + "…";
            let sz = msgSendSizeWithAttrs(nsStr(cand), objcSel("sizeWithAttributes:"), baseAttrs);
            if (sz.width <= maxWidth) {
                cellSet(bestStr, cand);
                cellSet(bestSz, sz);
                cellSet(low, mid + 1)
            } else {
                cellSet(high, mid - 1)
            }
        };
        (cellGet(bestStr), cellGet(bestSz))
    }
}

def computeHorizontalLayout(cvs: CandidateViewState, apply: Bool): CGSize = {
    let st = cellGet(cvs.cvsState);
    let maxAllowedW = cellGet(cvs.cvsMaxAllowedWidth);
    let barH = candidateBarHeight();
    let outerX = candidateInset();
    let pillY = candidateInset();
    let pillH = candidatePillHeight();
    let cellPadLeft = 7.5;
    let cellPadRight = 8.0;
    let cellGap = 1.5;

    let numFont = nsFontMonoDigit(12.0, fontWeightRegular());
    let textFont = nsFontSystem(16.0, fontWeightRegular());
    let noteFont = nsFontMono(11.5, fontWeightRegular());
    let measureColor = nsColorLabel();

    let hasPager = st.asTotalPages > 1;
    let pagerReserve = if (hasPager) 42.0 else 0.0;
    let maxSingleTextW = maxFloat(96.0, (maxAllowedW - pagerReserve - outerX * 2.0) * 0.45);
    let zRect = cgRect(0.0, 0.0, 0.0, 0.0);

    let n = vecLen(st.asCandidates);
    if (n == 0) {
        let emptyAttrs = makeTextAttrs(textFont, nsColorSecondaryLabel());
        let sz = msgSendSizeWithAttrs(nsStr(st.asPreedit), objcSel("sizeWithAttributes:"), emptyAttrs);
        let w = maxFloat(56.0, ceil(outerX * 2.0 + cellPadLeft + sz.width + cellPadRight));
        if (apply) {
            vecClear(cvs.cvsCellLayouts);
            vecPush(cvs.cvsCellLayouts, CellLayout {
                clRelIndex: -1,
                clRect: cgRect(outerX, pillY, w - outerX * 2.0, pillH),
                clNumberStr: "",
                clNumberOrigin: cgPoint(0.0, 0.0),
                clTextStr: st.asPreedit,
                clTextOrigin: cgPoint(outerX + cellPadLeft, roundFloat((barH - sz.height) * 0.5)),
                clNoteStr: "",
                clNoteOrigin: cgPoint(0.0, 0.0),
            });
            cellSet(cvs.cvsDividerRect, zRect);
            cellSet(cvs.cvsPrevPageRect, zRect);
            cellSet(cvs.cvsNextPageRect, zRect)
        } else ();
        cgSize(w, barH)
    } else {
        let layouts: Vec CellLayout = vecWithCap(n);
        let cursorX = cellNew(outerX);
        let numAttrs = makeTextAttrs(numFont, measureColor);
        let noteAttrs = makeTextAttrs(noteFont, measureColor);
        let textAsc = nsFontAscender(textFont);
        let numAsc = nsFontAscender(numFont);
        let noteAsc = nsFontAscender(noteFont);
        let dummy = emptyCandidate();

        let i = cellNew(0);
        let stop = cellNew(false);
        while (cellGet(i) < n && !cellGet(stop)) {
            let idx = cellGet(i);
            let item: Candidate = vecGetOr(st.asCandidates, idx, dummy);
            let numStr = intToStr(idx + 1);
            let numSz = msgSendSizeWithAttrs(nsStr(numStr), objcSel("sizeWithAttributes:"), numAttrs);
            let (txtStr, txtSz) = truncateSingleLineText(item.text, textFont, measureColor, maxSingleTextW);
            let cleanNote = cleanCandidateAnnotation(item);
            let noteSz = if (strLen(cleanNote) == 0) cgSize(0.0, 0.0)
                         else msgSendSizeWithAttrs(nsStr(cleanNote), objcSel("sizeWithAttributes:"), noteAttrs);

            let numToTxtGap = 4.0;
            let txtToNoteGap = if (strLen(cleanNote) == 0) 0.0 else 4.0;
            let contentW = numSz.width + numToTxtGap + txtSz.width + txtToNoteGap + noteSz.width;
            let cellW = ceil(cellPadLeft + contentW + cellPadRight);

            if (idx > 0 && (cellGet(cursorX) + cellW + pagerReserve + outerX > maxAllowedW)) {
                cellSet(stop, true)
            } else {
                let cx = cellGet(cursorX);
                let cellRect = cgRect(cx, pillY, cellW, pillH);
                let txtY = (barH - txtSz.height) * 0.5 - 0.5;
                let baselineY = txtY + textAsc;
                let numY = baselineY - numAsc;
                let noteY = baselineY - noteAsc;

                let numX = cx + cellPadLeft;
                let txtX = numX + numSz.width + numToTxtGap;
                let noteX = txtX + txtSz.width + txtToNoteGap;

                vecPush(layouts, CellLayout {
                    clRelIndex: idx,
                    clRect: cellRect,
                    clNumberStr: numStr,
                    clNumberOrigin: cgPoint(numX, numY),
                    clTextStr: txtStr,
                    clTextOrigin: cgPoint(txtX, txtY),
                    clNoteStr: cleanNote,
                    clNoteOrigin: cgPoint(noteX, noteY),
                });
                cellSet(cursorX, cx + cellW + cellGap);
                cellSet(i, idx + 1)
            }
        };

        cellSet(cursorX, cellGet(cursorX) - cellGap);

        let divR = cellNew(zRect);
        let prevR = cellNew(zRect);
        let nextR = cellNew(zRect);
        if (hasPager) {
            cellSet(cursorX, cellGet(cursorX) + 3.5);
            cellSet(divR, cgRect(cellGet(cursorX), roundFloat((barH - 14.0) * 0.5), 0.5, 14.0));
            cellSet(cursorX, cellGet(cursorX) + 3.0);
            cellSet(prevR, cgRect(cellGet(cursorX), pillY, 15.0, pillH));
            cellSet(cursorX, cellGet(cursorX) + 15.0);
            cellSet(nextR, cgRect(cellGet(cursorX), pillY, 15.0, pillH));
            cellSet(cursorX, cellGet(cursorX) + 15.5)
        } else ();

        let totalW = ceil(cellGet(cursorX) + outerX);
        if (apply) {
            vecClear(cvs.cvsCellLayouts);
            let k = cellNew(0);
            let dummyCl = CellLayout {
                clRelIndex: 0,
                clRect: zRect,
                clNumberStr: "",
                clNumberOrigin: cgPoint(0.0, 0.0),
                clTextStr: "",
                clTextOrigin: cgPoint(0.0, 0.0),
                clNoteStr: "",
                clNoteOrigin: cgPoint(0.0, 0.0),
            };
            while (cellGet(k) < vecLen(layouts)) {
                vecPush(cvs.cvsCellLayouts, vecGetOr(layouts, cellGet(k), dummyCl));
                cellSet(k, cellGet(k) + 1)
            };
            cellSet(cvs.cvsDividerRect, cellGet(divR));
            cellSet(cvs.cvsPrevPageRect, cellGet(prevR));
            cellSet(cvs.cvsNextPageRect, cellGet(nextR))
        } else ();
        cgSize(maxFloat(64.0, totalW), barH)
    }
}

data VertRawRow {
    vrrNumStr: String,
    vrrNumSz: CGSize,
    vrrTxtStr: String,
    vrrTxtSz: CGSize,
    vrrNoteStr: String,
    vrrNoteSz: CGSize,
}

def computeVerticalLayout(cvs: CandidateViewState, apply: Bool): CGSize = {
    let st = cellGet(cvs.cvsState);
    let n = vecLen(st.asCandidates);
    if (n == 0) {
        computeHorizontalLayout(cvs, apply)
    } else {
        let maxAllowedW = cellGet(cvs.cvsMaxAllowedWidth);
        let outerX = candidateInset();
        let outerY = candidateInset();
        let rowH = candidatePillHeight();
        let rowGap = 1.0;
        let cellPadLeft = 8.0;
        let cellPadRight = 10.0;

        let numFont = nsFontMonoDigit(12.0, fontWeightRegular());
        let textFont = nsFontSystem(16.0, fontWeightRegular());
        let noteFont = nsFontMono(11.5, fontWeightRegular());
        let measureColor = nsColorLabel();
        let numAttrs = makeTextAttrs(numFont, measureColor);
        let noteAttrs = makeTextAttrs(noteFont, measureColor);

        let rawRows: Vec VertRawRow = vecWithCap(n);
        let maxRowW = cellNew(136.0);
        let maxTextW = maxFloat(120.0, maxAllowedW * 0.5);
        let dummy = emptyCandidate();

        let i = cellNew(0);
        while (cellGet(i) < n) {
            let idx = cellGet(i);
            let item: Candidate = vecGetOr(st.asCandidates, idx, dummy);
            let numStr = intToStr(idx + 1);
            let numSz = msgSendSizeWithAttrs(nsStr(numStr), objcSel("sizeWithAttributes:"), numAttrs);
            let (txtStr, txtSz) = truncateSingleLineText(item.text, textFont, measureColor, maxTextW);
            let cleanNote = cleanCandidateAnnotation(item);
            let noteSz = if (strLen(cleanNote) == 0) cgSize(0.0, 0.0)
                         else msgSendSizeWithAttrs(nsStr(cleanNote), objcSel("sizeWithAttributes:"), noteAttrs);

            let noteExtra = if (strLen(cleanNote) == 0) 0.0 else 12.0 + noteSz.width;
            let rowW = ceil(cellPadLeft + 14.0 + 5.0 + txtSz.width + noteExtra + cellPadRight);
            if (rowW > cellGet(maxRowW)) cellSet(maxRowW, rowW) else ();

            vecPush(rawRows, VertRawRow {
                vrrNumStr: numStr,
                vrrNumSz: numSz,
                vrrTxtStr: txtStr,
                vrrTxtSz: txtSz,
                vrrNoteStr: cleanNote,
                vrrNoteSz: noteSz,
            });
            cellSet(i, idx + 1)
        };

        let finalRowW = cellGet(maxRowW);
        let totalW = ceil(finalRowW + outerX * 2.0);
        let cursorY = cellNew(outerY);
        let textAsc = nsFontAscender(textFont);
        let numAsc = nsFontAscender(numFont);
        let noteAsc = nsFontAscender(noteFont);
        let zRect = cgRect(0.0, 0.0, 0.0, 0.0);

        if (apply) {
            vecClear(cvs.cvsCellLayouts)
        } else ();

        let dummyRaw = VertRawRow {
            vrrNumStr: "",
            vrrNumSz: cgSize(0.0, 0.0),
            vrrTxtStr: "",
            vrrTxtSz: cgSize(0.0, 0.0),
            vrrNoteStr: "",
            vrrNoteSz: cgSize(0.0, 0.0),
        };
        let j = cellNew(0);
        while (cellGet(j) < n) {
            let idx = cellGet(j);
            let entry: VertRawRow = vecGetOr(rawRows, idx, dummyRaw);
            let cy = cellGet(cursorY);
            let rect = cgRect(outerX, cy, finalRowW, rowH);
            let txtY = cy + (rowH - entry.vrrTxtSz.height) * 0.5 - 0.5;
            let baselineY = txtY + textAsc;
            let numY = baselineY - numAsc;
            let numX = outerX + cellPadLeft + (12.0 - entry.vrrNumSz.width);
            let txtX = outerX + cellPadLeft + 17.0;
            let noteOrigin =
                if (strLen(entry.vrrNoteStr) == 0) cgPoint(0.0, 0.0)
                else cgPoint(rectMaxX(rect) - cellPadRight - entry.vrrNoteSz.width, baselineY - noteAsc);

            if (apply) {
                vecPush(cvs.cvsCellLayouts, CellLayout {
                    clRelIndex: idx,
                    clRect: rect,
                    clNumberStr: entry.vrrNumStr,
                    clNumberOrigin: cgPoint(numX, numY),
                    clTextStr: entry.vrrTxtStr,
                    clTextOrigin: cgPoint(txtX, txtY),
                    clNoteStr: entry.vrrNoteStr,
                    clNoteOrigin: noteOrigin,
                })
            } else ();
            cellSet(cursorY, cy + rowH + rowGap);
            cellSet(j, idx + 1)
        };

        cellSet(cursorY, cellGet(cursorY) - rowGap);

        let divR = cellNew(zRect);
        let prevR = cellNew(zRect);
        let nextR = cellNew(zRect);
        if (st.asTotalPages > 1) {
            cellSet(cursorY, cellGet(cursorY) + 3.0);
            cellSet(divR, cgRect(outerX + 4.0, cellGet(cursorY), finalRowW - 8.0, 0.5));
            cellSet(cursorY, cellGet(cursorY) + 2.5);
            cellSet(prevR, cgRect(totalW - outerX - 34.0, cellGet(cursorY), 16.0, 18.0));
            cellSet(nextR, cgRect(totalW - outerX - 17.0, cellGet(cursorY), 16.0, 18.0));
            cellSet(cursorY, cellGet(cursorY) + 18.0)
        } else ();

        let totalH = ceil(cellGet(cursorY) + outerY);
        if (apply) {
            cellSet(cvs.cvsDividerRect, cellGet(divR));
            cellSet(cvs.cvsPrevPageRect, cellGet(prevR));
            cellSet(cvs.cvsNextPageRect, cellGet(nextR))
        } else ();
        cgSize(totalW, totalH)
    }
}

pub def candidateViewComputeFittingSize(view: Ptr): CGSize =
    if (ptrIsNull(view)) cgSize(0.0, candidateBarHeight())
    else {
        let cvs = getOrCreateCandidateViewState(view);
        if (!cellGet(cvs.cvsLayoutValid)) {
            let st = cellGet(cvs.cvsState);
            let sz =
                if (st.asVertical) computeVerticalLayout(cvs, true)
                else computeHorizontalLayout(cvs, true);
            cellSet(cvs.cvsCachedSize, sz);
            cellSet(cvs.cvsLayoutValid, true);
            sz
        } else {
            cellGet(cvs.cvsCachedSize)
        }
    }

// ============================================================================
// Crisp Retina Drawing (`CandidatePanel.swift` lines 416-481)
// ============================================================================

def drawChevron(up: Bool, rect: CGRect, enabled: Bool): Void = {
    let col = if (enabled) nsColorSecondaryLabel() else nsColorQuaternaryLabel();
    let path = msgSend0(objcClass("NSBezierPath"), objcSel("bezierPath"));
    let cx = rectMidX(rect);
    let cy = rectMidY(rect);
    let halfW = 3.4;
    let halfH = 1.9;
    if (up) {
        msgSendVoid1Point(path, objcSel("moveToPoint:"), cgPoint(cx - halfW, cy + halfH));
        msgSendVoid1Point(path, objcSel("lineToPoint:"), cgPoint(cx, cy - halfH));
        msgSendVoid1Point(path, objcSel("lineToPoint:"), cgPoint(cx + halfW, cy + halfH))
    } else {
        msgSendVoid1Point(path, objcSel("moveToPoint:"), cgPoint(cx - halfW, cy - halfH));
        msgSendVoid1Point(path, objcSel("lineToPoint:"), cgPoint(cx, cy + halfH));
        msgSendVoid1Point(path, objcSel("lineToPoint:"), cgPoint(cx + halfW, cy - halfH))
    };
    msgSendVoid1Float(path, objcSel("setLineWidth:"), 1.25);
    // NSLineCapStyleRound = 1, NSLineJoinStyleRound = 1
    msgSendVoid1I64(path, objcSel("setLineCapStyle:"), intToI64(1));
    msgSendVoid1I64(path, objcSel("setLineJoinStyle:"), intToI64(1));
    msgSendVoid0(col, objcSel("setStroke"));
    msgSendVoid0(path, objcSel("stroke"))
}

def candidateViewDrawRect(self: Ptr, _cmd: Ptr, _dirty: CGRect): Void = {
    let _ = candidateViewComputeFittingSize(self);
    let cvs = getOrCreateCandidateViewState(self);
    let st = cellGet(cvs.cvsState);
    let hoveredOpt = cellGet(cvs.cvsHoveredIndex);

    let numFont = nsFontMonoDigit(12.0, fontWeightRegular());
    let textFont = nsFontSystem(16.0, fontWeightRegular());
    let noteFont = nsFontMono(11.5, fontWeightRegular());

    let accent = nsColorAccent();
    let white = nsColorWhite();
    let selNumAttrs = makeTextAttrs(numFont, nsColorAlpha(white, 0.84));
    let selTxtAttrs = makeTextAttrs(textFont, white);
    let selNoteAttrs = makeTextAttrs(noteFont, nsColorAlpha(white, 0.76));

    let normNumAttrs = makeTextAttrs(numFont, nsColorTertiaryLabel());
    let normTxtAttrs = makeTextAttrs(textFont, nsColorLabel());
    let normNoteAttrs = makeTextAttrs(noteFont, nsColorSecondaryLabel());
    let emptyTxtAttrs = makeTextAttrs(textFont, nsColorSecondaryLabel());
    let hoverFill = nsColorAlpha(nsColorLabel(), 0.07);

    let zRect = cgRect(0.0, 0.0, 0.0, 0.0);
    let dummyCl = CellLayout {
        clRelIndex: 0,
        clRect: zRect,
        clNumberStr: "",
        clNumberOrigin: cgPoint(0.0, 0.0),
        clTextStr: "",
        clTextOrigin: cgPoint(0.0, 0.0),
        clNoteStr: "",
        clNoteOrigin: cgPoint(0.0, 0.0),
    };

    let n = vecLen(cvs.cvsCellLayouts);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let cell: CellLayout = vecGetOr(cvs.cvsCellLayouts, cellGet(i), dummyCl);
        if (cell.clRelIndex == 0) {
            fillRoundedRect(cell.clRect, candidatePillCornerRadius(), accent)
        } else if (cell.clRelIndex >= 0) {
            let isHov = match hoveredOpt {
                Some(hIdx) -> hIdx == cell.clRelIndex,
                None -> false,
            };
            if (isHov) {
                fillRoundedRect(cell.clRect, candidatePillCornerRadius(), hoverFill)
            } else ()
        } else ();

        let isSel = cell.clRelIndex == 0;
        let numA = if (isSel) selNumAttrs else normNumAttrs;
        let txtA = if (cell.clRelIndex < 0) emptyTxtAttrs else if (isSel) selTxtAttrs else normTxtAttrs;
        let noteA = if (isSel) selNoteAttrs else normNoteAttrs;

        if (strLen(cell.clNumberStr) > 0) {
            msgSendDrawAtPointAttrs(nsStr(cell.clNumberStr), objcSel("drawAtPoint:withAttributes:"), cell.clNumberOrigin, numA)
        } else ();
        if (strLen(cell.clTextStr) > 0) {
            msgSendDrawAtPointAttrs(nsStr(cell.clTextStr), objcSel("drawAtPoint:withAttributes:"), cell.clTextOrigin, txtA)
        } else ();
        if (strLen(cell.clNoteStr) > 0) {
            msgSendDrawAtPointAttrs(nsStr(cell.clNoteStr), objcSel("drawAtPoint:withAttributes:"), cell.clNoteOrigin, noteA)
        } else ();

        cellSet(i, cellGet(i) + 1)
    };

    let divR = cellGet(cvs.cvsDividerRect);
    if (divR.size.width > 0.0 && divR.size.height > 0.0) {
        fillHairlineRect(divR, nsColorSeparator())
    } else ();

    let prevR = cellGet(cvs.cvsPrevPageRect);
    if (prevR.size.width > 0.0 && prevR.size.height > 0.0) {
        drawChevron(true, prevR, st.asPage > 0)
    } else ();

    let nextR = cellGet(cvs.cvsNextPageRect);
    if (nextR.size.width > 0.0 && nextR.size.height > 0.0) {
        drawChevron(false, nextR, st.asPage + 1 < st.asTotalPages)
    } else ()
}

// ============================================================================
// Mouse Hover, Tracking Areas & Click Selection (`CandidatePanel.swift` lines 74-88, 485-516)
// ============================================================================

def candidateViewIsFlipped(_self: Ptr, _cmd: Ptr): Bool = true

def candidateViewIntrinsicContentSize(self: Ptr, _cmd: Ptr): CGSize =
    candidateViewComputeFittingSize(self)

def candidateViewLayout(self: Ptr, cmd: Ptr): Void = {
    objcSendSuperVoid0(self, "NSView", cmd);
    let _ = candidateViewComputeFittingSize(self);
    ()
}

def candidateViewUpdateTrackingAreas(self: Ptr, cmd: Ptr): Void = {
    objcSendSuperVoid0(self, "NSView", cmd);
    let cvs = getOrCreateCandidateViewState(self);
    let oldArea = cellGet(cvs.cvsTrackingArea);
    if (!ptrIsNull(oldArea)) {
        msgSendVoid1Ptr(self, objcSel("removeTrackingArea:"), oldArea);
        objcReleaseRaw(oldArea);
        cellSet(cvs.cvsTrackingArea, ptrNull())
    } else ();
    let bounds = msgSendRect0(self, objcSel("bounds"));
    // [.mouseMoved, .mouseEnteredAndExited, .activeAlways, .inVisibleRect] = 0x283
    let area = msgSendTrackingAreaInit(
        msgSend0(objcClass("NSTrackingArea"), objcSel("alloc")),
        objcSel("initWithRect:options:owner:userInfo:"),
        bounds,
        intToI64(0x283),
        self,
        ptrNull()
    );
    if (!ptrIsNull(area)) {
        msgSendVoid1Ptr(self, objcSel("addTrackingArea:"), area);
        cellSet(cvs.cvsTrackingArea, area)
    } else ()
}

def hitTestCandidateCell(cvs: CandidateViewState, pt: CGPoint): Option Int = {
    let n = vecLen(cvs.cvsCellLayouts);
    let zRect = cgRect(0.0, 0.0, 0.0, 0.0);
    let dummyCl = CellLayout {
        clRelIndex: -1,
        clRect: zRect,
        clNumberStr: "",
        clNumberOrigin: cgPoint(0.0, 0.0),
        clTextStr: "",
        clTextOrigin: cgPoint(0.0, 0.0),
        clNoteStr: "",
        clNoteOrigin: cgPoint(0.0, 0.0),
    };
    let i = cellNew(0);
    let hit: Cell (Option Int) = cellNew(None);
    while (cellGet(i) < n && match cellGet(hit) { None -> true, Some(_) -> false }) {
        let cl: CellLayout = vecGetOr(cvs.cvsCellLayouts, cellGet(i), dummyCl);
        if (cl.clRelIndex >= 0 && rectContainsPoint(cl.clRect, pt)) {
            cellSet(hit, Some(cl.clRelIndex))
        } else ();
        cellSet(i, cellGet(i) + 1)
    };
    cellGet(hit)
}

def optIntEq(a: Option Int, b: Option Int): Bool =
    match a {
        None -> match b { None -> true, Some(_) -> false },
        Some(va) -> match b { None -> false, Some(vb) -> va == vb },
    }

def candidateViewMouseMoved(self: Ptr, _cmd: Ptr, event: Ptr): Void =
    if (!ptrIsNull(event)) {
        let cvs = getOrCreateCandidateViewState(self);
        let winPt = msgSendPoint0(event, objcSel("locationInWindow"));
        let pt = msgSendPoint1Point1Ptr(self, objcSel("convertPoint:fromView:"), winPt, ptrNull());
        let hit = hitTestCandidateCell(cvs, pt);
        if (!optIntEq(hit, cellGet(cvs.cvsHoveredIndex))) {
            cellSet(cvs.cvsHoveredIndex, hit);
            msgSendVoid1Bool(self, objcSel("setNeedsDisplay:"), true)
        } else ()
    } else ()

def candidateViewMouseExited(self: Ptr, _cmd: Ptr, _event: Ptr): Void = {
    let cvs = getOrCreateCandidateViewState(self);
    match cellGet(cvs.cvsHoveredIndex) {
        Some(_) -> {
            cellSet(cvs.cvsHoveredIndex, None);
            msgSendVoid1Bool(self, objcSel("setNeedsDisplay:"), true)
        },
        None -> (),
    }
}

def candidateViewMouseDown(self: Ptr, _cmd: Ptr, event: Ptr): Void =
    if (!ptrIsNull(event)) {
        let cvs = getOrCreateCandidateViewState(self);
        let st = cellGet(cvs.cvsState);
        let winPt = msgSendPoint0(event, objcSel("locationInWindow"));
        let pt = msgSendPoint1Point1Ptr(self, objcSel("convertPoint:fromView:"), winPt, ptrNull());
        match hitTestCandidateCell(cvs, pt) {
            Some(relIdx) -> match cellGet(cvs.cvsOnSelect) {
                Some(cb) -> cb(relIdx),
                None -> (),
            },
            None ->
                if (rectContainsPoint(cellGet(cvs.cvsPrevPageRect), pt) && st.asPage > 0) {
                    match cellGet(cvs.cvsOnTurnPage) {
                        Some(cb) -> cb(-1),
                        None -> (),
                    }
                } else if (rectContainsPoint(cellGet(cvs.cvsNextPageRect), pt) && st.asPage + 1 < st.asTotalPages) {
                    match cellGet(cvs.cvsOnTurnPage) {
                        Some(cb) -> cb(1),
                        None -> (),
                    }
                } else (),
        }
    } else ()

extern init(100) def registerCandidateViewClass(): Void = {
    let cls = objcAllocateClass("NSView", "NativeCandidateContentView");
    if (!ptrIsNull(cls)) {
        let _ = objcAddMethod(cls, "isFlipped", cFnPtr(candidateViewIsFlipped), "B@:");
        let _ = objcAddMethod(cls, "intrinsicContentSize", cFnPtr(candidateViewIntrinsicContentSize), "{CGSize=dd}@:");
        let _ = objcAddMethod(cls, "layout", cFnPtr(candidateViewLayout), "v@:");
        let _ = objcAddMethod(cls, "updateTrackingAreas", cFnPtr(candidateViewUpdateTrackingAreas), "v@:");
        let _ = objcAddMethod(cls, "drawRect:", cFnPtr(candidateViewDrawRect), "v@:{CGRect={CGPoint=dd}{CGSize=dd}}");
        let _ = objcAddMethod(cls, "mouseMoved:", cFnPtr(candidateViewMouseMoved), "v@:@");
        let _ = objcAddMethod(cls, "mouseExited:", cFnPtr(candidateViewMouseExited), "v@:@");
        let _ = objcAddMethod(cls, "mouseDown:", cFnPtr(candidateViewMouseDown), "v@:@");
        objcRegisterClass(cls)
    } else ()
}

// ============================================================================
// Public NativeCandidateContentView & CandidateBarView API
// ============================================================================

pub def candidateViewCreate(frame: CGRect): Ptr = {
    let v = msgSendInitFrame(
        msgSend0(objcClass("NativeCandidateContentView"), objcSel("alloc")),
        objcSel("initWithFrame:"),
        frame
    );
    msgSendVoid1Bool(v, objcSel("setWantsLayer:"), true);
    let _ = getOrCreateCandidateViewState(v);
    v
}

pub def candidateViewSetState(view: Ptr, st: JuxuActionState): Void =
    if (!ptrIsNull(view)) {
        let cvs = getOrCreateCandidateViewState(view);
        cellSet(cvs.cvsState, st);
        cellSet(cvs.cvsHoveredIndex, None);
        cellSet(cvs.cvsLayoutValid, false);
        msgSendVoid0(view, objcSel("invalidateIntrinsicContentSize"));
        msgSendVoid1Bool(view, objcSel("setNeedsLayout:"), true);
        msgSendVoid1Bool(view, objcSel("setNeedsDisplay:"), true)
    } else ()

pub def candidateViewSetMaxAllowedWidth(view: Ptr, maxW: Float): Void =
    if (!ptrIsNull(view)) {
        let cvs = getOrCreateCandidateViewState(view);
        if (cellGet(cvs.cvsMaxAllowedWidth) != maxW) {
            cellSet(cvs.cvsMaxAllowedWidth, maxW);
            cellSet(cvs.cvsLayoutValid, false);
            msgSendVoid0(view, objcSel("invalidateIntrinsicContentSize"));
            msgSendVoid1Bool(view, objcSel("setNeedsLayout:"), true);
            msgSendVoid1Bool(view, objcSel("setNeedsDisplay:"), true)
        } else ()
    } else ()

pub def candidateViewSetCallbacks(
    view: Ptr,
    onSelectOpt: Option (Int -> Void),
    onPageOpt: Option (Int -> Void)
): Void =
    if (!ptrIsNull(view)) {
        let cvs = getOrCreateCandidateViewState(view);
        cellSet(cvs.cvsOnSelect, onSelectOpt);
        cellSet(cvs.cvsOnTurnPage, onPageOpt)
    } else ()

/// Standalone `CandidateBarView` (`HUDBackdropView` `.withinWindow` + `NativeCandidateContentView`)
/// for Settings live preview & `--render-previews`; returns `(backdropView, candidateView, fittingSize)`.
pub def candidateBarCreate(
    st: JuxuActionState,
    onSelectOpt: Option (Int -> Void),
    onPageOpt: Option (Int -> Void)
): (Ptr, Ptr, CGSize) = {
    let initRect = cgRect(0.0, 0.0, 200.0, candidateBarHeight());
    // blendingMode: .withinWindow = 1
    let (backdrop, container) = hudBackdropCreate(initRect, candidateOuterCornerRadius(), intToI64(1), true);
    let content = candidateViewCreate(initRect);
    msgSendVoid1I64(content, objcSel("setAutoresizingMask:"), intToI64(18));
    msgSendVoid1Ptr(container, objcSel("addSubview:"), content);
    candidateViewSetCallbacks(content, onSelectOpt, onPageOpt);
    candidateViewSetState(content, st);
    let sz = candidateViewComputeFittingSize(content);
    msgSendVoid1Rect(backdrop, objcSel("setFrame:"), cgRect(0.0, 0.0, sz.width, sz.height));
    msgSendVoid1Rect(content, objcSel("setFrame:"), cgRect(0.0, 0.0, sz.width, sz.height));
    msgSendVoid0(backdrop, objcSel("layoutSubtreeIfNeeded"));
    (backdrop, content, sz)
}

// ============================================================================
// CandidatePanelController Singleton (`CandidatePanel.swift` lines 566-632)
// ============================================================================

def gCandPanel: Cell Ptr = cellNew(ptrNull())
def gCandEffectView: Cell Ptr = cellNew(ptrNull())
def gCandContentView: Cell Ptr = cellNew(ptrNull())
def gCandOnSelect: Cell (Option (Int -> Void)) = cellNew(None)
def gCandOnPage: Cell (Option (Int -> Void)) = cellNew(None)

def ensureCandidatePanel(): (Ptr, Ptr, Ptr) = {
    let existing = cellGet(gCandPanel);
    if (!ptrIsNull(existing)) {
        (existing, cellGet(gCandEffectView), cellGet(gCandContentView))
    } else {
        let initRect = cgRect(0.0, 0.0, 200.0, candidateBarHeight());
        // blendingMode: .behindWindow = 0
        let (effect, container) = hudBackdropCreate(initRect, candidateOuterCornerRadius(), intToI64(0), true);
        let content = candidateViewCreate(initRect);
        msgSendVoid1I64(content, objcSel("setAutoresizingMask:"), intToI64(18));
        msgSendVoid1Ptr(container, objcSel("addSubview:"), content);
        candidateViewSetCallbacks(content, cellGet(gCandOnSelect), cellGet(gCandOnPage));

        let p = floatingPanelCreate(initRect, true, false);
        msgSendVoid1Ptr(p, objcSel("setContentView:"), effect);

        cellSet(gCandPanel, p);
        cellSet(gCandEffectView, effect);
        cellSet(gCandContentView, content);
        (p, effect, content)
    }
}

pub def candidatePanelSetOnSelect(cb: Int -> Void): Void = {
    cellSet(gCandOnSelect, Some(cb));
    let v = cellGet(gCandContentView);
    if (!ptrIsNull(v)) {
        candidateViewSetCallbacks(v, cellGet(gCandOnSelect), cellGet(gCandOnPage))
    } else ()
}

pub def candidatePanelSetOnPage(cb: Int -> Void): Void = {
    cellSet(gCandOnPage, Some(cb));
    let v = cellGet(gCandContentView);
    if (!ptrIsNull(v)) {
        candidateViewSetCallbacks(v, cellGet(gCandOnSelect), cellGet(gCandOnPage))
    } else ()
}

/// `CandidatePanelController.shared.update(state:caretRect:clientWindowLevel:)` (`CandidatePanel.swift` lines 598-627).
pub def candidatePanelUpdateState(
    st: JuxuActionState,
    caretRect: CGRect,
    clientWindowLevelOpt: Option Int64
): Void =
    if (strLen(st.asPreedit) == 0 || (vecLen(st.asCandidates) == 0 && strLen(st.asSegmentedCode) > 0)) {
        candidatePanelHide()
    } else {
        let (panel, effectView, contentView) = ensureCandidatePanel();
        let visible = visibleScreenFrameForCaret(caretRect);
        candidateViewSetMaxAllowedWidth(contentView, maxFloat(240.0, visible.size.width - 24.0));
        candidateViewSetState(contentView, st);
        let sz = candidateViewComputeFittingSize(contentView);

        let origin = floatingPanelResolvedOrigin(sz, caretRect, Some(visible), 5.0, 6.0, 8.0);
        floatingPanelUpdateLevel(panel, clientWindowLevelOpt);

        let targetFrame = cgRect(origin.x, origin.y, sz.width, sz.height);
        floatingPanelPresentWithoutAnimation(panel, targetFrame, () -> {
            msgSendVoid1Rect(contentView, objcSel("setFrame:"), cgRect(0.0, 0.0, sz.width, sz.height));
            msgSendVoid0(effectView, objcSel("layoutSubtreeIfNeeded"));
            msgSendVoid0(contentView, objcSel("layout"));
            msgSendVoid0(contentView, objcSel("displayIfNeeded"))
        })
    }

pub def candidatePanelHide(): Void =
    floatingPanelHideWithoutAnimation(cellGet(gCandPanel))
