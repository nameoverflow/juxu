/// 1:1 port of `Sources/FloatingHUDPanel.swift` (193 lines) + `ModeIndicatorPanelController`
/// (`Sources/CandidatePanel.swift` lines 634-719):
/// - `FloatingHUDPanel` (`borderless | nonactivatingPanel`, `.floatingWindow + 2`, `animationBehavior = .none`,
///   `hidesOnDeactivate = false`, `worksWhenModal = true`, `collectionBehavior = [.canJoinAllSpaces, .fullScreenAuxiliary, .transient, .ignoresCycle]`)
/// - `HUDBackdropView` (`NSGlassEffectView` Liquid Glass on macOS 26+ with `NSVisualEffectView` `.menu` + 0.5pt hairline border fallback)
/// - Caret positioning & screen clamping (`visibleScreenFrameForCaret`, `floatingPanelResolvedOrigin`)
/// - Zero-animation `CATransaction.setDisableActions(true)` + `NSAnimationContext` presentation
/// - `ModeIndicatorPanelController` (`34x30` pill, `10pt` radius, `14pt` PingFangSC-Medium, `0.85s` auto-hide).

use std.option.{Option, Some, None}
use objc.{
    objcClass, objcSel, objcAllocateClass, objcAddMethod, objcRegisterClass,
    objcSetAssocHandle, objcGetAssocHandle,
    msgSend0, msgSendBool0, msgSendI64_0,
    msgSendVoid0, msgSendVoid1Ptr, msgSendVoid1I64, msgSendVoid1Bool, msgSendVoid1Float,
}
use juxu_shared.{
    CGPoint, CGSize, CGRect, cgPoint, cgSize, cgRect,
    rectContainsPoint, rectIntersectsRect,
    msgSendRect0, msgSendSize0, msgSendInitFrame, msgSend1Rect1U64_1I64_1Bool, msgSend1I64_1Ptr,
    msgSendVoid1Rect, objcSendSuperVoid0, dispatchMainAfterMs,
}
use macos_ffi.{
    floatingWindowBaseLevel, objcSendSuperVoid1Size, layerSetContinuousCorner, layerSetBorderRgba,
    msgSendSetFrameDisplayAnimate, msgSendDrawAtPoint,
    roundFloat, maxFloat,
    fontWeightMedium, nsFontNamedOrSystem,
    nsColorClear, nsColorLabel, makeTextAttrs, makeAttrString,
    viewIsDarkAppearance, mouseScreenLocation,
}

