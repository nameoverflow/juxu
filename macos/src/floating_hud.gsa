// ModeIndicatorContentView & ModeIndicatorPanelController (`CandidatePanel.swift` lines 634-719)
// ============================================================================

def modeIndicatorCornerRadius(): Float = 10.0
def modeIndicatorPanelSize(): CGSize = cgSize(34.0, 30.0)
def modeIndicatorAutoHideMs(): Int = 850

def gModePanel: Cell Ptr = cellNew(ptrNull())
def gModeView: Cell Ptr = cellNew(ptrNull())
def gModeLabel: Cell String = cellNew("中")
def gModeHideGen: Cell Int64 = cellNew(intToI64(0))

def modeIndicatorIsFlipped(_self: Ptr, _cmd: Ptr): Bool = true

def modeIndicatorDrawRect(self: Ptr, _cmd: Ptr, _dirty: CGRect): Void = {
    let bounds = msgSendRect0(self, objcSel("bounds"));
    let font = nsFontNamedOrSystem("PingFangSC-Medium", 14.0, fontWeightMedium());
    let attrs = makeTextAttrs(font, nsColorLabel());
    let attrStr = makeAttrString(cellGet(gModeLabel), attrs);
    let textSz = msgSendSize0(attrStr, objcSel("size"));
    let origin = cgPoint(
        roundFloat((bounds.size.width - textSz.width) * 0.5),
        roundFloat((bounds.size.height - textSz.height) * 0.5)
    );
    msgSendDrawAtPoint(attrStr, objcSel("drawAtPoint:"), origin)
}

extern init(103) def registerFloatingHudClasses(): Void = {
    let bdCls = objcAllocateClass("NSView", "JuxuHudBackdropView");
    if (!ptrIsNull(bdCls)) {
        let _ = objcAddMethod(bdCls, "isFlipped", cFnPtr(modeIndicatorIsFlipped), "B@:");
        let _ = objcAddMethod(bdCls, "layout", cFnPtr(hudBackdropLayout), "v@:");
        let _ = objcAddMethod(bdCls, "resizeSubviewsWithOldSize:", cFnPtr(hudBackdropResizeSubviews), "v@:{CGSize=dd}");
        let _ = objcAddMethod(
            bdCls,
            "viewDidChangeEffectiveAppearance",
            cFnPtr(hudBackdropDidChangeEffectiveAppearance),
            "v@:"
        );
        objcRegisterClass(bdCls)
    } else ();

    let miCls = objcAllocateClass("NSView", "JuxuModeIndicatorView");
    if (!ptrIsNull(miCls)) {
        let _ = objcAddMethod(miCls, "isFlipped", cFnPtr(modeIndicatorIsFlipped), "B@:");
        let _ = objcAddMethod(miCls, "drawRect:", cFnPtr(modeIndicatorDrawRect), "v@:{CGRect={CGPoint=dd}{CGSize=dd}}");
        objcRegisterClass(miCls)
    } else ()
}

def ensureModeIndicatorPanel(): (Ptr, Ptr) = {
    let existing = cellGet(gModePanel);
    if (!ptrIsNull(existing)) (existing, cellGet(gModeView))
    else {
        let sz = modeIndicatorPanelSize();
        let initRect = cgRect(0.0, 0.0, sz.width, sz.height);
        let (effect, container) = hudBackdropCreate(initRect, modeIndicatorCornerRadius(), intToI64(0), true);
        let content = msgSendInitFrame(
            msgSend0(objcClass("JuxuModeIndicatorView"), objcSel("alloc")),
            objcSel("initWithFrame:"),
            cgRect(0.0, 0.0, sz.width, sz.height)
        );
        msgSendVoid1I64(content, objcSel("setAutoresizingMask:"), intToI64(18));
        msgSendVoid1Ptr(container, objcSel("addSubview:"), content);

        let p = floatingPanelCreate(initRect, true, true);
        msgSendVoid1Ptr(p, objcSel("setContentView:"), effect);
        cellSet(gModePanel, p);
        cellSet(gModeView, content);
        (p, content)
    }
}

/// Show the mode indicator (`"中"` or `"英"`) anchored to `caretRect` and auto-hide after `0.85s`.
pub def modeIndicatorShow(
    asciiMode: Bool,
    caretRect: CGRect,
    clientWindowLevelOpt: Option Int64
): Void = {
    let text = if (asciiMode) "英" else "中";
    modeIndicatorShowLabel(text, caretRect, clientWindowLevelOpt)
}

pub def modeIndicatorShowLabel(
    label: String,
    caretRect: CGRect,
    clientWindowLevelOpt: Option Int64
): Void = {
    let gen = cellGet(gModeHideGen) + intToI64(1);
    cellSet(gModeHideGen, gen);

    let (panel, content) = ensureModeIndicatorPanel();
    let sz = modeIndicatorPanelSize();
    let origin = floatingPanelResolvedOrigin(sz, caretRect, None, 6.0, 6.0, 8.0);
    floatingPanelUpdateLevel(panel, clientWindowLevelOpt);

    if (cellGet(gModeLabel) != label) {
        cellSet(gModeLabel, label);
        msgSendVoid1Bool(content, objcSel("setNeedsDisplay:"), true)
    } else ();

    let targetFrame = cgRect(origin.x, origin.y, sz.width, sz.height);
    floatingPanelPresentWithoutAnimation(panel, targetFrame, () -> {
        msgSendVoid0(content, objcSel("displayIfNeeded"))
    });

    dispatchMainAfterMs(modeIndicatorAutoHideMs(), () -> {
        if (cellGet(gModeHideGen) == gen) {
            modeIndicatorHide()
        } else ()
    })
}

pub def modeIndicatorHide(): Void = {
    cellSet(gModeHideGen, cellGet(gModeHideGen) + intToI64(1));
    floatingPanelHideWithoutAnimation(cellGet(gModePanel))
}

/// Convenience HUD toast helper anchored at mouse/caret.
pub def hudShow(text: String): Void = {
    let m = mouseScreenLocation();
    modeIndicatorShowLabel(text, cgRect(m.x, m.y, 1.0, 20.0), None)
}

pub def hudHide(): Void =
    modeIndicatorHide()
