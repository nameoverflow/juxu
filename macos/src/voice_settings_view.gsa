/// 1:1 Geisha AppKit port of `Sources/VoiceSettingsView.swift` (1,064 lines):
/// - `voiceBuildSettingsPageView(session: JuxuSession, width: Float): Ptr`
/// - `voiceOnSettingsWindowClosed(): Void`
/// - Master Switch Card (`开启句序语音输入入口`, dynamic active/off subtitle, `bolt.shield` on-demand banner when off, lifecycle draft cleanup)
/// - `providerCard` (`运行方案`: side-by-side `"云端 BYOK"` & `"本地模型"` selectable cards with `checkmark.circle.fill`/`circle` & `0.11` accent fill)
/// - `cloudBYOKCard` (`云端服务商` picker, `API Key` `NSSecureTextField` + `"✓ 钥匙串"`/`"必填"`, full Custom URL/ASR/LLM/SplitLLM fields, `启用云端 AI 口语整理`)
/// - `LocalVoiceConfigCard` (`本地语音识别模型` engine install/clean, Apple Speech locale + on-device, Custom HTTP; `本地 LLM 整理引擎` Qwen 1.5B / Ollama / None; live `VoiceInstallPhase` progress/status banner)
/// - `triggerAndBehaviorCard` (`触发快捷键`, `全局语音快捷键` + `optionSpace` warning + Input Monitoring & Accessibility rows + `"打开系统设置"` + 2s poll, `开始和结束提示音`, `输出模式与语气` + `语气风格`, `选中文本语音改写（Speak to Edit）`)
/// - `contextPrivacyCard` (3 switches with `.disabled(!capture)` dimming on rows 2 & 3)
/// - `VoiceContextInspectorCard` (AX trust badge, `"3 秒后抓取前台窗口"` / countdown cancel, `"复制 JSON"` / `"展开 JSON"`, captured summary rows, ASR & Polish monospaced scroll boxes, raw JSON scroll box)
/// - `vocabularyAndTestCard` (`联动句序个人词库（N 条）`, `自定义语音热词`, `"检测当前配置"` + `"配置：voice.json"` + green/red result text).

use std.option.{Option, Some, None}
use std.vec.{Vec, vecNew, vecLen, vecPush, vecGetOr}
use std.math.{ceil, abs}
use std.str.{intToStr, strTrim, strContains}
use std.buf.{bufNew, bufPushStr, bufPushByte, bufToString}
use std.path.{pathBasename}
use objc.{
    Id, NSObject,
    objcClass, objcSel, objcAllocateClass, objcAddMethod, objcRegisterClass,
    objcSetAssocHandle, objcGetAssocHandle, objcReleaseRaw, idAdopt,
    msgSend0, msgSend1Ptr, msgSend1Float, msgSendInt0, msgSendI64_0,
    msgSendVoid0, msgSendVoid1Ptr, msgSendVoid1I64, msgSendVoid1Bool, msgSendVoid1Float,
}
use juxu_shared.{
    JuxuSession, bridgeRefreshUserPhrases,
    CGPoint, CGSize, CGRect, cgPoint, cgRect,
    nsStr, nsStrPtrToString, objcAllocInit, objcAllocInitFrame,
    utf8ScalarCount, headScalars,
    msgSendRect0, msgSendSize0, msgSend2Float, msgSend4Float, msgSend2Ptr,
    msgSendVoid1Rect, dispatchMainAsync, dispatchMainAfterMs,
}
use voice_common.{
    VoiceProviderMode, VpmCloudBYOK, VpmLocal, vpmDisplayName, vpmSummary,
    VoiceCloudPreset, VcpGroq, VcpCustom, vcpAllCases, vcpDisplayName, vcpKeyPlaceholder, vcpSubtitle, vcpKeychainAccount,
    VoiceKeychainAccount, VkaCustomLLM,
    VoiceLocalASRModelPreset, VlaWhisperTurbo, VlaAppleSpeech, VlaCustomHTTP,
    vlaAllCases, vlaDisplayName, vlaSizeLabel, vlaEngineLabel, vlaModelFilename, vlaIsEngineBackend,
    VoiceLocalLLMPreset, VllQwen15B, VllOllamaHTTP, VllNone,
    vllAllCases, vllDisplayName, vllSizeLabel, vllModelFilename,
    VoiceTriggerKey, VtkRightOption, vtkAllCases, vtkDisplayName, vtkIsHoldToTalk,
    VoiceOutputMode, VomSmartPolish, vomAllCases, vomDisplayName,
    VoiceToneMode, VtmAutoByApp, vtmAllCases, vtmDisplayName,
    VoicePreferences,
    vpIsGlobalHotkeyEnabled, vpAreVoiceCuesEnabled, vpIsContextCaptureEnabled,
    vpRespectsContextBlacklist, vpSendsScreenContextToCloud,
    vpEffectiveCloudASRModel, vpEffectiveCloudLLMModel,
    voiceKeychainRead, voiceKeychainWrite,
    voicePrefsGet, voicePrefsFilePath, voicePrefsUpdate, gVoicePrefsObservers,
    VoiceLocalComponentStatus, vlcsIsReady, vlcsFormattedModelSize,
    VoiceInstallPhase, VipIdle, VipInstallingDep, VipDownloadingModel, VipCompleted, VipFailed, vipIsBusy,
    VoiceGlobalPermStatus, VoiceContextSummary,
    voiceAxIsTrusted,
    gVoiceAsrStatusHook, gVoiceLlmStatusHook, gVoiceInstallPhaseCell, gVoiceInstallRefreshObservers,
    gVoiceInstallASRHook, gVoiceInstallLLMHook, gVoiceDeleteModelHook, gVoiceCancelInstallHook,
    gVoiceGlobalPermCurrentHook, gVoiceGlobalPermRequestHook,
    gVoiceTestConfigHook,
    gVoiceInspectorPresented, gVoiceInspectorCapturing, gVoiceInspectorCountdown,
    gVoiceInspectorLastSummary, gVoiceInspectorObservers,
    gVoiceInspectorTriggerHook, gVoiceInspectorCancelHook,
}

// ============================================================================
// C11 & Objective-C FFI Helpers
// ============================================================================

extern "juxu_voice_ui_bounding_rect" def c_vsBoundingRect(nsStrPtr: Ptr, maxW: Float, attrs: Ptr, outRect4: Ptr): Void
extern "juxu_voice_ui_open_url_utf8" def c_vsOpenUrlUtf8(url: String): Bool
extern "juxu_voice_ui_copy_pasteboard_utf8" def c_vsCopyPasteboardUtf8(text: String): Void

extern "objc_msgSend" def msgSendBezRoundedVs(cls: Ptr, sel: Ptr, r: CGRect, rx: Float, ry: Float): Ptr
extern "objc_msgSend" def msgSendDrawAtPtAttrsVs(nsStrObj: Ptr, sel: Ptr, pt: CGPoint, attrs: Ptr): Void
extern "objc_msgSend" def msgSendDrawInRectAttrsVs(nsStrObj: Ptr, sel: Ptr, r: CGRect, attrs: Ptr): Void
extern "objc_msgSend" def msgSendDrawImgVs(
    img: Ptr, sel: Ptr, dst: CGRect, src: CGRect, op: Int64, frac: Float, respectFlipped: Bool, hints: Ptr
): Void
extern "objc_msgSend" def msgSendSizeWithAttrsVs(nsStrObj: Ptr, sel: Ptr, attrs: Ptr): CGSize

def maxVs(a: Float, b: Float): Float = if (a >= b) a else b
def minVs(a: Float, b: Float): Float = if (a <= b) a else b
def clampVs(v: Float, lo: Float, hi: Float): Float =
    if (v < lo) lo else if (v > hi) hi else v

def vsFontReg(): Float = 0.0
def vsFontMed(): Float = 0.23
def vsFontSemi(): Float = 0.30

def vsFontSystem(size: Float, weight: Float): Ptr =
    msgSend2Float(objcClass("NSFont"), objcSel("systemFontOfSize:weight:"), size, weight)

def vsFontMono(size: Float, weight: Float): Ptr =
    msgSend2Float(objcClass("NSFont"), objcSel("monospacedSystemFontOfSize:weight:"), size, weight)

def vsColorRgba(r: Float, g: Float, b: Float, a: Float): Ptr =
    msgSend4Float(objcClass("NSColor"), objcSel("colorWithSRGBRed:green:blue:alpha:"), r, g, b, a)

def vsColorAlpha(col: Ptr, a: Float): Ptr =
    if (ptrIsNull(col)) col else msgSend1Float(col, objcSel("colorWithAlphaComponent:"), clampVs(a, 0.0, 1.0))

def vsColorLabel(): Ptr = msgSend0(objcClass("NSColor"), objcSel("labelColor"))
def vsColorSecondary(): Ptr = msgSend0(objcClass("NSColor"), objcSel("secondaryLabelColor"))
def vsColorTertiary(): Ptr = msgSend0(objcClass("NSColor"), objcSel("tertiaryLabelColor"))
def vsColorSeparator(): Ptr = msgSend0(objcClass("NSColor"), objcSel("separatorColor"))
def vsColorAccent(): Ptr = msgSend0(objcClass("NSColor"), objcSel("controlAccentColor"))
def vsColorGreen(): Ptr = msgSend0(objcClass("NSColor"), objcSel("systemGreenColor"))
def vsColorOrange(): Ptr = msgSend0(objcClass("NSColor"), objcSel("systemOrangeColor"))
def vsColorRed(): Ptr = msgSend0(objcClass("NSColor"), objcSel("systemRedColor"))

def vsViewIsDark(view: Ptr): Bool =
    if (ptrIsNull(view)) false
    else {
        let app = msgSend0(view, objcSel("effectiveAppearance"));
        if (ptrIsNull(app)) false
        else {
            let names = msgSend0(objcClass("NSMutableArray"), objcSel("array"));
            msgSendVoid1Ptr(names, objcSel("addObject:"), nsStr("NSAppearanceNameAqua"));
            msgSendVoid1Ptr(names, objcSel("addObject:"), nsStr("NSAppearanceNameDarkAqua"));
            let best = msgSend1Ptr(app, objcSel("bestMatchFromAppearancesWithNames:"), names);
            strContains(nsStrPtrToString(best), "Dark")
        }
    }

def vsFillRoundedRect(r: CGRect, radius: Float, color: Ptr): Void =
    if (!ptrIsNull(color) && r.size.width > 0.0 && r.size.height > 0.0) {
        let maxR = 0.5 * minVs(r.size.width, r.size.height);
        let rad = clampVs(radius, 0.0, maxR);
        msgSendVoid0(color, objcSel("setFill"));
        let p = msgSendBezRoundedVs(
            objcClass("NSBezierPath"),
            objcSel("bezierPathWithRoundedRect:xRadius:yRadius:"),
            r, rad, rad
        );
        msgSendVoid0(p, objcSel("fill"))
    } else ()

def vsStrokeRoundedRect(r: CGRect, radius: Float, lineWidth: Float, color: Ptr): Void =
    if (!ptrIsNull(color) && lineWidth > 0.0 && r.size.width > lineWidth && r.size.height > lineWidth) {
        let half = lineWidth * 0.5;
        let insetR = cgRect(r.origin.x + half, r.origin.y + half, r.size.width - lineWidth, r.size.height - lineWidth);
        let adjR = maxVs(0.0, radius - half);
        msgSendVoid0(color, objcSel("setStroke"));
        let p = msgSendBezRoundedVs(
            objcClass("NSBezierPath"),
            objcSel("bezierPathWithRoundedRect:xRadius:yRadius:"),
            insetR, adjR, adjR
        );
        msgSendVoid1Float(p, objcSel("setLineWidth:"), lineWidth);
        msgSendVoid0(p, objcSel("stroke"))
    } else ()

def vsFillHairline(r: CGRect, color: Ptr): Void =
    if (!ptrIsNull(color) && r.size.width > 0.0 && r.size.height > 0.0) {
        msgSendVoid0(color, objcSel("setFill"));
        msgSendVoid1Rect(objcClass("NSBezierPath"), objcSel("fillRect:"), r)
    } else ()

def vsMakeTextAttrs(font: Ptr, color: Ptr): Ptr = {
    let d = msgSend0(objcClass("NSMutableDictionary"), objcSel("dictionary"));
    if (!ptrIsNull(font)) {
        let _ = msgSend2Ptr(d, objcSel("setObject:forKey:"), font, nsStr("NSFont"));
        ()
    } else ();
    if (!ptrIsNull(color)) {
        let _ = msgSend2Ptr(d, objcSel("setObject:forKey:"), color, nsStr("NSColor"));
        ()
    } else ();
    d
}

def vsMeasureTextHeight(text: String, font: Ptr, maxW: Float, minH: Float): Float = {
    let safeW = maxVs(40.0, maxW);
    let attrs = vsMakeTextAttrs(font, vsColorLabel());
    let buf = ptrAllocBytes(32);
    c_vsBoundingRect(nsStr(text), safeW, attrs, buf);
    let h = ceil(ptrReadF64Le(buf, 24)) + 1.0;
    maxVs(minH, h)
}

def vsSymbolImage(symbolName: String, ptSize: Float, weight: Float): Ptr = {
    let imgCls = objcClass("NSImage");
    if (ptrIsNull(imgCls)) ptrNull()
    else {
        let base = msgSend2Ptr(
            imgCls,
            objcSel("imageWithSystemSymbolName:accessibilityDescription:"),
            nsStr(symbolName),
            ptrNull()
        );
        if (ptrIsNull(base)) ptrNull()
        else {
            let cfgCls = objcClass("NSImageSymbolConfiguration");
            if (ptrIsNull(cfgCls)) base
            else {
                let cfg = msgSend2Float(cfgCls, objcSel("configurationWithPointSize:weight:"), ptSize, weight);
                if (ptrIsNull(cfg)) base
                else {
                    let configured = msgSend1Ptr(base, objcSel("imageWithSymbolConfiguration:"), cfg);
                    if (!ptrIsNull(configured)) configured else base
                }
            }
        }
    }
}

def vsDrawTintedSymbol(symbolName: String, ptSize: Float, weight: Float, tint: Ptr, dstRect: CGRect): Void = {
    let base = vsSymbolImage(symbolName, ptSize, weight);
    if (!ptrIsNull(base)) {
        let palArr = msgSend1Ptr(objcClass("NSArray"), objcSel("arrayWithObject:"), tint);
        let pCfg = if (ptrIsNull(palArr)) ptrNull() else msgSend1Ptr(objcClass("NSImageSymbolConfiguration"), objcSel("configurationWithPaletteColors:"), palArr);
        let tinted = if (ptrIsNull(pCfg)) ptrNull() else msgSend1Ptr(base, objcSel("imageWithSymbolConfiguration:"), pCfg);
        let img = if (!ptrIsNull(tinted)) tinted else base;
        let sz = msgSendSize0(img, objcSel("size"));
        let dx = dstRect.origin.x + (dstRect.size.width - sz.width) * 0.5;
        let dy = dstRect.origin.y + (dstRect.size.height - sz.height) * 0.5;
        msgSendDrawImgVs(
            img,
            objcSel("drawInRect:fromRect:operation:fraction:respectFlipped:hints:"),
            cgRect(dx, dy, sz.width, sz.height),
            cgRect(0.0, 0.0, 0.0, 0.0),
            intToI64(2),
            1.0,
            true,
            ptrNull()
        )
    } else ()
}

def vsMakeSymbolImageView(frame: CGRect, symbolName: String, ptSize: Float, weight: Float, tint: Ptr): Ptr = {
    let iv = objcAllocInitFrame("NSImageView", frame);
    let img = vsSymbolImage(symbolName, ptSize, weight);
    if (!ptrIsNull(img)) msgSendVoid1Ptr(iv, objcSel("setImage:"), img) else ();
    if (!ptrIsNull(tint)) msgSendVoid1Ptr(iv, objcSel("setContentTintColor:"), tint) else ();
    iv
}

def vsMakeLabel(frame: CGRect, text: String, font: Ptr, color: Ptr, wraps: Bool, selectable: Bool): Ptr = {
    let lbl = objcAllocInitFrame("NSTextField", frame);
    msgSendVoid1Bool(lbl, objcSel("setBezeled:"), false);
    msgSendVoid1Bool(lbl, objcSel("setDrawsBackground:"), false);
    msgSendVoid1Bool(lbl, objcSel("setEditable:"), false);
    msgSendVoid1Bool(lbl, objcSel("setSelectable:"), selectable);
    if (!ptrIsNull(font)) msgSendVoid1Ptr(lbl, objcSel("setFont:"), font) else ();
    if (!ptrIsNull(color)) msgSendVoid1Ptr(lbl, objcSel("setTextColor:"), color) else ();
    if (wraps) {
        msgSendVoid1Bool(lbl, objcSel("setUsesSingleLineMode:"), false);
        let cellObj = msgSend0(lbl, objcSel("cell"));
        if (!ptrIsNull(cellObj)) {
            msgSendVoid1Bool(cellObj, objcSel("setWraps:"), true);
            msgSendVoid1Bool(cellObj, objcSel("setScrollable:"), false)
        } else ()
    } else {
        msgSendVoid1Bool(lbl, objcSel("setUsesSingleLineMode:"), true);
        msgSendVoid1I64(lbl, objcSel("setLineBreakMode:"), intToI64(4))
    };
    msgSendVoid1Ptr(lbl, objcSel("setStringValue:"), nsStr(text));
    lbl
}

// ============================================================================
// Custom AppKit Subclasses for VoiceSettingsView
// ============================================================================

// ---- 1. Action Target & TextField Change Delegate ----

def gVsActionKey: Cell Ptr = cellNew(ptrNull())
def gVsKeepAliveKey: Cell Ptr = cellNew(ptrNull())
def gVsFieldBindKey: Cell Ptr = cellNew(ptrNull())

def vsActionAssocKey(): Ptr = {
    let k = cellGet(gVsActionKey);
    if (!ptrIsNull(k)) k else { let nk = ptrAllocBytes(8); cellSet(gVsActionKey, nk); nk }
}

def vsKeepAliveAssocKey(): Ptr = {
    let k = cellGet(gVsKeepAliveKey);
    if (!ptrIsNull(k)) k else { let nk = ptrAllocBytes(8); cellSet(gVsKeepAliveKey, nk); nk }
}

def vsFieldBindAssocKey(): Ptr = {
    let k = cellGet(gVsFieldBindKey);
    if (!ptrIsNull(k)) k else { let nk = ptrAllocBytes(8); cellSet(gVsFieldBindKey, nk); nk }
}

def vsActionTargetInvoke(self: Ptr, _cmd: Ptr, sender: Ptr): Void = {
    let h = objcGetAssocHandle(self, vsActionAssocKey());
    if (h != intToI64(0)) {
        let cb: (Ptr) -> Void = gcHandleGet(h);
        cb(sender)
    } else ()
}

def vsBindControl(control: Ptr, cb: (Ptr) -> Void): Void = {
    let tgt = objcAllocInit("JuxuGeishaVoiceActionTarget");
    objcSetAssocHandle(tgt, vsActionAssocKey(), gcHandleNew(cb));
    msgSendVoid1Ptr(control, objcSel("setTarget:"), tgt);
    msgSendVoid1Ptr(control, objcSel("setAction:"), objcSel("invokeVoiceAction:"));
    let retained: Id NSObject = idAdopt(tgt);
    objcSetAssocHandle(control, vsKeepAliveAssocKey(), gcHandleNew(retained))
}

data VoiceTextFieldBind {
    vtfbOnChange: (String) -> Void,
}

def vsTextFieldDidChange(self: Ptr, _cmd: Ptr, notif: Ptr): Void = {
    let h = objcGetAssocHandle(self, vsFieldBindAssocKey());
    if (!ptrIsNull(notif) && h != intToI64(0)) {
        let field = msgSend0(notif, objcSel("object"));
        if (!ptrIsNull(field)) {
            let bind: VoiceTextFieldBind = gcHandleGet(h);
            let txt = nsStrPtrToString(msgSend0(field, objcSel("stringValue")));
            let cb = bind.vtfbOnChange;
            cb(txt)
        } else ()
    } else ()
}

def vsMakeInputField(
    frame: CGRect,
    secure: Bool,
    value: String,
    placeholder: String,
    onChange: (String) -> Void
): Ptr = {
    let box = objcAllocInitFrame("JuxuGeishaVoiceCardView", frame);
    objcSetAssocHandle(box, vsCardAssocKey(), gcHandleNew(VoiceSettingsCardData {
        vscdDividerYs: vecNew(),
        vscdRadius: 6.0,
        vscdFillKind: 3,
    }));

    let clsName = if (secure) "NSSecureTextField" else "NSTextField";
    let innerH = 17.0;
    let innerY = maxVs(2.0, (frame.size.height - innerH) * 0.5);
    let fld = objcAllocInitFrame(clsName, cgRect(6.0, innerY, maxVs(24.0, frame.size.width - 12.0), innerH));
    msgSendVoid1Bool(fld, objcSel("setBezeled:"), false);
    msgSendVoid1Bool(fld, objcSel("setDrawsBackground:"), false);
    msgSendVoid1I64(fld, objcSel("setFocusRingType:"), intToI64(1));
    msgSendVoid1Bool(fld, objcSel("setEditable:"), true);
    msgSendVoid1Bool(fld, objcSel("setSelectable:"), true);
    msgSendVoid1Bool(fld, objcSel("setUsesSingleLineMode:"), true);
    msgSendVoid1Ptr(fld, objcSel("setFont:"), vsFontSystem(12.5, vsFontReg()));
    msgSendVoid1Ptr(fld, objcSel("setTextColor:"), vsColorLabel());
    let cellObj = msgSend0(fld, objcSel("cell"));
    if (!ptrIsNull(cellObj)) {
        msgSendVoid1Bool(cellObj, objcSel("setWraps:"), false);
        msgSendVoid1Bool(cellObj, objcSel("setScrollable:"), true)
    } else ();
    if (strLen(placeholder) > 0) {
        let phCol = vsColorRgba(0.55, 0.55, 0.58, 1.0);
        let phAttrs = vsMakeTextAttrs(vsFontSystem(12.5, vsFontReg()), phCol);
        let phAttrStr = msgSend2Ptr(
            msgSend0(objcClass("NSAttributedString"), objcSel("alloc")),
            objcSel("initWithString:attributes:"),
            nsStr(placeholder),
            phAttrs
        );
        msgSendVoid1Ptr(fld, objcSel("setPlaceholderAttributedString:"), phAttrStr);
        objcReleaseRaw(phAttrStr)
    } else ();
    msgSendVoid1Ptr(fld, objcSel("setStringValue:"), nsStr(value));

    let del = objcAllocInit("JuxuGeishaVoiceTextFieldDelegate");
    objcSetAssocHandle(del, vsFieldBindAssocKey(), gcHandleNew(VoiceTextFieldBind { vtfbOnChange: onChange }));
    msgSendVoid1Ptr(fld, objcSel("setDelegate:"), del);
    let retained: Id NSObject = idAdopt(del);
    objcSetAssocHandle(fld, vsKeepAliveAssocKey(), gcHandleNew(retained));

    msgSendVoid1Ptr(box, objcSel("addSubview:"), fld);
    objcReleaseRaw(fld);
    box
}

// ---- 2. Grouped Card View & Tinted Box View ----

data VoiceSettingsCardData {
    vscdDividerYs: Vec Float,
    vscdRadius: Float,
    vscdFillKind: Int,
}

def gVsCardKey: Cell Ptr = cellNew(ptrNull())

def vsCardAssocKey(): Ptr = {
    let k = cellGet(gVsCardKey);
    if (!ptrIsNull(k)) k else { let nk = ptrAllocBytes(8); cellSet(gVsCardKey, nk); nk }
}

def vsFlipped(_self: Ptr, _cmd: Ptr): Bool = true

def vsCardDrawRect(self: Ptr, _cmd: Ptr, _dirty: CGRect): Void = {
    let bounds = msgSendRect0(self, objcSel("bounds"));
    let h = objcGetAssocHandle(self, vsCardAssocKey());
    if (h != intToI64(0)) {
        let st: VoiceSettingsCardData = gcHandleGet(h);
        if (st.vscdFillKind == 1) {
            // ASR context box: Color.accentColor.opacity(0.06)
            vsFillRoundedRect(bounds, st.vscdRadius, vsColorAlpha(vsColorAccent(), 0.06))
        } else if (st.vscdFillKind == 2) {
            // Polish / Raw JSON box: Color.primary.opacity(0.04)
            vsFillRoundedRect(bounds, st.vscdRadius, vsColorAlpha(vsColorLabel(), 0.04))
        } else if (st.vscdFillKind == 3) {
            // Rounded text field bezel (`textFieldStyle(.roundedBorder)`): crisp opaque fill + hairline border
            let isDark = vsViewIsDark(self);
            let bgCol = if (isDark) vsColorRgba(0.14, 0.14, 0.16, 1.0) else vsColorRgba(1.0, 1.0, 1.0, 1.0);
            let bdCol = if (isDark) vsColorRgba(1.0, 1.0, 1.0, 0.14) else vsColorRgba(0.0, 0.0, 0.0, 0.11);
            vsFillRoundedRect(bounds, st.vscdRadius, bgCol);
            vsStrokeRoundedRect(bounds, st.vscdRadius, 0.65, bdCol)
        } else {
            let isDark = vsViewIsDark(self);
            let fillCol =
                if (isDark) vsColorRgba(1.0, 1.0, 1.0, 0.048)
                else vsColorRgba(0.0, 0.0, 0.0, 0.028);
            let borderCol =
                if (isDark) vsColorRgba(1.0, 1.0, 1.0, 0.085)
                else vsColorRgba(0.0, 0.0, 0.0, 0.065);
            vsFillRoundedRect(bounds, st.vscdRadius, fillCol);
            vsStrokeRoundedRect(bounds, st.vscdRadius, 0.6, borderCol);

            let sep = vsColorSeparator();
            let n = vecLen(st.vscdDividerYs);
            let i = cellNew(0);
            while (cellGet(i) < n) {
                let dy = vecGetOr(st.vscdDividerYs, cellGet(i), 0.0);
                vsFillHairline(cgRect(14.0, dy, maxVs(0.0, bounds.size.width - 28.0), 0.5), sep);
                cellSet(i, cellGet(i) + 1)
            }
        }
    } else ()
}

def vsMakeCard(frame: CGRect, dividerYs: Vec Float): Ptr = {
    let v = objcAllocInitFrame("JuxuGeishaVoiceCardView", frame);
    objcSetAssocHandle(v, vsCardAssocKey(), gcHandleNew(VoiceSettingsCardData {
        vscdDividerYs: dividerYs,
        vscdRadius: 10.0,
        vscdFillKind: 0,
    }));
    v
}

def vsMakeCodeBox(frame: CGRect, accentTint: Bool): Ptr = {
    let v = objcAllocInitFrame("JuxuGeishaVoiceCardView", frame);
    objcSetAssocHandle(v, vsCardAssocKey(), gcHandleNew(VoiceSettingsCardData {
        vscdDividerYs: vecNew(),
        vscdRadius: 6.0,
        vscdFillKind: if (accentTint) 1 else 2,
    }));
    v
}

// ---- 3. Provider Mode Option Card (`providerOptionCard`, lines 118-152) ----

data VoiceOptionCardData {
    vocdTitle: String,
    vocdSubtitle: String,
    vocdSelected: Bool,
    vocdOnClick: () -> Void,
}

def gVsOptCardKey: Cell Ptr = cellNew(ptrNull())

def vsOptCardAssocKey(): Ptr = {
    let k = cellGet(gVsOptCardKey);
    if (!ptrIsNull(k)) k else { let nk = ptrAllocBytes(8); cellSet(gVsOptCardKey, nk); nk }
}

def vsOptCardDrawRect(self: Ptr, _cmd: Ptr, _dirty: CGRect): Void = {
    let h = objcGetAssocHandle(self, vsOptCardAssocKey());
    if (h != intToI64(0)) {
        let st: VoiceOptionCardData = gcHandleGet(h);
        let bounds = msgSendRect0(self, objcSel("bounds"));
        let fillCol =
            if (st.vocdSelected) vsColorAlpha(vsColorAccent(), 0.11)
            else vsColorAlpha(vsColorLabel(), 0.03);
        vsFillRoundedRect(bounds, 8.0, fillCol);
        if (st.vocdSelected) {
            vsStrokeRoundedRect(bounds, 8.0, 1.2, vsColorAccent())
        } else {
            vsStrokeRoundedRect(bounds, 8.0, 0.6, vsColorAlpha(vsColorLabel(), 0.10))
        };

        let titleAttrs = vsMakeTextAttrs(vsFontSystem(13.0, vsFontSemi()), vsColorLabel());
        msgSendDrawAtPtAttrsVs(
            nsStr(st.vocdTitle),
            objcSel("drawAtPoint:withAttributes:"),
            cgPoint(10.0, 10.0),
            titleAttrs
        );

        let subAttrs = vsMakeTextAttrs(vsFontSystem(11.0, vsFontReg()), vsColorSecondary());
        msgSendDrawInRectAttrsVs(
            nsStr(st.vocdSubtitle),
            objcSel("drawInRect:withAttributes:"),
            cgRect(10.0, 31.0, maxVs(40.0, bounds.size.width - 20.0), maxVs(18.0, bounds.size.height - 39.0)),
            subAttrs
        )
    } else ()
}

def vsOptCardMouseDown(self: Ptr, _cmd: Ptr, _ev: Ptr): Void = {
    let h = objcGetAssocHandle(self, vsOptCardAssocKey());
    if (h != intToI64(0)) {
        let st: VoiceOptionCardData = gcHandleGet(h);
        let cb = st.vocdOnClick;
        cb()
    } else ()
}

def vsMakeOptionCard(frame: CGRect, title: String, subtitle: String, selected: Bool, onClick: () -> Void): Ptr = {
    let v = objcAllocInitFrame("JuxuGeishaVoiceOptionCardView", frame);
    objcSetAssocHandle(v, vsOptCardAssocKey(), gcHandleNew(VoiceOptionCardData {
        vocdTitle: title,
        vocdSubtitle: subtitle,
        vocdSelected: selected,
        vocdOnClick: onClick,
    }));
    let symName = if (selected) "checkmark.circle.fill" else "circle";
    let symTint = if (selected) vsColorAccent() else vsColorAlpha(vsColorSecondary(), 0.5);
    let iv = vsMakeSymbolImageView(cgRect(frame.size.width - 25.0, 10.0, 15.0, 15.0), symName, 13.0, if (selected) vsFontSemi() else vsFontReg(), symTint);
    msgSendVoid1Ptr(v, objcSel("addSubview:"), iv);
    objcReleaseRaw(iv);
    v
}

