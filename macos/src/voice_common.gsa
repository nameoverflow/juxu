pub data VoicePreferences {
    vpEnabled: Bool,
    vpProviderMode: VoiceProviderMode,
    vpTriggerKey: VoiceTriggerKey,
    vpOutputMode: VoiceOutputMode,
    vpToneMode: VoiceToneMode,
    vpLanguage: String,
    vpSpeakToEditSelection: Bool,
    vpSyncJuxuLexicon: Bool,
    vpCustomVocabulary: String,
    vpCloudPreset: VoiceCloudPreset,
    vpCloudPolishEnabled: Bool,
    vpCustomBaseURL: String,
    vpCustomASRModel: String,
    vpCustomLLMModel: String,
    vpCustomSplitLLM: Bool,
    vpCustomLLMBaseURL: String,
    vpLocalASRPreset: VoiceLocalASRModelPreset,
    vpLocalAppleLocale: String,
    vpLocalAppleRequireOnDevice: Bool,
    vpLocalHTTPASRBaseURL: String,
    vpLocalHTTPASRModel: String,
    vpLocalLLMPreset: VoiceLocalLLMPreset,
    vpLocalHTTPLLMBaseURL: String,
    vpLocalHTTPLLMModel: String,
    vpGlobalVoiceHotkey: Option Bool,
    vpVoiceCues: Option Bool,
    vpContextCapture: Option Bool,
    vpContextBlacklist: Option Bool,
    vpScreenContextToCloud: Option Bool,
}

