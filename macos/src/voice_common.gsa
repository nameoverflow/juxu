    vpEnabled: false,
    vpProviderMode: VpmCloudBYOK,
    vpTriggerKey: VtkRightOption,
    vpOutputMode: VomSmartPolish,
    vpToneMode: VtmAutoByApp,
    vpLanguage: "zh",
    vpSpeakToEditSelection: true,
    vpSyncJuxuLexicon: true,
    vpCustomVocabulary: "",
    vpCloudPreset: VcpGroq,
    vpCloudPolishEnabled: true,
    vpCustomBaseURL: "https://api.openai.com/v1",
    vpCustomASRModel: "whisper-1",
    vpCustomLLMModel: "gpt-4o-mini",
    vpCustomSplitLLM: false,
    vpCustomLLMBaseURL: "https://api.deepseek.com/v1",
    vpLocalASRPreset: VlaWhisperTurbo,
    vpLocalAppleLocale: "zh-CN",
    vpLocalAppleRequireOnDevice: true,
    vpLocalHTTPASRBaseURL: "http://127.0.0.1:8080/v1",
    vpLocalHTTPASRModel: "whisper-1",
    vpLocalLLMPreset: VllQwen15B,
    vpLocalHTTPLLMBaseURL: "http://127.0.0.1:11434/v1",
    vpLocalHTTPLLMModel: "qwen2.5:3b",
    vpGlobalVoiceHotkey: None,
    vpVoiceCues: None,
    vpContextCapture: None,
    vpContextBlacklist: None,
    vpScreenContextToCloud: None,
}

pub def vpIsGlobalHotkeyEnabled(p: VoicePreferences): Bool = match p.vpGlobalVoiceHotkey {
    Some(b) -> b,
    None    -> false,
}
pub def vpAreVoiceCuesEnabled(p: VoicePreferences): Bool = match p.vpVoiceCues {
    Some(b) -> b,
    None    -> true,
}
pub def vpIsContextCaptureEnabled(p: VoicePreferences): Bool = match p.vpContextCapture {
    Some(b) -> b,
    None    -> true,
}
pub def vpRespectsContextBlacklist(p: VoicePreferences): Bool = match p.vpContextBlacklist {
    Some(b) -> b,
    None    -> true,
}
pub def vpSendsScreenContextToCloud(p: VoicePreferences): Bool = match p.vpScreenContextToCloud {
    Some(b) -> b,
    None    -> false,
}

pub def vpEffectiveCloudASRBaseURL(p: VoicePreferences): String = match p.vpCloudPreset {
    VcpCustom -> p.vpCustomBaseURL,
    preset    -> vcpDefaultBaseURL(preset),
}
pub def vpEffectiveCloudASRModel(p: VoicePreferences): String = match p.vpCloudPreset {
