/// Shared types, preferences store, keychain store, session timeline, partial stabilizer,
/// and cross-layer hooks for the macOS Voice subsystem (`Voice*.swift`).
/// All record fields use unique prefixes (`vp*`, `vpd*`, `vst*`, `vps*`, `vlcs*`, `vcs*`, `vgp*`)
/// to satisfy Geisha's whole-program record field inference rule.

use std.option.{Option, Some, None}
use std.result.{Ok, Err}
use std.list.{listRev}
use std.generic
use std.vec.{Vec, vecNew, vecLen, vecPush, vecGetOr, vecSet}
use std.buf.{bufNew, bufPushStr, bufPushByte, bufToString}
use std.str.{intToStr, strTrim}
use std.path.{pathDirname}
use std.codec.{Value, VBool, VStr, VObj}
use std.json.{parse, stringifyPretty}
use sys.fs.{fileExists, mkdirAll, readFile, writeFileAtomic}
use juxu_shared.{
    CGRect, nsStr, nsStrPtrToString, appleHomeDirectory,
}

def decodeUtf8Scalars(s: String): Vec Int = {
    let out = vecNew();
    let n = strLen(s);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let idx = cellGet(i);
        let b0 = strByteAt(s, idx) & 0xFF;
        if (b0 < 0x80) {
            vecPush(out, b0);
            cellSet(i, idx + 1)
        } else if ((b0 & 0xE0) == 0xC0 && idx + 1 < n) {
            let b1 = strByteAt(s, idx + 1) & 0x3F;
            vecPush(out, ((b0 & 0x1F) << 6) | b1);
            cellSet(i, idx + 2)
        } else if ((b0 & 0xF0) == 0xE0 && idx + 2 < n) {
            let b1 = strByteAt(s, idx + 1) & 0x3F;
            let b2 = strByteAt(s, idx + 2) & 0x3F;
            vecPush(out, ((b0 & 0x0F) << 12) | (b1 << 6) | b2);
            cellSet(i, idx + 3)
        } else if ((b0 & 0xF8) == 0xF0 && idx + 3 < n) {
            let b1 = strByteAt(s, idx + 1) & 0x3F;
            let b2 = strByteAt(s, idx + 2) & 0x3F;
            let b3 = strByteAt(s, idx + 3) & 0x3F;
            vecPush(out, ((b0 & 0x07) << 18) | (b1 << 12) | (b2 << 6) | b3);
            cellSet(i, idx + 4)
        } else {
            cellSet(i, idx + 1)
        }
    };
    out
}

extern "juxu_voice_kc_delete_ns" def c_voiceKcDeleteNs(nsAcc: Ptr): Bool
extern "juxu_voice_kc_write_ns" def c_voiceKcWriteNs(nsAcc: Ptr, nsVal: Ptr): Bool
extern "juxu_voice_kc_read_ns" def c_voiceKcReadNs(nsAcc: Ptr): Ptr
extern "juxu_voice_cf_absolute_time" def c_voiceCfAbsoluteTime(): Float
extern "juxu_voice_ax_is_trusted" def c_voiceAxIsTrusted(): Bool

pub def voiceCfAbsoluteTime(): Float = c_voiceCfAbsoluteTime()
pub def voiceAxIsTrusted(): Bool = c_voiceAxIsTrusted()

