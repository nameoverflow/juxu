pub data VoiceProviderMode : Eq {
    VpmCloudBYOK,
    VpmLocal,
}

pub def vpmToRaw(m: VoiceProviderMode): String = match m {
    VpmCloudBYOK -> "cloud_byok",
    VpmLocal     -> "local",
}
pub def vpmFromRaw(s: String): VoiceProviderMode =
    if (s == "local") VpmLocal else VpmCloudBYOK
pub def vpmDisplayName(m: VoiceProviderMode): String = match m {
    VpmCloudBYOK -> "云端 BYOK",
    VpmLocal     -> "本地模型",
}
pub def vpmSummary(m: VoiceProviderMode): String = match m {
    VpmCloudBYOK -> "预设服务填 Key 即用，或自定义 URL",
    VpmLocal     -> "一键下载本机依赖与模型，离线按需运行",
}

