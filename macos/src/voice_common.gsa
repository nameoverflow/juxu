pub def gVoiceInspectorLastSummary: Cell (Option VoiceContextSummary) = cellNew(None)
pub def gVoiceInspectorObservers: Vec (() -> Void) = vecNew()
pub def voiceNotifyInspectorChanged(): Void = {
    let i = cellNew(0);
    while (cellGet(i) < vecLen(gVoiceInspectorObservers)) {
        let idx = cellGet(i);
        let fnObs = vecGetOr(gVoiceInspectorObservers, idx, () -> ());
        fnObs();
        cellSet(i, idx + 1)
    }
}
pub def gVoiceInspectorTriggerHook: Cell ((Int, Bool) -> Void) = cellNew((_sec, _bl) -> ())
