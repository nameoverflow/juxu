/// Pure Geisha macOS Input Method entry (`Juxu.app`).
/// Registers `JuxuInputController : IMKInputController` (via `extern init`),
/// supports `--register-system-cache` (macOS 27 global TIS cache) and `--settings`,
/// and runs `IMKServer` + `NSApplication`.

use std.option.{Some, None}
use std.path.{pathJoin}
use sys.env.{argCount, argAt, getEnv}
use sys.fs.{isDir}
use sys.proc.{exit}
use objc.{
    objcClass, objcSel, withAutoreleasePool,
    msgSend0, msgSendVoid0, msgSendVoid1Ptr,
}
use juxu_shared.{
    sessionNew, sessionLoadDictsFromDir, sessionLoadPersistence,
    mainBundleResourcePath, mainBundleIdentifier, nsStr, msgSend2Ptr,
}
use input_controller.{inputControllerSetSession}
use settings_window.{settingsWindowShow}

extern "TISRegisterInputSource" def c_TISRegisterInputSource(url: Ptr): Int
extern "TISCreateInputSourceList" def c_TISCreateInputSourceList(props: Ptr, includeAll: Bool): Ptr

def hasCliFlag(flag: String): Bool = {
    let n = argCount();
    let found = cellNew(false);
    let i = cellNew(1);
    while (cellGet(i) < n && !cellGet(found)) {
        if (argAt(cellGet(i)) == flag) cellSet(found, true) else ();
        cellSet(i, cellGet(i) + 1)
    };
    cellGet(found)
}

def main(): Void = withAutoreleasePool(() -> {
    if (hasCliFlag("--register-system-cache")) {
        let bundle = msgSend0(objcClass("NSBundle"), objcSel("mainBundle"));
        let url = msgSend0(bundle, objcSel("bundleURL"));
        let _ = c_TISRegisterInputSource(url);
        let _ = c_TISCreateInputSourceList(ptrNull(), true);
        exit(0)
    } else ();

    let app = msgSend0(objcClass("NSApplication"), objcSel("sharedApplication"));
    let bundleId = mainBundleIdentifier("im.juxu.inputmethod.Juxu");
    let connName = bundleId + ".Connection";

    let serverAlloc = msgSend0(objcClass("IMKServer"), objcSel("alloc"));
    let _server = msgSend2Ptr(serverAlloc, objcSel("initWithName:bundleIdentifier:"), nsStr(connName), nsStr(bundleId));

    let session = sessionNew();
    let resDir = mainBundleResourcePath();
    let bundleDicts = pathJoin(resDir, "Dicts");
    if (strLen(resDir) > 0 && isDir(bundleDicts)) {
        let _ = sessionLoadDictsFromDir(session, bundleDicts);
        ()
    } else ();

    match getEnv("HOME") {
        Some(home) -> sessionLoadPersistence(session, pathJoin(home, "Library/Application Support/Juxu")),
        None -> (),
    };

    inputControllerSetSession(session);

    if (hasCliFlag("--settings")) {
        settingsWindowShow(session)
    } else ();

    msgSendVoid0(app, objcSel("run"))
})
