// ============================================================================
// Math & Geometry Utilities
// ============================================================================

pub def roundFloat(x: Float): Float =
    if (x >= 0.0) floor(x + 0.5) else ceil(x - 0.5)

pub def maxFloat(a: Float, b: Float): Float =
    if (a >= b) a else b

pub def minFloat(a: Float, b: Float): Float =
    if (a <= b) a else b

pub def clampFloat(v: Float, lo: Float, hi: Float): Float =
    if (v < lo) lo else if (v > hi) hi else v

// ============================================================================
// AppKit Font, Color, Appearance, Bezier & SF Symbol Helpers
// ============================================================================

pub def fontWeightRegular(): Float = 0.0
pub def fontWeightMedium(): Float = 0.23
pub def fontWeightSemibold(): Float = 0.30

pub def nsFontSystem(size: Float, weight: Float): Ptr =
    msgSend2Float(objcClass("NSFont"), objcSel("systemFontOfSize:weight:"), size, weight)

pub def nsFontMonoDigit(size: Float, weight: Float): Ptr =
    msgSend2Float(objcClass("NSFont"), objcSel("monospacedDigitSystemFontOfSize:weight:"), size, weight)

pub def nsFontMono(size: Float, weight: Float): Ptr =
    msgSend2Float(objcClass("NSFont"), objcSel("monospacedSystemFontOfSize:weight:"), size, weight)

pub def nsFontNamedOrSystem(name: String, size: Float, fallbackWeight: Float): Ptr = {
    let f = msgSend1Ptr1Float(objcClass("NSFont"), objcSel("fontWithName:size:"), nsStr(name), size);
    if (!ptrIsNull(f)) f else nsFontSystem(size, fallbackWeight)
}

pub def nsFontRounded(size: Float, weight: Float): Ptr = {
    let base = nsFontSystem(size, weight);
    if (ptrIsNull(base)) base
    else {
        let desc = msgSend0(base, objcSel("fontDescriptor"));
        if (ptrIsNull(desc)) base
        else {
            let rDesc = msgSend1Ptr(desc, objcSel("fontDescriptorWithDesign:"), nsStr("NSCTFontUIFontDesignRounded"));
            if (ptrIsNull(rDesc)) base
            else {
                let f = msgSend1Ptr1Float(objcClass("NSFont"), objcSel("fontWithDescriptor:size:"), rDesc, size);
                if (!ptrIsNull(f)) f else base
            }
        }
    }
}

pub def nsFontAscender(font: Ptr): Float =
    if (ptrIsNull(font)) 14.0 else msgSendFloat0(font, objcSel("ascender"))

pub def nsFontDescender(font: Ptr): Float =
    if (ptrIsNull(font)) -4.0 else msgSendFloat0(font, objcSel("descender"))

pub def nsColorRgba(r: Float, g: Float, b: Float, a: Float): Ptr =
    msgSend4Float(objcClass("NSColor"), objcSel("colorWithSRGBRed:green:blue:alpha:"), r, g, b, a)

pub def nsColorAlpha(col: Ptr, a: Float): Ptr =
    if (ptrIsNull(col)) col
    else msgSend1Float(col, objcSel("colorWithAlphaComponent:"), a)

pub def nsColorClear(): Ptr = msgSend0(objcClass("NSColor"), objcSel("clearColor"))
pub def nsColorWhite(): Ptr = msgSend0(objcClass("NSColor"), objcSel("whiteColor"))
pub def nsColorBlack(): Ptr = msgSend0(objcClass("NSColor"), objcSel("blackColor"))
pub def nsColorLabel(): Ptr = msgSend0(objcClass("NSColor"), objcSel("labelColor"))
pub def nsColorSecondaryLabel(): Ptr = msgSend0(objcClass("NSColor"), objcSel("secondaryLabelColor"))
pub def nsColorTertiaryLabel(): Ptr = msgSend0(objcClass("NSColor"), objcSel("tertiaryLabelColor"))
pub def nsColorQuaternaryLabel(): Ptr = msgSend0(objcClass("NSColor"), objcSel("quaternaryLabelColor"))
pub def nsColorSeparator(): Ptr = msgSend0(objcClass("NSColor"), objcSel("separatorColor"))
pub def nsColorAccent(): Ptr = msgSend0(objcClass("NSColor"), objcSel("controlAccentColor"))
pub def nsColorWindowBg(): Ptr = msgSend0(objcClass("NSColor"), objcSel("windowBackgroundColor"))
pub def nsColorControlBg(): Ptr = msgSend0(objcClass("NSColor"), objcSel("controlBackgroundColor"))
pub def nsColorTeal(): Ptr = msgSend0(objcClass("NSColor"), objcSel("systemTealColor"))
pub def nsColorOrange(): Ptr = msgSend0(objcClass("NSColor"), objcSel("systemOrangeColor"))

pub def viewIsDarkAppearance(view: Ptr): Bool =
    if (ptrIsNull(view)) false
    else {
        let app = msgSend0(view, objcSel("effectiveAppearance"));
        if (ptrIsNull(app)) false
        else {
            let names = msgSend0(objcClass("NSMutableArray"), objcSel("array"));
            msgSendVoid1Ptr(names, objcSel("addObject:"), nsStr("NSAppearanceNameAqua"));
            msgSendVoid1Ptr(names, objcSel("addObject:"), nsStr("NSAppearanceNameDarkAqua"));
            let best = msgSend1Ptr(app, objcSel("bestMatchFromAppearancesWithNames:"), names);
            strContains(nsStrPtrToString(best), "Dark")
        }
    }

pub def fillRoundedRect(r: CGRect, radius: Float, color: Ptr): Void =
    if (!ptrIsNull(color) && r.size.width > 0.0 && r.size.height > 0.0) {
        msgSendVoid0(color, objcSel("setFill"));
        let p = msgSendBezRoundedRect(
            objcClass("NSBezierPath"),
            objcSel("bezierPathWithRoundedRect:xRadius:yRadius:"),
            r, radius, radius
        );
        msgSendVoid0(p, objcSel("fill"))
    } else ()

pub def strokeRoundedRect(r: CGRect, radius: Float, lineWidth: Float, color: Ptr): Void =
    if (!ptrIsNull(color) && lineWidth > 0.0 && r.size.width > lineWidth && r.size.height > lineWidth) {
        let half = lineWidth * 0.5;
        let insetR = cgRect(
            r.origin.x + half,
            r.origin.y + half,
            r.size.width - lineWidth,
            r.size.height - lineWidth
        );
        let adjRadius = maxFloat(0.0, radius - half);
        msgSendVoid0(color, objcSel("setStroke"));
        let p = msgSendBezRoundedRect(
            objcClass("NSBezierPath"),
            objcSel("bezierPathWithRoundedRect:xRadius:yRadius:"),
            insetR, adjRadius, adjRadius
        );
        msgSendVoid1Float(p, objcSel("setLineWidth:"), lineWidth);
        msgSendVoid0(p, objcSel("stroke"))
    } else ()

pub def fillHairlineRect(r: CGRect, color: Ptr): Void =
    if (!ptrIsNull(color) && r.size.width > 0.0 && r.size.height > 0.0) {
        msgSendVoid0(color, objcSel("setFill"));
        msgSendVoid1Rect(objcClass("NSBezierPath"), objcSel("fillRect:"), r)
    } else ()

pub def makeTextAttrs(font: Ptr, color: Ptr): Ptr = {
    let d = msgSend0(objcClass("NSMutableDictionary"), objcSel("dictionary"));
    if (!ptrIsNull(font)) {
        let _ = msgSend2Ptr(d, objcSel("setObject:forKey:"), font, nsStr("NSFont"));
        ()
    } else ();
    if (!ptrIsNull(color)) {
        let _ = msgSend2Ptr(d, objcSel("setObject:forKey:"), color, nsStr("NSColor"));
        ()
    } else ();
    d
}

pub def makeAttrString(s: String, attrs: Ptr): Ptr = {
    let alloc = msgSend0(objcClass("NSAttributedString"), objcSel("alloc"));
    msgSend2Ptr(alloc, objcSel("initWithString:attributes:"), nsStr(s), attrs)
}

pub def makeUnderlinedAttrString(s: String): Ptr = {
    let d = msgSend0(objcClass("NSMutableDictionary"), objcSel("dictionary"));
    let numOne = msgSend1I64(objcClass("NSNumber"), objcSel("numberWithInteger:"), intToI64(1));
    let _ = msgSend2Ptr(d, objcSel("setObject:forKey:"), numOne, nsStr("NSUnderline"));
    makeAttrString(s, d)
}

extern "objc_msgSend" def msgSend1I64(cls: Ptr, sel: Ptr, v: Int64): Ptr

pub def nsSymbolImage(symbolName: String, ptSize: Float, weight: Float): Ptr = {
    let imgCls = objcClass("NSImage");
    if (ptrIsNull(imgCls)) ptrNull()
    else {
        let base = msgSend2Ptr(
            imgCls,
            objcSel("imageWithSystemSymbolName:accessibilityDescription:"),
            nsStr(symbolName),
            ptrNull()
        );
        if (ptrIsNull(base)) ptrNull()
        else {
            let cfgCls = objcClass("NSImageSymbolConfiguration");
            if (ptrIsNull(cfgCls)) base
            else {
                let cfg = msgSend2Float(
                    cfgCls,
                    objcSel("configurationWithPointSize:weight:"),
                    ptSize, weight
                );
                if (ptrIsNull(cfg)) base
                else {
                    let configured = msgSend1Ptr(base, objcSel("imageWithSymbolConfiguration:"), cfg);
                    if (!ptrIsNull(configured)) configured else base
                }
            }
        }
    }
}

pub def makeSymbolImageView(frame: CGRect, symbolName: String, ptSize: Float, weight: Float, tintColor: Ptr): Ptr = {
    let iv = objcAllocInitFrame("NSImageView", frame);
    let img = nsSymbolImage(symbolName, ptSize, weight);
    if (!ptrIsNull(img)) {
        msgSendVoid1Ptr(iv, objcSel("setImage:"), img)
    } else ();
    if (!ptrIsNull(tintColor)) {
        msgSendVoid1Ptr(iv, objcSel("setContentTintColor:"), tintColor)
    } else ();
    iv
}

pub def makeStaticLabel(frame: CGRect, text: String, font: Ptr, color: Ptr, wraps: Bool): Ptr = {
    let lbl = objcAllocInitFrame("NSTextField", frame);
    msgSendVoid1Bool(lbl, objcSel("setBezeled:"), false);
    msgSendVoid1Bool(lbl, objcSel("setDrawsBackground:"), false);
    msgSendVoid1Bool(lbl, objcSel("setEditable:"), false);
    msgSendVoid1Bool(lbl, objcSel("setSelectable:"), false);
    if (!ptrIsNull(font)) msgSendVoid1Ptr(lbl, objcSel("setFont:"), font) else ();
    if (!ptrIsNull(color)) msgSendVoid1Ptr(lbl, objcSel("setTextColor:"), color) else ();
    if (wraps) {
        msgSendVoid1Bool(lbl, objcSel("setUsesSingleLineMode:"), false);
        let cellObj = msgSend0(lbl, objcSel("cell"));
        if (!ptrIsNull(cellObj)) {
            msgSendVoid1Bool(cellObj, objcSel("setWraps:"), true);
            msgSendVoid1Bool(cellObj, objcSel("setScrollable:"), false)
        } else ()
    } else {
        msgSendVoid1Bool(lbl, objcSel("setUsesSingleLineMode:"), true);
        msgSendVoid1I64(lbl, objcSel("setLineBreakMode:"), intToI64(4))
    };
    msgSendVoid1Ptr(lbl, objcSel("setStringValue:"), nsStr(text));
    lbl
}

pub def mouseScreenLocation(): CGPoint = {
    let evCls = objcClass("NSEvent");
    if (ptrIsNull(evCls)) cgPoint(420.0, 420.0)
    else msgSendPoint0(evCls, objcSel("mouseLocation"))
}

extern "objc_msgSend" def msgSendPoint0(obj: Ptr, sel: Ptr): CGPoint
