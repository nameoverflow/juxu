/// Shared macOS AppKit / QuartzCore / Carbon / CGEvent typed FFI & UI drawing helpers
/// used across `floating_hud`, `candidate_panel`, `input_controller`, `settings_window`, and `main`.

use std.math.{floor, ceil}
use std.str.{strContains}
use objc.{
    objcClass, objcSel, msgSend0, msgSend1Ptr, msgSend1Float, msgSendI64_0, msgSendFloat0,
    msgSendVoid0, msgSendVoid1Ptr, msgSendVoid1I64, msgSendVoid1Bool, msgSendVoid1Float,
}
use juxu_shared.{
    CGPoint, CGSize, CGRect, NSRange, cgPoint, cgRect,
    nsStr, nsStrPtrToString, objcAllocInitFrame,
    msgSend2Ptr, msgSend4Float, msgSend2Float, msgSend1Ptr1Float, msgSendVoid1Rect,
}

