pub def voiceHUDTextFitAttributes(font: Ptr, lineHeight: Float, color: Ptr): Ptr = {
    let style = msgSend0(msgSend0(objcClass("NSMutableParagraphStyle"), objcSel("alloc")), objcSel("init"));
    msgSendVoid1Float(style, objcSel("setMinimumLineHeight:"), lineHeight);
    msgSendVoid1Float(style, objcSel("setMaximumLineHeight:"), lineHeight);
    // NSLineBreakByCharWrapping == 1
    msgSendVoid1I64(style, objcSel("setLineBreakMode:"), intToI64(1));

    let dict = msgSend0(objcClass("NSMutableDictionary"), objcSel("dictionary"));
    if (!ptrIsNull(font)) {
        let _ = msgSend2Ptr(dict, objcSel("setObject:forKey:"), font, nsStr("NSFont"));
        ()
    } else ();
    let col = if (ptrIsNull(color)) hudColorWhite() else color;
    if (!ptrIsNull(col)) {
        let _ = msgSend2Ptr(dict, objcSel("setObject:forKey:"), col, nsStr("NSColor"));
        ()
    } else ();
    let _ = msgSend2Ptr(dict, objcSel("setObject:forKey:"), style, nsStr("NSParagraphStyle"));
    objcReleaseRaw(style);
    dict
}

pub def voiceHUDTextFitLineCount(text: String, attrs: Ptr, width: Float, lineHeight: Float): Int = {
    let outBuf = ptrAllocBytes(32);
    c_boundingRect(nsStr(text), width, attrs, outBuf);
    let h = ptrReadF64Le(outBuf, 24);
    let lines = floatToInt(ceil((h - 0.5) / lineHeight));
    if (lines < 1) 1 else lines
}

/// Longest suffix of `text` that fits in `maxLines`, prefixed with `"…"` when cut.
pub def voiceHUDTextFitTailFitting(
    text: String,
    attrs: Ptr,
    width: Float,
    lineHeight: Float,
    maxLines: Int
): String =
    if (voiceHUDTextFitLineCount(text, attrs, width, lineHeight) <= maxLines) text
    else {
        let chars = utf8ToScalars(text);
        let total = vecLen(chars);
        let low = cellNew(0);
        let high = cellNew(total);
        while (cellGet(low) < cellGet(high)) {
            let mid = (cellGet(low) + cellGet(high) + 1) / 2;
            let cand = "…" + scalarsToUtf8(chars, total - mid, total);
            if (voiceHUDTextFitLineCount(cand, attrs, width, lineHeight) <= maxLines) {
                cellSet(low, mid)
            } else {
                cellSet(high, mid - 1)
            }
        };
        let keep = cellGet(low);
        "…" + scalarsToUtf8(chars, total - keep, total)
    }

// ============================================================================
// 3. VoiceLevelMeter (`VoiceHUDPanel.swift` lines 681-717)
// ============================================================================

pub data VoiceLevelMeter {
    vlmNoiseFloorDB: Cell (Option Float),
    vlmPeakCeilingDB: Cell (Option Float),
}

pub def vlmQuietestDB(): Float = -58.0
pub def vlmLowestFloorDB(): Float = -65.0
pub def vlmHighestFloorDB(): Float = -41.0
pub def vlmFloorMarginDB(): Float = 3.5
pub def vlmMinSpanDB(): Float = 12.0
pub def vlmInitialCeilingDB(): Float = -25.0
pub def vlmMaxCeilingDB(): Float = -4.0

pub def voiceLevelMeterNew(): VoiceLevelMeter = VoiceLevelMeter {
    vlmNoiseFloorDB: cellNew(None),
    vlmPeakCeilingDB: cellNew(None),
}

pub def voiceLevelMeterProcess(m: VoiceLevelMeter, rms: Float, seconds: Float): Float = {
    let safeRms = maxHud(rms, 1.0e-6);
    let db = 20.0 * log10Hud(safeRms);
    let clamped = minHud(vlmHighestFloorDB(), maxHud(vlmLowestFloorDB(), db));

    let nextFloor = match cellGet(m.vlmNoiseFloorDB) {
        Some(fl) -> {
            let tau = if (clamped < fl) 0.15 else 6.0;
            fl + (clamped - fl) * (1.0 - exp((0.0 - seconds) / tau))
        },
        None -> clamped,
    };
    cellSet(m.vlmNoiseFloorDB, Some(nextFloor));

    let bottom = maxHud(vlmQuietestDB(), nextFloor + vlmFloorMarginDB());
    let minTop = minHud(vlmMaxCeilingDB(), maxHud(bottom + vlmMinSpanDB(), vlmInitialCeilingDB()));
    let targetPeak = minHud(vlmMaxCeilingDB(), maxHud(minTop, db));

    let nextPeak = match cellGet(m.vlmPeakCeilingDB) {
        Some(pk) -> {
            let tau = if (targetPeak > pk) 0.25 else 5.0;
            pk + (targetPeak - pk) * (1.0 - exp((0.0 - seconds) / tau))
        },
        None -> minTop,
    };
    cellSet(m.vlmPeakCeilingDB, Some(nextPeak));

    let top = maxHud(minTop, nextPeak);
    clampHud((db - bottom) / (top - bottom), 0.0, 1.0)
}

