def gSpectrumObjKey: Cell Ptr = cellNew(ptrNull())

def spectrumObjAssocKey(): Ptr = {
    let k = cellGet(gSpectrumObjKey);
    if (!ptrIsNull(k)) k else { let nk = ptrAllocBytes(8); cellSet(gSpectrumObjKey, nk); nk }
}

data SpectrumRawBox {
    srbPtr: Cell Ptr,
}

def spectrumHolderDealloc(self: Ptr, cmd: Ptr): Void = {
    let h = objcGetAssocHandle(self, spectrumObjAssocKey());
    if (h != intToI64(0)) {
        let box: SpectrumRawBox = gcHandleGet(h);
        let raw = cellGet(box.srbPtr);
        if (!ptrIsNull(raw)) {
            cellSet(box.srbPtr, ptrNull());
            c_spectrumFree(raw)
        } else ()
    } else ();
    objcSendSuperVoid0(self, "NSObject", cmd)
}

pub data VoiceSpectrumAnalyzer {
    vsaHolder: Id NSObject,
    vsaRawPtr: Ptr,
}

pub def voiceSpectrumFrameDuration(): Float = 0.025
pub def voiceSpectrumBarCount(): Int = 11

pub def voiceSpectrumBandEdgesHz(): Vec Float = {
    let v = vecWithCap(12);
    vecPush(v, 130.0); vecPush(v, 210.0); vecPush(v, 310.0); vecPush(v, 450.0);
    vecPush(v, 650.0); vecPush(v, 920.0); vecPush(v, 1300.0); vecPush(v, 1800.0);
    vecPush(v, 2400.0); vecPush(v, 3100.0); vecPush(v, 3900.0); vecPush(v, 4800.0);
    v
}

pub def voiceSpectrumBarToBand(): Vec Int = {
    let v = vecWithCap(11);
    vecPush(v, 9); vecPush(v, 7); vecPush(v, 0); vecPush(v, 5); vecPush(v, 2);
    vecPush(v, 3); vecPush(v, 4); vecPush(v, 1); vecPush(v, 6); vecPush(v, 8); vecPush(v, 10);
    v
}

pub def voiceSpectrumBarTaper(): Vec Float = {
    let v = vecWithCap(11);
    vecPush(v, 0.66); vecPush(v, 0.78); vecPush(v, 0.88); vecPush(v, 0.94); vecPush(v, 0.98);
    vecPush(v, 1.00); vecPush(v, 0.98); vecPush(v, 0.94); vecPush(v, 0.88); vecPush(v, 0.78); vecPush(v, 0.66);
    v
}

pub def voiceSpectrumNew(): VoiceSpectrumAnalyzer = {
    let raw = c_spectrumNew();
    let obj = msgSend0(msgSend0(objcClass("JuxuGeishaVoiceSpectrumHolder"), objcSel("alloc")), objcSel("init"));
    let box = SpectrumRawBox { srbPtr: cellNew(raw) };
    objcSetAssocHandle(obj, spectrumObjAssocKey(), gcHandleNew(box));
    VoiceSpectrumAnalyzer {
        vsaHolder: idAdopt(obj),
        vsaRawPtr: raw,
    }
}

/// Slice a raw `float*` PCM buffer into ~25ms sub-windows and return one 11-bar `Vec Float` per slice.
pub def voiceSpectrumProcessPtr(
    vsa: VoiceSpectrumAnalyzer,
    samplesF32Ptr: Ptr,
    count: Int,
    sampleRate: Float
): Vec (Vec Float) = {
    let _keep = vsa.vsaHolder;
    let out: Vec (Vec Float) = vecNew();
    if (count <= 0 || sampleRate <= 0.0 || ptrIsNull(samplesF32Ptr) || ptrIsNull(vsa.vsaRawPtr)) out
    else {
        let cap = c_spectrumFrameCap(count, sampleRate);
        if (cap <= 0) out
        else {
            let outBuf = c_f32BufAlloc(cap * 11);
            let nFrames = c_spectrumProcess(vsa.vsaRawPtr, samplesF32Ptr, count, sampleRate, outBuf, cap);
            let f = cellNew(0);
            while (cellGet(f) < nFrames) {
                let fi = cellGet(f);
                let bars = vecWithCap(11);
                let b = cellNew(0);
                while (cellGet(b) < 11) {
                    let bi = cellGet(b);
                    vecPush(bars, f32ToFloat(c_f32BufGet(outBuf, fi * 11 + bi)));
                    cellSet(b, bi + 1)
                };
                vecPush(out, bars);
                cellSet(f, fi + 1)
            };
            c_f32BufFree(outBuf);
            out
        }
    }
}

/// Process a `Vec Float` PCM buffer into ~25ms 11-bar frames.
pub def voiceSpectrumProcessVec(
    vsa: VoiceSpectrumAnalyzer,
    samples: Vec Float,
    sampleRate: Float
): Vec (Vec Float) = {
    let n = vecLen(samples);
    if (n <= 0 || sampleRate <= 0.0) vecNew()
    else {
        let inBuf = c_f32BufAlloc(n);
        let i = cellNew(0);
        while (cellGet(i) < n) {
            let idx = cellGet(i);
            c_f32BufSet(inBuf, idx, floatToF32(vecGetOr(samples, idx, 0.0)));
            cellSet(i, idx + 1)
        };
        let res = voiceSpectrumProcessPtr(vsa, inBuf, n, sampleRate);
        c_f32BufFree(inBuf);
        res
    }
}

/// Convenience helper for single-frame array inputs and deterministic unit tests.
pub def voiceSpectrumProcessFrame(
    vsa: VoiceSpectrumAnalyzer,
    samples: Vec Float,
    sampleRate: Float,
    secondsOpt: Option Float
): Vec Float = {
    let _keep = vsa.vsaHolder;
    let bars = vecWithCap(11);
    let n = vecLen(samples);
    if (n <= 0 || sampleRate <= 0.0 || ptrIsNull(vsa.vsaRawPtr)) {
        let z = cellNew(0);
        while (cellGet(z) < 11) {
            vecPush(bars, 0.0);
            cellSet(z, cellGet(z) + 1)
        };
        bars
    } else {
        let inBuf = c_f32BufAlloc(n);
        let i = cellNew(0);
        while (cellGet(i) < n) {
            let idx = cellGet(i);
            c_f32BufSet(inBuf, idx, floatToF32(vecGetOr(samples, idx, 0.0)));
            cellSet(i, idx + 1)
        };
        let outBuf = c_f32BufAlloc(11);
        let (hasSec, secVal) = match secondsOpt {
            Some(s) -> (true, floatToF32(s)),
            None    -> (false, floatToF32(0.0)),
        };
        c_spectrumProcessFrame(vsa.vsaRawPtr, inBuf, n, sampleRate, hasSec, secVal, outBuf);
        let b = cellNew(0);
        while (cellGet(b) < 11) {
            let bi = cellGet(b);
            vecPush(bars, f32ToFloat(c_f32BufGet(outBuf, bi)));
            cellSet(b, bi + 1)
        };
        c_f32BufFree(outBuf);
        c_f32BufFree(inBuf);
        bars
    }
}

