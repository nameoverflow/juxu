// ============================================================================
// Math & AppKit Color / Font Helpers
// ============================================================================

def roundHud(x: Float): Float =
    if (x >= 0.0) floor(x + 0.5) else ceil(x - 0.5)

def maxHud(a: Float, b: Float): Float = if (a >= b) a else b
def minHud(a: Float, b: Float): Float = if (a <= b) a else b
def clampHud(v: Float, lo: Float, hi: Float): Float =
    if (v < lo) lo else if (v > hi) hi else v

def log10Hud(x: Float): Float = log(x) / log(10.0)

def hudFontSystem(size: Float, weight: Float): Ptr =
    msgSend2Float(objcClass("NSFont"), objcSel("systemFontOfSize:weight:"), size, weight)

def hudColorRgba(r: Float, g: Float, b: Float, a: Float): Ptr =
    msgSend4Float(objcClass("NSColor"), objcSel("colorWithSRGBRed:green:blue:alpha:"), r, g, b, a)

def hudColorAlpha(col: Ptr, a: Float): Ptr =
    if (ptrIsNull(col)) col else msgSend1Float(col, objcSel("colorWithAlphaComponent:"), clampHud(a, 0.0, 1.0))

def hudColorWhite(): Ptr = msgSend0(objcClass("NSColor"), objcSel("whiteColor"))
def hudColorClear(): Ptr = msgSend0(objcClass("NSColor"), objcSel("clearColor"))
def hudColorSystemRed(): Ptr = msgSend0(objcClass("NSColor"), objcSel("systemRedColor"))

def hudViewIsDark(view: Ptr): Bool =
    if (ptrIsNull(view)) false
    else {
        let app = msgSend0(view, objcSel("effectiveAppearance"));
        if (ptrIsNull(app)) false
        else {
            let names = msgSend0(objcClass("NSMutableArray"), objcSel("array"));
            msgSendVoid1Ptr(names, objcSel("addObject:"), nsStr("NSAppearanceNameAqua"));
            msgSendVoid1Ptr(names, objcSel("addObject:"), nsStr("NSAppearanceNameDarkAqua"));
            let best = msgSend1Ptr(app, objcSel("bestMatchFromAppearancesWithNames:"), names);
            strContains(nsStrPtrToString(best), "Dark")
        }
    }

def hudFillRoundedRect(r: CGRect, radius: Float, color: Ptr): Void =
    if (!ptrIsNull(color) && r.size.width > 0.0 && r.size.height > 0.0) {
        let maxR = 0.5 * minHud(r.size.width, r.size.height);
        let rad = clampHud(radius, 0.0, maxR);
        msgSendVoid0(color, objcSel("setFill"));
        let p = msgSendBezRoundedHud(
            objcClass("NSBezierPath"),
            objcSel("bezierPathWithRoundedRect:xRadius:yRadius:"),
            r, rad, rad
        );
        msgSendVoid0(p, objcSel("fill"))
    } else ()

