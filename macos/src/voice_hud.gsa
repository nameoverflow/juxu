/// 1:1 Geisha port of `Sources/VoiceHUDPanel.swift` (1,127 lines):
/// - `VoiceHUDMetrics` (`576x112` canvas, `pillBottom=9`, `pillHeight=28`, `listeningWidth=64`, `processingWidth=87`,
///   `barCount=11`, `barWidth=2`, `barMinHeight=2`, `barPitch=3.6`, `barMaxHeight=19.6`, `barsInset=13`, caption card geometry)
/// - `VoiceHUDTextFit` (`attributes`, `lineCount`, binary-search `tailFitting` with `"…"` prefix)
/// - `VoiceLevelMeter` (adaptive noise floor & peak ceiling dB loudness meter)
/// - `VoiceSpectrumAnalyzer` (11-band speech formant/fricative vDSP FFT analyzer backed by `csrc/voice_fft.c`)
/// - `JuxuGeishaVoiceHUDContentView` (`NSView` subclass, `isFlipped = YES`, `drawRect:`, zero-retaining `CADisplayLink`/`NSTimer` 60fps step)
/// - `JuxuGeishaVoiceHUDPanel` & `VoiceHUDPanelController` (lazy on-demand borderless non-activating `NSPanel` + `HUDBackdropView`s)
/// - `voiceHUDInitHooks()` wiring `gVoiceHUDShowHook`, `gVoiceHUDHideHook`, `gVoiceHUDUnloadHook`, `gVoiceHUDEnqueueSpectrumHook`.

use std.option.{Option, Some, None}
use std.vec.{Vec, vecNew, vecWithCap, vecLen, vecPush, vecGetOr, vecSet, vecClear}
use std.math.{pi, exp, log, sin, cos, pow, abs, floor, ceil}
use std.str.{strContains, strTrim}
use std.buf.{bufNew, bufPushByte, bufToString}
use objc.{
    Id, NSObject,
    objcClass, objcSel, objcAllocateClass, objcAddMethod, objcRegisterClass,
    objcSetAssocHandle, objcGetAssocHandle, objcReleaseRaw, idAdopt,
    msgSend0, msgSend1Ptr, msgSend1Float, msgSendBool0, msgSendI64_0,
    msgSendVoid0, msgSendVoid1Ptr, msgSendVoid1I64, msgSendVoid1Bool, msgSendVoid1Float,
}
use juxu_shared.{
    CGPoint, CGSize, CGRect, NSRange, cgPoint, cgSize, cgRect, nsRange,
    rectContainsPoint, rectIntersectsRect, rectMidX, rectMidY, rectMaxX, rectMaxY,
    nsStr, nsStrPtrToString, objcAllocInitFrame,
    utf8ToScalars, scalarsToUtf8,
    msgSendRect0, msgSendSize0, msgSendInitFrame, msgSend1Rect1U64_1I64_1Bool,
    msgSend2Float, msgSend4Float, msgSend2Ptr, msgSend1I64_1Ptr,
    msgSendVoid1Rect, msgSendVoid1Ptr1Range,
    objcSendSuperVoid0, dispatchMainAfterMs,
}
use voice_common.{
    VoiceHUDState, VhsHidden, VhsRecording, VhsTranscribing, VhsPolishing, VhsNotice,
    gVoiceHUDShowHook, gVoiceHUDHideHook, gVoiceHUDUnloadHook, gVoiceHUDEnqueueSpectrumHook,
}

