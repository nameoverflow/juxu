pub extern "objc_msgSend" def msgSendPoint1Point1Ptr(obj: Ptr, sel: Ptr, p: CGPoint, a1: Ptr): CGPoint
pub extern "objc_msgSend" def msgSendInitFrame(obj: Ptr, sel: Ptr, frame: CGRect): Ptr
pub extern "objc_msgSend" def msgSendVoid1Rect(obj: Ptr, sel: Ptr, r: CGRect): Void
pub extern "objc_msgSend" def msgSendVoid1Point(obj: Ptr, sel: Ptr, p: CGPoint): Void
pub extern "objc_msgSend" def msgSendVoid1Size(obj: Ptr, sel: Ptr, s: CGSize): Void
pub extern "objc_msgSend" def msgSendVoid1Ptr1Range(obj: Ptr, sel: Ptr, a0: Ptr, r: NSRange): Void
pub extern "objc_msgSend" def msgSendVoid1Ptr2Range(obj: Ptr, sel: Ptr, a0: Ptr, r1: NSRange, r2: NSRange): Void
