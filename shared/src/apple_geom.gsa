extern "juxu_dispatch_async_on" def c_dispatch_async_on(queue: Ptr, tramp: Ptr, handle: Int64): Void
extern "juxu_dispatch_sync_on" def c_dispatch_sync_on(queue: Ptr, tramp: Ptr, handle: Int64): Void

def __juxuGcdTramp0(h: Int64): Void = {
    let f: () -> Void = gcHandleGet(h);
    f()
}

/// Schedule `cb` asynchronously on the main RunLoop / `dispatch_get_main_queue()`.
pub def dispatchMainAsync(cb: () -> Void): Void =
    c_dispatch_main_async(cFnPtr(__juxuGcdTramp0), gcHandleNew(cb))

/// Schedule `cb` on `dispatch_get_main_queue()` after `delayMs` milliseconds.
pub def dispatchMainAfterMs(delayMs: Int, cb: () -> Void): Void =
    c_dispatch_main_after_ms(intToI64(delayMs), cFnPtr(__juxuGcdTramp0), gcHandleNew(cb))

/// Enqueue `cb` asynchronously on a serial dispatch queue created with `dispatchQueueCreateSerial`.
pub def dispatchAsync(queue: Ptr, cb: () -> Void): Void =
    c_dispatch_async_on(queue, cFnPtr(__juxuGcdTramp0), gcHandleNew(cb))

/// Execute `cb` synchronously as a barrier on a serial dispatch queue.
pub def dispatchSync(queue: Ptr, cb: () -> Void): Void =
    c_dispatch_sync_on(queue, cFnPtr(__juxuGcdTramp0), gcHandleNew(cb))

