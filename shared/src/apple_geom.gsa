): Ptr

// ============================================================================
// Foundation String, Bundle & Process Helpers
// ============================================================================

/// Create an autoreleased `NSString*` from a Geisha UTF-8 `String` (`+[NSString stringWithUTF8String:]`).
pub def nsStr(s: String): Ptr =
    msgSend1Str(objcClass("NSString"), objcSel("stringWithUTF8String:"), s)

/// Convert a raw `NSString*` pointer (nullable) to a Geisha `String`.
pub def nsStrPtrToString(p: Ptr): String =
    if (ptrIsNull(p)) ""
    else {
        let utf8 = msgSend0(p, objcSel("UTF8String"));
        if (ptrIsNull(utf8)) "" else ptrToString(utf8)
    }

/// Convert a nullable `NSString*` pointer into `Option String` (`None` only if pointer is `nil`).
pub def nsStrPtrToOpt(p: Ptr): Option String =
    if (ptrIsNull(p)) None else Some(nsStrPtrToString(p))

/// Return the UTF-16 length (`[ns length]`) of a raw `NSString*` pointer.
pub def nsStrUtf16Len(p: Ptr): Int64 =
    if (ptrIsNull(p)) intToI64(0)
    else msgSendI64_0(p, objcSel("length"))

/// Compute the exact UTF-16 code-unit length of a Geisha UTF-8 `String` (pure, zero ObjC allocation).
pub def strUtf16Len(s: String): Int64 = {
    let n = strLen(s);
    let i = cellNew(0);
    let u16 = cellNew(intToI64(0));
    while (cellGet(i) < n) {
        let idx = cellGet(i);
        let b0 = strByteAt(s, idx);
        if (b0 < 0x80) {
            cellSet(u16, cellGet(u16) + intToI64(1));
            cellSet(i, idx + 1)
        } else if ((b0 & 0xE0) == 0xC0) {
            cellSet(u16, cellGet(u16) + intToI64(1));
            cellSet(i, idx + 2)
        } else if ((b0 & 0xF0) == 0xE0) {
            cellSet(u16, cellGet(u16) + intToI64(1));
            cellSet(i, idx + 3)
        } else if ((b0 & 0xF8) == 0xF0) {
            // Astral plane scalar -> UTF-16 surrogate pair (2 code units)
            cellSet(u16, cellGet(u16) + intToI64(2));
            cellSet(i, idx + 4)
        } else {
            cellSet(u16, cellGet(u16) + intToI64(1));
            cellSet(i, idx + 1)
        }
    };
    cellGet(u16)
}

/// Allocate and initialize an ObjC object with `[[cls alloc] init]`.
pub def objcAllocInit(className: String): Ptr = {
    let cls = objcClass(className);
    if (ptrIsNull(cls)) ptrNull()
    else {
        let obj = msgSend0(cls, objcSel("alloc"));
        msgSend0(obj, objcSel("init"))
    }
}

/// Allocate and initialize an ObjC view with `[[cls alloc] initWithFrame:frame]`.
pub def objcAllocInitFrame(className: String, frame: CGRect): Ptr = {
    let cls = objcClass(className);
    if (ptrIsNull(cls)) ptrNull()
    else {
        let obj = msgSend0(cls, objcSel("alloc"));
        msgSendInitFrame(obj, objcSel("initWithFrame:"), frame)
    }
}

/// Return `NSBundle.mainBundle.resourcePath` (or `""` if unavailable).
pub def mainBundleResourcePath(): String = {
    let cls = objcClass("NSBundle");
    if (ptrIsNull(cls)) ""
    else {
        let bundle = msgSend0(cls, objcSel("mainBundle"));
        if (ptrIsNull(bundle)) ""
        else nsStrPtrToString(msgSend0(bundle, objcSel("resourcePath")))
    }
}

/// Return `NSBundle.mainBundle.bundlePath` (or `""` if unavailable).
pub def mainBundlePath(): String = {
    let cls = objcClass("NSBundle");
    if (ptrIsNull(cls)) ""
    else {
        let bundle = msgSend0(cls, objcSel("mainBundle"));
        if (ptrIsNull(bundle)) ""
        else nsStrPtrToString(msgSend0(bundle, objcSel("bundlePath")))
    }
}

/// Return `NSBundle.mainBundle.bundleIdentifier` (or `fallback`).
pub def mainBundleIdentifier(fallback: String): String = {
    let cls = objcClass("NSBundle");
    if (ptrIsNull(cls)) fallback
    else {
        let bundle = msgSend0(cls, objcSel("mainBundle"));
        if (ptrIsNull(bundle)) fallback
        else {
            let s = nsStrPtrToString(msgSend0(bundle, objcSel("bundleIdentifier")));
            if (strLen(s) == 0) fallback else s
        }
    }
}

/// Return `ProcessInfo.processInfo.arguments` as a `Vec String`.
pub def processArguments(): Vec String = {
    let out: Vec String = vecNew();
    let cls = objcClass("NSProcessInfo");
    if (!ptrIsNull(cls)) {
        let pi = msgSend0(cls, objcSel("processInfo"));
        if (!ptrIsNull(pi)) {
            let arr = msgSend0(pi, objcSel("arguments"));
            if (!ptrIsNull(arr)) {
                let n = i64ToInt(msgSendI64_0(arr, objcSel("count")));
                let i = cellNew(0);
                while (cellGet(i) < n) {
                    let idx = cellGet(i);
                    let item = msgSend1I64_1Ptr(arr, objcSel("objectAtIndex:"), intToI64(idx), ptrNull());
                    vecPush(out, nsStrPtrToString(item));
                    cellSet(i, idx + 1)
                }
            } else ()
        } else ()
    } else ();
    out
}

/// Return `true` if `ProcessInfo.processInfo.arguments` contains `flag`.
pub def hasProcessArgument(flag: String): Bool = {
    let args = processArguments();
    let n = vecLen(args);
    let i = cellNew(0);
    let found = cellNew(false);
    while (cellGet(i) < n && !cellGet(found)) {
        if (vecGetOr(args, cellGet(i), "") == flag) cellSet(found, true) else ();
        cellSet(i, cellGet(i) + 1)
    };
    cellGet(found)
}

/// Return `ProcessInfo.processInfo.systemUptime` in seconds.
pub def systemUptimeSeconds(): Float = {
    let cls = objcClass("NSProcessInfo");
    if (ptrIsNull(cls)) 0.0
    else {
        let pi = msgSend0(cls, objcSel("processInfo"));
        if (ptrIsNull(pi)) 0.0 else msgSendFloat0(pi, objcSel("systemUptime"))
    }
}

