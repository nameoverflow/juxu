/// CoreGraphics / Foundation C ABI geometry structs, UTF-8/UTF-16 string helpers,
/// `objc_msgSend` / `objc_msgSendSuper` wrappers, Grand Central Dispatch, and dynamic colors
/// shared across macOS (AppKit/InputMethodKit) and iOS (UIKit).

use std.option.{Option, Some, None}
use std.vec.{Vec, vecNew, vecWithCap, vecLen, vecPush, vecGetOr}
use std.buf.{StringBuf, bufWithCap, bufPushByte, bufToString}
use objc.{
    objcClass, objcSel, msgSend0, msgSend1Ptr, msgSendI64_0, msgSendFloat0,
    msgSendVoid0, msgSendVoid1Ptr,
}

// ============================================================================
// CoreGraphics & Foundation C ABI Value Structs
// ============================================================================

pub extern data CGPoint {
    x: Float,
    y: Float,
}

pub extern data CGSize {
    width: Float,
    height: Float,
}

pub extern data CGRect {
    origin: CGPoint,
    size: CGSize,
}

pub extern data NSRange {
    location: Int64,
    length: Int64,
}

pub extern data UIEdgeInsets {
    top: Float,
    left: Float,
    bottom: Float,
    right: Float,
}

pub extern data CGAffineTransform {
    a: Float,
    b: Float,
    c: Float,
    d: Float,
    tx: Float,
    ty: Float,
}

pub def cgPoint(x: Float, y: Float): CGPoint =
    CGPoint { x: x, y: y }

pub def cgSize(w: Float, h: Float): CGSize =
    CGSize { width: w, height: h }

pub def cgRect(x: Float, y: Float, w: Float, h: Float): CGRect =
    CGRect { origin: CGPoint { x: x, y: y }, size: CGSize { width: w, height: h } }

pub def nsRange(loc: Int64, len: Int64): NSRange =
    NSRange { location: loc, length: len }

pub def uiEdgeInsets(top: Float, left: Float, bottom: Float, right: Float): UIEdgeInsets =
    UIEdgeInsets { top: top, left: left, bottom: bottom, right: right }

pub def cgAffineIdentity(): CGAffineTransform =
    CGAffineTransform { a: 1.0, b: 0.0, c: 0.0, d: 1.0, tx: 0.0, ty: 0.0 }

pub def cgAffineScale(sx: Float, sy: Float): CGAffineTransform =
    CGAffineTransform { a: sx, b: 0.0, c: 0.0, d: sy, tx: 0.0, ty: 0.0 }

pub def cgAffineTranslate(tx: Float, ty: Float): CGAffineTransform =
    CGAffineTransform { a: 1.0, b: 0.0, c: 0.0, d: 1.0, tx: tx, ty: ty }

pub def nsNotFound(): Int64 =
    intToI64(2147483647) * intToI64(65536) * intToI64(65536)
        + intToI64(2147483647) * intToI64(2)
        + intToI64(1)

pub def rectContainsPoint(r: CGRect, p: CGPoint): Bool =
    p.x >= r.origin.x
        && p.x <= r.origin.x + r.size.width
        && p.y >= r.origin.y
        && p.y <= r.origin.y + r.size.height

pub def rectIntersectsRect(a: CGRect, b: CGRect): Bool =
    a.origin.x < b.origin.x + b.size.width
        && a.origin.x + a.size.width > b.origin.x
        && a.origin.y < b.origin.y + b.size.height
        && a.origin.y + a.size.height > b.origin.y

pub def rectInset(r: CGRect, dx: Float, dy: Float): CGRect =
    cgRect(
        r.origin.x + dx,
        r.origin.y + dy,
        r.size.width - dx * 2.0,
        r.size.height - dy * 2.0
    )

pub def rectMidX(r: CGRect): Float = r.origin.x + r.size.width * 0.5
pub def rectMidY(r: CGRect): Float = r.origin.y + r.size.height * 0.5
pub def rectMaxX(r: CGRect): Float = r.origin.x + r.size.width
pub def rectMaxY(r: CGRect): Float = r.origin.y + r.size.height

// ============================================================================
// Pointer / Integer & Buffer Struct Marshalling
// ============================================================================

pub extern noalloc "juxu_ptr_to_i64" def ptrToI64(p: Ptr): Int64
pub extern noalloc "juxu_i64_to_ptr" def i64ToPtr(v: Int64): Ptr

/// Read a `CGRect` (4 IEEE-754 doubles = 32 bytes) from a raw C buffer `buf`.
pub def readCGRectFromBuf(buf: Ptr): CGRect =
    cgRect(
        ptrReadF64Le(buf, 0),
        ptrReadF64Le(buf, 8),
        ptrReadF64Le(buf, 16),
        ptrReadF64Le(buf, 24)
    )

/// Write a `CGRect` (32 bytes) into a raw C buffer `buf`.
pub def writeCGRectToBuf(buf: Ptr, r: CGRect): Void = {
    ptrWriteF64Le(buf, 0, r.origin.x);
    ptrWriteF64Le(buf, 8, r.origin.y);
    ptrWriteF64Le(buf, 16, r.size.width);
    ptrWriteF64Le(buf, 24, r.size.height)
}

/// Read an `NSRange` (16 bytes) from a raw C buffer `buf`.
pub def readNSRangeFromBuf(buf: Ptr): NSRange =
    nsRange(ptrReadI64Le(buf, 0), ptrReadI64Le(buf, 8))

/// Write an `NSRange` (16 bytes) into a raw C buffer `buf`.
pub def writeNSRangeToBuf(buf: Ptr, r: NSRange): Void = {
    ptrWriteI64Le(buf, 0, r.location);
    ptrWriteI64Le(buf, 8, r.length)
}

