extern "juxu_dispatch_main_async" def c_dispatch_main_async(tramp: Ptr, handle: Int64): Void
extern "juxu_dispatch_main_after_ms" def c_dispatch_main_after_ms(delayMs: Int64, tramp: Ptr, handle: Int64): Void
