// ============================================================================
// Pure UTF-8 Unicode Scalar Helpers (used across TextFormatting, LineClear & Context Slicing)
// ============================================================================

/// Decode one UTF-8 scalar at byte offset `off` in `s`; returns `(codepoint, nextByteOffset)`.
pub def utf8DecodeAt(s: String, off: Int): (Int, Int) = {
    let n = strLen(s);
    if (off >= n) (0, n)
    else {
        let b0 = strByteAt(s, off);
        if (b0 < 0x80) (b0, off + 1)
        else if ((b0 & 0xE0) == 0xC0 && off + 1 < n) {
            let b1 = strByteAt(s, off + 1);
            (((b0 & 0x1F) << 6) | (b1 & 0x3F), off + 2)
        } else if ((b0 & 0xF0) == 0xE0 && off + 2 < n) {
            let b1 = strByteAt(s, off + 1);
            let b2 = strByteAt(s, off + 2);
            (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F), off + 3)
        } else if ((b0 & 0xF8) == 0xF0 && off + 3 < n) {
            let b1 = strByteAt(s, off + 1);
            let b2 = strByteAt(s, off + 2);
            let b3 = strByteAt(s, off + 3);
            (((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F), off + 4)
        } else (b0, off + 1)
    }
}

/// Push a single Unicode scalar `cp` encoded as UTF-8 into `buf`.
pub def bufPushScalar(buf: StringBuf, cp: Int): Void =
    if (cp < 0x80) {
        bufPushByte(buf, cp)
    } else if (cp < 0x800) {
        bufPushByte(buf, 0xC0 | (cp >> 6));
        bufPushByte(buf, 0x80 | (cp & 0x3F))
    } else if (cp < 0x10000) {
        bufPushByte(buf, 0xE0 | (cp >> 12));
        bufPushByte(buf, 0x80 | ((cp >> 6) & 0x3F));
        bufPushByte(buf, 0x80 | (cp & 0x3F))
    } else {
        bufPushByte(buf, 0xF0 | (cp >> 18));
        bufPushByte(buf, 0x80 | ((cp >> 12) & 0x3F));
        bufPushByte(buf, 0x80 | ((cp >> 6) & 0x3F));
        bufPushByte(buf, 0x80 | (cp & 0x3F))
    }

/// Encode a single Unicode scalar `cp` to a UTF-8 `String`.
pub def scalarToString(cp: Int): String = {
    let b = bufWithCap(4);
    bufPushScalar(b, cp);
    bufToString(b)
}

/// Decode the first Unicode scalar of `s` (`(codepoint, byteLen)`, or `(0, 0)` if empty).
pub def utf8FirstScalar(s: String): (Int, Int) =
    if (strLen(s) == 0) (0, 0) else utf8DecodeAt(s, 0)

/// Return the first UTF-8 character of `s` as a `String` (or `""` if empty).
pub def firstCharStr(s: String): String = {
    let (_, len) = utf8FirstScalar(s);
    if (len == 0) "" else strSlice(s, 0, len)
}

/// Decode the last Unicode scalar of `s` (`(codepoint, startByteIdx)`).
pub def utf8LastScalar(s: String): (Int, Int) = {
    let n = strLen(s);
    if (n == 0) (0, 0)
    else {
        let idx = cellNew(n - 1);
        while (cellGet(idx) > 0 && (strByteAt(s, cellGet(idx)) & 0xC0) == 0x80) {
            cellSet(idx, cellGet(idx) - 1)
        };
        let start = cellGet(idx);
        let (cp, _) = utf8DecodeAt(s, start);
        (cp, start)
    }
}

/// Return the last UTF-8 character of `s` as a `String` (or `""` if empty).
pub def lastCharStr(s: String): String = {
    let n = strLen(s);
    if (n == 0) ""
    else {
        let (_, start) = utf8LastScalar(s);
        strSlice(s, start, n)
    }
}

/// Decode all Unicode scalars of `s` into a `Vec Int`.
pub def utf8ToScalars(s: String): Vec Int = {
    let n = strLen(s);
    let out: Vec Int = vecWithCap(n);
    let off = cellNew(0);
    while (cellGet(off) < n) {
        let (cp, nextOff) = utf8DecodeAt(s, cellGet(off));
        vecPush(out, cp);
        cellSet(off, nextOff)
    };
    out
}

/// Count Unicode scalars in `s`.
pub def utf8ScalarCount(s: String): Int = {
    let n = strLen(s);
    let cnt = cellNew(0);
    let off = cellNew(0);
    while (cellGet(off) < n) {
        let (_, nextOff) = utf8DecodeAt(s, cellGet(off));
        cellSet(cnt, cellGet(cnt) + 1);
        cellSet(off, nextOff)
    };
    cellGet(cnt)
}

/// Encode `scalars[start..end]` back into a UTF-8 `String`.
pub def scalarsToUtf8(scalars: Vec Int, start: Int, end: Int): String = {
    let n = vecLen(scalars);
    let lo = if (start < 0) 0 else if (start > n) n else start;
    let hi = if (end < lo) lo else if (end > n) n else end;
    let b = bufWithCap((hi - lo) * 3);
    let i = cellNew(lo);
    while (cellGet(i) < hi) {
        bufPushScalar(b, vecGetOr(scalars, cellGet(i), 0));
        cellSet(i, cellGet(i) + 1)
    };
    bufToString(b)
}

/// Return the last `maxScalars` Unicode scalars of `s`.
pub def tailScalars(s: String, maxScalars: Int): String =
    if (maxScalars <= 0 || strLen(s) == 0) ""
    else {
        let scs = utf8ToScalars(s);
        let n = vecLen(scs);
        if (n <= maxScalars) s
        else scalarsToUtf8(scs, n - maxScalars, n)
    }

/// Return the first `maxScalars` Unicode scalars of `s`.
pub def headScalars(s: String, maxScalars: Int): String =
    if (maxScalars <= 0 || strLen(s) == 0) ""
    else {
        let scs = utf8ToScalars(s);
        let n = vecLen(scs);
        if (n <= maxScalars) s
        else scalarsToUtf8(scs, 0, maxScalars)
    }

/// Drop the last `dropCount` Unicode scalars of `s`.
pub def dropLastScalars(s: String, dropCount: Int): String =
    if (dropCount <= 0 || strLen(s) == 0) s
    else {
        let scs = utf8ToScalars(s);
        let n = vecLen(scs);
        if (dropCount >= n) ""
        else scalarsToUtf8(scs, 0, n - dropCount)
    }

/// Safe UTF-16 cursor context slicer (`(before, selected, after)`), handling surrogate pairs cleanly.
pub def utf16SliceContext(
    fullText: String,
    selectionLocationUTF16: Int,
    selectionLengthUTF16: Int,
    maxBeforeChars: Int,
    maxAfterChars: Int,
    maxSelectedChars: Int
): (String, String, String) = {
    let scs = utf8ToScalars(fullText);
    let n = vecLen(scs);
    let selStartU16 = if (selectionLocationUTF16 < 0) 0 else selectionLocationUTF16;
    let selEndU16 = selStartU16 + (if (selectionLengthUTF16 < 0) 0 else selectionLengthUTF16);

    let u16Pos = cellNew(0);
    let startScalarIdx = cellNew(n);
    let endScalarIdx = cellNew(n);
    let foundStart = cellNew(false);
    let foundEnd = cellNew(false);

    let i = cellNew(0);
    while (cellGet(i) < n) {
        let idx = cellGet(i);
        let curU16 = cellGet(u16Pos);
        if (!cellGet(foundStart) && curU16 >= selStartU16) {
            cellSet(startScalarIdx, idx);
            cellSet(foundStart, true)
        } else ();
        if (!cellGet(foundEnd) && curU16 >= selEndU16) {
            cellSet(endScalarIdx, idx);
            cellSet(foundEnd, true)
        } else ();
        let cp = vecGetOr(scs, idx, 0);
        let w = if (cp >= 0x10000) 2 else 1;
        // If selection lands inside a surrogate pair, snap cleanly to scalar boundary
        if (!cellGet(foundStart) && curU16 + w > selStartU16) {
            cellSet(startScalarIdx, idx);
            cellSet(foundStart, true)
        } else ();
        if (!cellGet(foundEnd) && curU16 + w > selEndU16) {
            cellSet(endScalarIdx, idx + 1);
            cellSet(foundEnd, true)
        } else ();
        cellSet(u16Pos, curU16 + w);
        cellSet(i, idx + 1)
    };

    let sIdx = cellGet(startScalarIdx);
    let eIdx = if (cellGet(endScalarIdx) < sIdx) sIdx else cellGet(endScalarIdx);
    let beforeLo = if (sIdx > maxBeforeChars) sIdx - maxBeforeChars else 0;
    let selHi = if (eIdx - sIdx > maxSelectedChars) sIdx + maxSelectedChars else eIdx;
    let afterHi = if (n - eIdx > maxAfterChars) eIdx + maxAfterChars else n;

    (
        scalarsToUtf8(scs, beforeLo, sIdx),
        scalarsToUtf8(scs, sIdx, selHi),
        scalarsToUtf8(scs, eIdx, afterHi)
    )
}
