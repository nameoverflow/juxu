pub extern "objc_msgSend" def msgSend2Ptr(obj: Ptr, sel: Ptr, a0: Ptr, a1: Ptr): Ptr
pub extern "objc_msgSend" def msgSend1Ptr1Bool(obj: Ptr, sel: Ptr, a0: Ptr, a1: Bool): Ptr
pub extern "objc_msgSend" def msgSend1Ptr1I64(obj: Ptr, sel: Ptr, a0: Ptr, a1: Int64): Ptr
pub extern "objc_msgSend" def msgSend1I64_1Ptr(obj: Ptr, sel: Ptr, a0: Int64, a1: Ptr): Ptr
